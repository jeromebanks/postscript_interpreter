%!PS-Adobe-3.0
%%Title: Groovy faces -- Chewy and Bagel Fat One (issue #155)
%%BoundingBox: 0 0 900 900
%%EndComments

% Specimen for the two rounded 60s/70s display faces added for the
% Keepin' it Real shirt (issue #155): Chewy (Apache 2.0) and Bagel Fat
% One (OFL). Each panel runs the shirt-front layout from
% examples/headline.ps through hllayout -- `I'm` / `Keepin' it` tucked
% against the `ea` of `Real`. Dashed boxes are the measured ink boxes, so
% the figure also shows the counters, apostrophes and tucking working with
% these faces. (tests/groovy_faces.rs covers psyletter with them too.)
%
% Run from the repo root:
%
%   pscat --page 900x900 examples/groovy_faces.ps

(lib/artkit.ps) run
(lib/lettering.ps) run
(lib/headline.ps) run

0.97 0.95 0.9 setrgbcolor clippath fill

/inkbox { % x0 y0 x1 y1
  gsave 0.85 0.2 0.2 setrgbcolor 0.6 setlinewidth [ 3 3 ] 0 setdash
  /ib3 exch def /ib2 exch def /ib1 exch def /ib0 exch def
  ib0 ib1 moveto ib2 ib1 lineto ib2 ib3 lineto ib0 ib3 lineto closepath stroke
  grestore
} def

% region face at -- lay out and draw one shirt front in `face`.
/shirtfront {
  /sf2 exch def /sf1 exch def /sf0 exch def
  sf0 [
    << /Name /real /Text (Real) /Font sf1
       /FitBox [ 780 300 ] /At sf2 >>
    << /Name /keep /Text (Keepin' it) /Font sf1
       /SizeOf [ /real 0.17 ]
       /At << /To /real /Chars [ 1 3 ] /H 0 /V 1 >>
       /Anchor [ /left /bottom ] /Offset [ 8 18 ]
       /Avoid [ [ /real 0 1 ] [ /real 1 3 ] [ /real 3 4 ] ] /Clearance 10 >>
    << /Name /im /Text (I'm) /Font sf1
       /SizeOf [ /keep 0.75 ]
       /At << /To /keep /H 0 /V 1 >>
       /Anchor [ /left /bottom ] /Offset [ 0 12 ]
       /Avoid [ /keep [ /real 0 1 ] [ /real 1 3 ] [ /real 3 4 ] ] /Clearance 10 >>
  ] hllayout
} def

% Chewy (top) and Bagel Fat One (bottom), each in its own panel.
/faces [ /Chewy-Regular /BagelFatOne-Regular ] def
/regions [ [ 40 470 860 880 ] [ 40 40 860 440 ] ] def
0 1 1 {
  /fi exch def
  regions fi get /rg exch def
  gsave 0.7 setgray 1 setlinewidth rg aload pop
    /p3 exch def /p2 exch def /p1 exch def /p0 exch def
    p0 p1 p2 p0 sub p3 p1 sub rectstroke grestore
  rg faces fi get [ rg 0 get 20 add rg 1 get 20 add ] shirtfront /lay exch def
  0.1 setgray lay hldraw
  lay /real hlrunink inkbox
  lay /keep hlrunink inkbox
  lay /im hlrunink inkbox
} for
