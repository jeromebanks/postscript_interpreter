%!PS-Adobe-3.0
%%Title: font_catalog.ps — the Stage 18 catalog specimen
%%Creator: pscat
%%Pages: 2
%%EndComments

% Two sheets for the runtime font catalog (fonts/catalog/). Page one:
% the classic LaserWriter 35, every name resolving to a libre
% metric-compatible face — the Liberation builtins plus TeX Gyre and
% the URW symbol faces. Page two: the display shelf, one cell per
% catalog family. Page one runs in gs from the repo root too (gs
% finds the standard names through its own Fontmap); page two's
% names are pscat-catalog-only, so gs would substitute there.
%
%   pscat --png catalog.png examples/font_catalog.ps

% ---------------------------------------------------------------- page 1
0.98 0.97 0.94 setrgbcolor clippath fill
0 setgray
/Times-Bold findfont 34 scalefont setfont
36 730 moveto (The Standard Thirty-Five) show
/Times-Italic findfont 15 scalefont setfont
36 706 moveto (every classic LaserWriter name, resolved to a libre metric-compatible face) show

/y 660 def
/row { /smp exch def /fn exch def /lbl exch def
  /Helvetica findfont 11 scalefont setfont
  36 y moveto lbl show
  fn findfont 24 scalefont setfont
  186 y moveto smp show
  /y y 46 sub def } def

(Helvetica)            /Helvetica              (Hamburgefonstiv 123) row
(Times-Roman)          /Times-Roman            (Hamburgefonstiv 123) row
(Courier)              /Courier                (Hamburgefonstiv 12)  row
(Palatino-Roman)       /Palatino-Roman         (Hamburgefonstiv 123) row
(Bookman-Light)        /Bookman-Light          (Hamburgefonstiv 123) row
(NewCenturySchlbk)     /NewCenturySchlbk-Roman (Hamburgefonstiv 123) row
(AvantGarde-Book)      /AvantGarde-Book        (Hamburgefonstiv 123) row
(ZapfChancery)         /ZapfChancery-MediumItalic (Hamburgefonstiv 123) row
(Helvetica-Narrow)     /Helvetica-Narrow       (Hamburgefonstiv 12345) row
(Symbol)               /Symbol                 (abgdepfjklmnwq\326\245\253) row
(ZapfDingbats)         /ZapfDingbats           (abcdefgHIJKLMN) row

/Times-Italic findfont 13 scalefont setfont
36 y 20 add moveto
(Bold, italic, and bold-italic cuts ride along for every text family \(pscat --fonts lists all\).) show
showpage

% ---------------------------------------------------------------- page 2
0.98 0.97 0.94 setrgbcolor clippath fill
0 setgray
/Times-Bold findfont 34 scalefont setfont
36 736 moveto (The Catalog) show
/Times-Italic findfont 15 scalefont setfont
36 712 moveto (a face for every occasion - loaded from fonts/catalog at findfont time) show

% Two columns of cells: a small gray label, the face below it.
/cy 676 def
/col 36 def
/cell { /smp exch def /fn exch def /lbl exch def
  0.45 setgray
  /Helvetica findfont 8.5 scalefont setfont
  col cy moveto lbl show
  0 setgray
  fn findfont 16 scalefont setfont
  col cy 19 sub moveto smp show
  /cy cy 33 sub def
  cy 40 lt { /cy 676 def /col 326 def } if
} def

(EBGaramond - old-style garalde)   /EBGaramond-Regular        (Hamburgefonstiv) cell
(LibreBaskerville - transitional)  /LibreBaskerville-Regular  (Hamburgefonstiv) cell
(PlayfairDisplay - didone display) /PlayfairDisplay-Regular   (Hamburgefonstiv) cell
(Lora - contemporary text)         /Lora-Regular              (Hamburgefonstiv) cell
(Cinzel - roman capitals)          /Cinzel-Regular            (HAMBURGEFONS) cell
(Poppins - geometric sans)         /Poppins-Regular           (Hamburgefonstiv) cell
(Jost - futura spirit)             /Jost-Regular              (Hamburgefonstiv) cell
(Oswald - condensed gothic)        /Oswald-Regular            (Hamburgefonstiv) cell
(Atkinson Hyperlegible)            /AtkinsonHyperlegible-Regular (Hamburgefonstiv) cell
(ZillaSlab - slab serif)           /ZillaSlab-Regular         (Hamburgefonstiv) cell
(AlfaSlabOne - fat slab)           /AlfaSlabOne-Regular       (Hamburgefonst) cell
(JetBrainsMono - coding mono)      /JetBrainsMono-Regular     (Hamburgefonst) cell
(GreatVibes - copperplate)         /GreatVibes-Regular        (Hamburgefonstiv) cell
(Pacifico - brush script)          /Pacifico-Regular          (Hamburgefonstiv) cell
(Caveat - handwriting)             /Caveat-Regular            (Hamburgefonstiv) cell
(HomemadeApple - pen hand)         /HomemadeApple-Regular     (Hamburgefonst) cell
(BebasNeue - poster caps)          /BebasNeue-Regular         (HAMBURGEFONSTIV) cell
(AbrilFatface - fat didone)        /AbrilFatface-Regular      (Hamburgefonstiv) cell
(Monoton - inline neon)            /Monoton-Regular           (HAMBURGE) cell
(Limelight - art deco)             /Limelight-Regular         (Hamburgefonstiv) cell
(Bungee - signage)                 /Bungee-Regular            (HAMBURGE) cell
(UnifrakturMaguntia - fraktur)     /UnifrakturMaguntia        (Hamburgefonstiv) cell
(PirataOne - pirate blackletter)   /PirataOne-Regular         (Hamburgefonstiv) cell
(Rye - western)                    /Rye-Regular               (Hamburgefonst) cell
(Creepster - horror)               /Creepster-Regular         (Hamburgefonstiv) cell
(PressStart2P - arcade)            /PressStart2P-Regular      (HAMBURGE) cell
(VT323 - terminal)                 /VT323-Regular             (Hamburgefonstiv) cell
(SpecialElite - typewriter)        /SpecialElite-Regular      (Hamburgefonstiv) cell
(Orbitron - sci-fi)                /Orbitron-Regular          (Hamburgefonst) cell
(Audiowide - techno)               /Audiowide-Regular         (Hamburgefonst) cell
(StardosStencil - stencil)         /StardosStencil-Regular    (Hamburgefonstiv) cell
(Bangers - comic shout)            /Bangers-Regular           (Hamburgefonstiv) cell
(ComicNeue - comic casual)         /ComicNeue-Regular         (Hamburgefonstiv) cell
(MedievalSharp - medieval)         /MedievalSharp             (Hamburgefonstiv) cell
(PermanentMarker - marker)         /PermanentMarker-Regular   (Hamburgefonst) cell
(NotoSansKR - Korean, Hangul)      /NotoSansKR-Regular        (안녕하세요) cell
(NotoSansJP - Japanese, kana+kanji) /NotoSansJP-Regular       (こんにちは) cell
(NotoSansThai - Thai script)       /NotoSansThai-Regular      (สวัสดี) cell
(NanumBrushScript - Korean brush)  /NanumBrushScript-Regular  (안녕하세요) cell
showpage
%%EOF
