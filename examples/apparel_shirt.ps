%!PS-Adobe-3.0
%%Title: Two-sided apparel graphic — the Keepin' It Real shirt configuration
%%EndComments

% A concrete configuration for lib/apparel.ps (issue #146): the
% front, the back and a pair of optional sleeve graphics for one shirt,
% each its own physical print area, all from this one file.
%
%   pscat --page 1400x760 examples/apparel_shirt.ps       proof sheet
%   scripts/apparel_export.sh examples/apparel_shirt.ps out/    full-size
%       front/back/sleeve artwork + manifest.json
%
% To make a different shirt, copy this file and change the phrases,
% faces, colours and sizes below -- nothing in lib/ needs editing.
% Delete /SleeveLeft and /SleeveRight and those graphics simply are not
% exported (see examples/apparel_second.ps).

(lib/artkit.ps) run
(lib/headline.ps) run
(lib/lettering.ps) run
(lib/apparel.ps) run

<<
  /Name (keepin-it-real)
  /DPI 300
  /Seed 7
  /Background /transparent
  /Treatment /mottled
  /Palette [ [ 0.86 0.16 0.14 ] [ 0.10 0.62 0.30 ] [ 0.13 0.32 0.78 ] ]
  /Pieces <<
    % The shirt front: `Real` fills the width, `Keepin' it` and `I'm` tuck
    % against the lowercase `ea` so the capital R rises up the left side --
    % the composition from examples/headline.ps, in this piece's own
    % points (the piece is 864 x 1008 pt; the margin and the lettering
    % contour are handled by the template). Each /Clearance is ink to ink
    % plus the contour, so the gaps here are a little larger than in
    % headline.ps's plain-text version.
    /Front << /Size [ 12 14 ] /Margin 0.5
      /Runs [
        << /Name /real /Text (Real) /Font /AlfaSlabOne
           /FitWidth 730 /At [ 66 330 ] >>
        << /Name /keep /Text (Keepin' it) /Font /Helvetica-Bold
           /Treatment /solid /Palette [ [ 0.10 0.32 0.78 ] ]
           /SizeOf [ /real 0.17 ]
           /At << /To /real /Chars [ 1 3 ] /H 0 /V 1 >>
           /Anchor [ /left /bottom ] /Offset [ 8 18 ]
           /Avoid [ [ /real 0 1 ] [ /real 1 3 ] [ /real 3 4 ] ] /Clearance 10 >>
        << /Name /im /Text (I'm) /Font /Helvetica-Bold
           /Treatment /solid /Palette [ [ 0.86 0.16 0.14 ] ]
           /SizeOf [ /keep 0.75 ]
           /At << /To /keep /H 0 /V 1 >>
           /Anchor [ /left /bottom ] /Offset [ 0 24 ]
           /Avoid [ /keep [ /real 0 1 ] [ /real 1 3 ] [ /real 3 4 ] ] /Clearance 10 >>
      ] >>
    /Back  << /Size [ 12 5 ] /Margin 0.4
              /Text (Keepin' it) /Font /PermanentMarker /Treatment /patches >>
    /SleeveLeft  << /Size [ 3.5 3.5 ] /Margin 0.25
                    /Text (No.\n1) /Font /AlfaSlabOne /Justify /center >>
    /SleeveRight << /Size [ 3.5 3.5 ] /Margin 0.25
                    /Text (Real) /Font /PermanentMarker /Treatment /solid
                    /Palette [ [ 0.10 0.62 0.30 ] ] >>
  >>
>> apmain
