%!PS-Adobe-3.0
%%Title: Two-sided apparel graphic — the Keepin' It Real shirt configuration
%%EndComments

% A concrete configuration for lib/apparel.ps (issue #146): the
% front, the back and a pair of optional sleeve graphics for one shirt,
% each its own physical print area, all from this one file.
%
%   pscat --page 1400x760 examples/apparel_shirt.ps       proof sheet
%   scripts/apparel_export.sh examples/apparel_shirt.ps out/    full-size
%       front/back/sleeve artwork + manifest.json
%
% To make a different shirt, copy this file and change the phrases,
% faces, colours and sizes below -- nothing in lib/ needs editing.
% Delete /SleeveLeft and /SleeveRight and those graphics simply are not
% exported (see examples/apparel_second.ps).

(lib/artkit.ps) run
(lib/headline.ps) run
(lib/lettering.ps) run
(lib/apparel.ps) run

<<
  /Name (keepin-it-real)
  /DPI 300
  /Seed 7
  /Background /transparent
  /Treatment /mottled
  /Palette [ [ 0.86 0.16 0.14 ] [ 0.10 0.62 0.30 ] [ 0.13 0.32 0.78 ] ]
  /Pieces <<
    /Front << /Size [ 12 14 ] /Margin 0.5
              /Text (Real) /Font /AlfaSlabOne >>
    /Back  << /Size [ 12 5 ] /Margin 0.4
              /Text (Keepin' it) /Font /PermanentMarker /Treatment /patches >>
    /SleeveLeft  << /Size [ 3.5 3.5 ] /Margin 0.25
                    /Text (No.\n1) /Font /AlfaSlabOne /Justify /center >>
    /SleeveRight << /Size [ 3.5 3.5 ] /Margin 0.25
                    /Text (Real) /Font /PermanentMarker /Treatment /solid
                    /Palette [ [ 0.10 0.62 0.30 ] ] >>
  >>
>> apmain
