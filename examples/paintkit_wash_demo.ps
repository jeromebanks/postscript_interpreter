%!PS-Adobe-3.0
%%Title: Paintkit — watercolor washes, edge pooling and paper grain (issue #47)
%%BoundingBox: 0 0 620 820
%%EndComments

% Specimen for paintkit's pkwash/pkpaper (lib/paintkit.ps): translucent
% washes built on pscat's setalpha/setblendmode (issue #47's renderer
% extension, the architecture issue #46's spike selected -- see
% docs/WATERCOLOR.md). Row 1 ramps /Alpha, row 2 /Wet, row 3 /Bloom,
% row 4 /Layers, row 5 /Grain, row 6 is the wash-order question:
% the same two washes in both orders under /Normal and under
% /Multiply. The whole sheet sits on a pkpaper ground.
%
% Under an interpreter without setalpha -- real Ghostscript, notably --
% every wash here falls back to its flattened-over-white equivalent and
% the sheet still renders, opaque: see the note printed to stdout, and
% docs/WATERCOLOR.md for why that gap exists at all.
%
%   pscat --page 620x820 examples/paintkit_wash_demo.ps --png wash.png

(lib/artkit.ps) run
(lib/paintkit.ps) run

23 srand

0 0 620 820 << /Tone [0.972 0.962 0.938] /Grain 0.55 /Seed 4 >> pkpaper

% x y label -   (dw- prefix: demo-local, distinct from paintkit's own
% reserved pk-/pn-/pb-/pz-/po-/pw-/pv- prefixes)
/dwlabel {
    /dwllabel exch def /dwly exch def /dwlx exch def
    gsave
        0.42 0.4 0.38 setrgbcolor
        /Helvetica findfont 10 scalefont setfont
        dwlx dwly moveto dwllabel show
    grestore
} def

% cx cy r -   (a circular wet region as the current path)
/dwblob {
    /dwbr exch def /dwby exch def /dwbx exch def
    newpath dwbx dwbr add dwby moveto
    dwbx dwby dwbr 0 360 arc closepath
} def

/dwink { 0.16 0.34 0.62 setrgbcolor } def
/dwrose { 0.78 0.28 0.3 setrgbcolor } def
/dwleaf { 0.32 0.5 0.28 setrgbcolor } def
/dwochre { 0.85 0.66 0.2 setrgbcolor } def

% --- row 1: wash strength ---------------------------------------------

20 790 (/Alpha -- wash strength, one pass each: 0.12  0.25  0.4  0.6) dwlabel
dwink
0 1 3 {
    /dwi exch def
    85 dwi 145 mul add 715 48 dwblob
    <<
      /Alpha 0.12 dwi 0.16 mul add
      /Layers 1 /Wet 5 /Bloom 0.5
      /Seed 100 dwi add
    >> pkwash
} for

% --- row 2: wetness ----------------------------------------------------

20 645 (/Wet -- how far the wet edge wanders off the path: 0  3  8  16) dwlabel
dwleaf
/dwwets [0 3 8 16] def
0 1 3 {
    /dwi exch def
    85 dwi 145 mul add 570 48 dwblob
    <<
      /Alpha 0.3 /Layers 2 /Wet dwwets dwi get /Bloom 0.45
      /Seed 200 dwi add
    >> pkwash
} for

% --- row 3: edge pooling ------------------------------------------------

20 500 (/Bloom -- pigment pooling at the drying edge: 0  0.35  0.7  1) dwlabel
dwrose
/dwblooms [0 0.35 0.7 1] def
0 1 3 {
    /dwi exch def
    85 dwi 145 mul add 425 48 dwblob
    <<
      /Alpha 0.28 /Layers 2 /Wet 6 /Bloom dwblooms dwi get /BloomWidth 9
      /Seed 300 dwi add
    >> pkwash
} for

% --- row 4: layered build-up --------------------------------------------

20 355 (/Layers -- glazes stacked, each with its own wet edge: 1  2  4  8) dwlabel
dwochre
/dwlayerset [1 2 4 8] def
0 1 3 {
    /dwi exch def
    85 dwi 145 mul add 280 48 dwblob
    <<
      /Alpha 0.16 /Layers dwlayerset dwi get /Wet 6 /Bloom 0.4
      /Seed 400 dwi add
    >> pkwash
} for

% --- row 5: granulation --------------------------------------------------

20 210 (/Grain -- pigment settling into the paper's tooth: 0  0.35  0.7  1) dwlabel
dwink
/dwgrains [0 0.35 0.7 1] def
0 1 3 {
    /dwi exch def
    85 dwi 145 mul add 135 48 dwblob
    <<
      /Alpha 0.3 /Layers 2 /Wet 5 /Bloom 0.4 /Grain dwgrains dwi get
      /Seed 500 dwi add
    >> pkwash
} for

% --- row 6: wash order ---------------------------------------------------

20 68 (/Blend -- Normal is order-dependent (leaf-then-rose, then reversed); /Multiply commutes) dwlabel

% x blend -        (leaf first, then rose)
/dwpair {
    /dwpb exch def /dwpx exch def
    dwleaf
    dwpx 26 add 44 26 dwblob
    << /Alpha 0.6 /Layers 2 /Wet 4 /Bloom 0.4 /Blend dwpb /Seed 601 >> pkwash
    dwrose
    dwpx 62 add 44 26 dwblob
    << /Alpha 0.6 /Layers 2 /Wet 4 /Bloom 0.4 /Blend dwpb /Seed 602 >> pkwash
} def

% x blend -        (the identical two washes, laid down the other way)
/dwpairrev {
    /dwpb exch def /dwpx exch def
    dwrose
    dwpx 62 add 44 26 dwblob
    << /Alpha 0.6 /Layers 2 /Wet 4 /Bloom 0.4 /Blend dwpb /Seed 602 >> pkwash
    dwleaf
    dwpx 26 add 44 26 dwblob
    << /Alpha 0.6 /Layers 2 /Wet 4 /Bloom 0.4 /Blend dwpb /Seed 601 >> pkwash
} def

40  /Normal   dwpair
190 /Normal   dwpairrev
340 /Multiply dwpair
490 /Multiply dwpairrev

showpage
