%!PS-Adobe-3.0
%%Title: Paper Figure — dataviz.ps bar + line + pie (plain, paper-ready)
%%BoundingBox: 0 0 612 792
%%EndComments

% Three plain, paper-ready demonstrations of lib/dataviz.ps on one
% page: a bar chart, a line chart, and a pie chart, each with axes
% or decoration where appropriate, Palatino labels, black on white.
% Run from the repo root:
%
%   pscat --page 612x792 --png out.png examples/dataviz_paper.ps

(lib/dataviz.ps) run

/showctr { /tky exch def /tkx exch def /tks exch def
    tkx tks stringwidth pop 2 div sub tky moveto tks show } def

1 1 1 setrgbcolor clippath fill
0.12 0.12 0.14 setrgbcolor

/Palatino-Bold findfont 18 scalefont setfont
(Paper Figure 2: Charts) 306 740 showctr
/Palatino-Italic findfont 10 scalefont setfont
(bar, line, and pie charts with lib/dataviz.ps — DVColors, dvaxes) 306 724 showctr

% --- top: bar chart ---
0 24 72 520 468 170 setdvframe
newpath [8 15 12 19 14 22 17] 0.22 { pop dvcolor } barchart
0.55 0.56 0.60 setrgbcolor 0.6 setlinewidth
newpath 7 4 5 dvaxes stroke
0.12 0.12 0.14 setrgbcolor
/Palatino findfont 8 scalefont setfont
(Bar chart — 7 categories) 306 620 showctr
/Palatino findfont 7 scalefont setfont
0 1 6 { /i exch def i 1 add 3 string cvs i 7 dvcatx 452 showctr } for

% --- middle: line chart ---
0 18 72 300 468 170 setdvframe
0.15 0.45 0.75 setrgbcolor 1.4 setlinewidth
newpath [4 6 5 9 7 11 9 13 10] linechart stroke
0.55 0.56 0.60 setrgbcolor 0.6 setlinewidth
newpath 9 4 5 dvaxes stroke
0.12 0.12 0.14 setrgbcolor
/Palatino findfont 8 scalefont setfont
(Line chart — 9 points) 306 460 showctr

% --- bottom: pie chart + scatter inset ---
% Pie on left
[28 22 18 14 10 8] 180 190 85 0 { pop dvcolor } piechart
/Palatino findfont 8 scalefont setfont
0.12 0.12 0.14 setrgbcolor
(Pie chart — 6 wedges) 180 90 showctr

% Scatter on right (continuous frame)
0 0 10 10 340 110 200 150 setscatterframe
newpath [[1 2] [2 5.5] [3 3.2] [4 7.8] [5 4.5] [6 8.2] [7 3.8] [8 6.9] [2.5 6]] 4 { pop pop dvcolor } scatterchart
0.55 0.56 0.60 setrgbcolor 0.6 setlinewidth
newpath 340 110 moveto 540 110 lineto 340 110 moveto 340 260 lineto stroke
/Palatino findfont 8 scalefont setfont
0.12 0.12 0.14 setrgbcolor
(Scatter — continuous domain) 440 90 showctr

% --- caption ---
/Palatino findfont 7.5 scalefont setfont
0.45 0.47 0.52 setrgbcolor
(Calls: setdvframe/barchart/dvaxes; setdvframe/linechart; piechart with ir=0; setscatterframe/scatterchart. See lib/dataviz.ps.) 306 58 showctr
(Colors via DVColors/dvcolor or {i v -> r g b} / {i x y -> r g b} callbacks.) 306 46 showctr

showpage
%%EOF
