%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 500 500
%%Title: Golden Spiral and Radial Burst
%%Creator: Claude & a nostalgic LaserWriter fan
%%EndComments

/phi 1.61803398875 def

% --- recursive golden-rectangle squares with inscribed quarter arcs ---
% x y size dir depth goldenspiral
% dir: 0=right,1=up,2=left,3=down  (direction the square "opens" toward)

% Each square hosts a quarter of the spiral, drawn clockwise (arcn) and
% centered on the corner it shares with the next, smaller square — that
% shared corner is what makes the arc endpoints chain up seamlessly.

/goldenspiral {
  5 dict begin
    /depth exch def
    /dir exch def
    /size exch def
    /y exch def
    /x exch def

    depth 0 eq { } {
      % square outline
      0.9 setgray
      1 setlinewidth
      newpath
      x y moveto
      x size add y lineto
      x size add y size add lineto
      x y size add lineto
      closepath
      stroke

      % quarter arc of the spiral
      0.85 0.6 0.1 setrgbcolor
      1.5 setlinewidth
      newpath
      dir 0 eq { x size add y          size 180  90 arcn } if
      dir 1 eq { x          y          size  90   0 arcn } if
      dir 2 eq { x          y size add size   0 270 arcn } if
      dir 3 eq { x size add y size add size 270 180 arcn } if
      stroke

      /newsize size phi div def

      dir 0 eq { x size add y size add newsize sub
                 newsize 1 depth 1 sub goldenspiral } if
      dir 1 eq { x size add newsize sub y newsize sub
                 newsize 2 depth 1 sub goldenspiral } if
      dir 2 eq { x newsize sub y
                 newsize 3 depth 1 sub goldenspiral } if
      dir 3 eq { x y size add
                 newsize 0 depth 1 sub goldenspiral } if
    } ifelse
  end
} def

125 125 200 0 9 goldenspiral

% --- a radial burst of lines just for fun texture in the corner ---
gsave
380 380 translate
0 1 71 {
  /i exch def
  gsave
    i 5 mul rotate
    0.2 setgray
    0.5 setlinewidth
    newpath
    0 0 moveto
    60 0 lineto
    stroke
  grestore
} for
grestore

showpage
%%EOF
