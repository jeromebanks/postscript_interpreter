%!PS-Adobe-3.0
%%Title: Outer Reaches — the sci-fi style-pack specimen
%%BoundingBox: 0 0 620 800
%%EndComments

% Specimen sheet for lib/styles/scifi.ps: a starfield over the void, a
% ringed planet in a targeting reticle, hologram HUD corners, a hex
% shield patch, and the synthwave grid floor — all of it sold by
% glowstroke. Run from the repo root:
%
%   pscat --page 620x800 examples/style_scifi.ps

(lib/artkit.ps) run
(lib/styles/scifi.ps) run
7 srand

/void pal 0 get aload pop setrgbcolor clippath fill
0 0 620 800 230 starfield

% --- the world -------------------------------------------------------
450 600 85 planet
450 600 85 -16 planetring

newpath 450 600 128 reticle
[0.30 0.90 0.80] 1.1 glowstroke

% a small barren moon, lit from the same side
/sfworld /hologram def
262 728 24 planet
/sfworld /void def

% --- the floor -------------------------------------------------------
newpath 40 90 540 250 16 10 gridfloor
[0.85 0.15 0.55] 1.2 glowstroke
newpath 40 340 moveto 580 340 lineto
[1.00 0.45 0.25] 1.6 glowstroke

% --- the cockpit chrome ----------------------------------------------
newpath 46 46 528 708 36 hudcorners
[0.30 0.90 0.80] 1.4 glowstroke

newpath 66 560 132 110 14 hexfield
/hologram pal 1 get aload pop setrgbcolor 0.7 setlinewidth stroke

% --- the readout -----------------------------------------------------
/Orbitron-Regular findfont 36 scalefont setfont
/void pal 4 get aload pop setrgbcolor
(OUTER REACHES) 310 430 showctr
/VT323-Regular findfont 18 scalefont setfont
/hologram pal 3 get aload pop setrgbcolor
(SECTOR 7G // BEARING 044 MARK 2 // ALL ENGINES ANSWERING) 310 398 showctr
/VT323-Regular findfont 15 scalefont setfont
/void pal 3 get aload pop setrgbcolor
(lib/styles/scifi.ps  \267  seed 7) 310 66 showctr

showpage
%%EOF
