%!PS-Adobe-3.0
%%Title: Six Charts — a specimen sheet for dataviz.ps
%%BoundingBox: 0 0 900 700
%%EndComments

% Specimen sheet for the data-visualization library (lib/dataviz.ps):
% one panel per chart type, each on its own sample data, all colored
% from the library's default cycle (dvcolor) so none of this sheet's
% own code picks colors. Top row: barchart (with dvaxes decoration),
% linechart, areachart. Bottom row: scatterchart, piechart, and a
% donut (piechart with a nonzero inner radius). Run from the repo
% root:
%
%   pscat --page 900x700 examples/dataviz.ps

(lib/dataviz.ps) run

% Not from dataviz.ps or artkit — this sheet only exercises
% dataviz.ps, so it inlines the one text-centering helper it wants
% rather than adding a dependency on artkit.ps just for showctr.
/showctr { /tky exch def /tkx exch def /tks exch def
    tkx tks stringwidth pop 2 div sub tky moveto tks show } def

1 1 1 setrgbcolor clippath fill

/Palatino-Bold findfont 24 scalefont setfont
0.1 0.1 0.12 setrgbcolor
(Six Charts) 450 664 showctr
/Palatino-Italic findfont 12 scalefont setfont
(barchart, linechart, areachart, scatterchart, piechart, donut) 450 644 showctr

/Palatino findfont 11 scalefont setfont

% --- top-left: barchart + dvaxes -----------------------------------------
0 26 50 400 250 220 setdvframe
newpath [12 19 8 15 22 17 9] 0.25 { pop dvcolor } barchart
0.3 0.3 0.34 setrgbcolor 0.8 setlinewidth
newpath 7 4 6 dvaxes stroke
0.1 0.1 0.12 setrgbcolor
(barchart: 7 categories, dvaxes) 175 386 showctr

% --- top-center: linechart ------------------------------------------------
0 12 330 400 250 220 setdvframe
0.85 0.33 0.20 setrgbcolor 2 setlinewidth
newpath [3 5 4 7 6 9 8 10] linechart stroke
0.1 0.1 0.12 setrgbcolor
(linechart: 8 points, category centers) 455 386 showctr

% --- top-right: areachart --------------------------------------------------
0 10 610 400 250 220 setdvframe
0.24 0.63 0.44 setrgbcolor
newpath [2 6 3 8 5 9 4] areachart fill
0.1 0.1 0.12 setrgbcolor
(areachart: closed to the baseline) 735 386 showctr

% --- bottom-left: scatterchart ---------------------------------------------
0 0 10 10 50 100 250 220 setscatterframe
newpath [[1 2] [2 6] [3 3] [4 8] [5 5] [6 9] [7 4] [8 7] [9 1] [3.5 6.5]]
    5 { pop pop dvcolor } scatterchart
0.3 0.3 0.34 setrgbcolor 0.8 setlinewidth
newpath 50 100 moveto 300 100 lineto 50 100 moveto 50 320 lineto stroke
0.1 0.1 0.12 setrgbcolor
(scatterchart: 10 points, continuous frame) 175 86 showctr

% --- bottom-center: piechart ------------------------------------------------
[30 25 20 15 10] 455 210 90 0 { pop dvcolor } piechart
0.1 0.1 0.12 setrgbcolor
(piechart: 5 wedges, clockwise from 12) 455 86 showctr

% --- bottom-right: donut (piechart with ir > 0) -----------------------------
[18 22 14 26 20] 735 210 90 38 { pop dvcolor } piechart
0.1 0.1 0.12 setrgbcolor
(donut: piechart with ir > 0) 735 86 showctr

showpage
%%EOF
