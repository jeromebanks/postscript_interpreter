%!PS-Adobe-3.0
%%Title: Paper Figure — graph.ps sine + trend (plain, paper-ready)
%%BoundingBox: 0 0 612 792
%%EndComments

% A single, plain, paper-ready demonstration of lib/graph.ps:
% y = sin(x) + 0.3 * (x/360) plotted over 0..720 degrees with a
% framed viewport, axes, and numeric tick labels. Black on white,
% Palatino, suitable for embedding in a document without further
% stylization. Run from the repo root:
%
%   pscat --page 612x792 --png out.png examples/graph_paper.ps
%   gs -dBATCH -dNOPAUSE -sDEVICE=png16m -g612x792 -o gs.png examples/graph_paper.ps

(lib/graph.ps) run

/showctr { /tky exch def /tkx exch def /tks exch def
    tkx tks stringwidth pop 2 div sub tky moveto tks show } def

% --- page ---
1 1 1 setrgbcolor clippath fill
0.12 0.12 0.14 setrgbcolor

% Title and caption — serif, restrained
/Palatino-Bold findfont 18 scalefont setfont
(Paper Figure 1: Sine + Trend) 306 730 showctr
/Palatino-Italic findfont 10 scalefont setfont
(y = sin x + 0.3 x/360, 0 <= x <= 720 degrees, plotted with lib/graph.ps) 306 714 showctr

% --- viewport: data domain 0..720 in x, -1.6..1.6 in y
% setframe: x0 y0 x1 y1 px py pw ph
0 -1.6 720 1.6 72 180 468 380 setframe

% Axes border + ticks
0.5 setlinewidth
0.65 0.66 0.70 setrgbcolor
newpath 4 4 6 axes stroke

% Curve
0.12 0.12 0.14 setrgbcolor
1.6 setlinewidth
newpath 0 720 360 { dup sin exch 360 div 0.3 mul add } plotfn stroke

% Tick labels
0.12 0.12 0.14 setrgbcolor
/Palatino findfont 8 scalefont setfont
(0) 0 gmapx 172 showctr
(180) 180 gmapx 172 showctr
(360) 360 gmapx 172 showctr
(540) 540 gmapx 172 showctr
(720) 720 gmapx 172 showctr
% y labels left of viewport
/Palatino findfont 8 scalefont setfont
48 -1 gmapy moveto (-1) show
48 0 gmapy moveto (0) show
48 1 gmapy moveto (1) show

% Axis titles
/Palatino-Italic findfont 9 scalefont setfont
(x \(degrees\)) 306 158 showctr
gsave 42 370 translate 90 rotate (y) 0 0 showctr grestore

% Small caption
/Palatino findfont 7.5 scalefont setfont
0.45 0.47 0.52 setrgbcolor
(Uses: setframe, plotfn, axes, gmapx/gmapy. See lib/graph.ps for plotparam/plotpolar/plotsurface.) 306 118 showctr

showpage
%%EOF
