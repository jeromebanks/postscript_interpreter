%!PS-Adobe-3.0
%%Title: Hyperbolic Geometry — a specimen sheet for artkit's disk-model library
%%BoundingBox: 0 0 700 500
%%EndComments

% Specimen sheet for artkit's hyperbolic (Poincare disk) section: three
% panels showing the three ideas the library is built from. Left is the
% headline piece — httile's {7,3} tessellation, seven-sided tiles with
% three meeting at every vertex, generated by breadth-first reflection
% and packing ever-smaller copies toward the rim (the model's signature
% look: infinitely many equal-*hyperbolic*-size tiles, shrinking in
% Euclidean terms as they approach the boundary). Top-right is hpolar:
% points placed at equal *hyperbolic* steps from the center crowd
% together as they near the rim, the same crowding httile's tiles show,
% isolated down to a single ray so the effect reads on its own. Bottom-
% right is hgeo: a handful of raw geodesics between scattered points —
% some pass near the center and read as nearly straight, others sweep
% wide arcs, all of them meeting the boundary circle at a right angle
% (visible on the ones that reach close to it), the defining property of
% a hyperbolic straight line in this model. Run from the repo root:
%
%   pscat --page 700x500 examples/hyperbolic.ps

(lib/artkit.ps) run
7 srand

1 1 1 setrgbcolor clippath fill

/Palatino-Bold findfont 20 scalefont setfont
0.1 0.1 0.12 setrgbcolor
(Hyperbolic Geometry) 350 472 showctr
/Palatino-Italic findfont 11 scalefont setfont
(Poincare disk model: httile, hpolar, hgeo) 350 455 showctr

% --- left: httile, a {7,3} tessellation ---------------------------------
/cx 210 def /cy 225 def /r 195 def
newpath cx cy r 0 360 arc
0.15 0.15 0.18 setrgbcolor 1.5 setlinewidth stroke

cx cy r 7 3 4 {
    /gen exch def
    gen 5 mod 0 eq { /dusk pal 1 get } {
    gen 5 mod 1 eq { /dusk pal 2 get } {
    gen 5 mod 2 eq { /dusk pal 3 get } {
    gen 5 mod 3 eq { /tide pal 2 get } { /tide pal 3 get } ifelse } ifelse } ifelse } ifelse
    aload pop setrgbcolor fill
    0.15 0.15 0.18 setrgbcolor 0.5 setlinewidth stroke
} httile

/Palatino findfont 11 scalefont setfont
0.1 0.1 0.12 setrgbcolor
(a {7,3} tessellation \(httile\)) cx 15 showctr

% --- top-right: hpolar, equal hyperbolic steps crowd the rim ------------
/px 550 def /py 350 def /pr 110 def
newpath px py pr 0 360 arc
0.15 0.15 0.18 setrgbcolor 1 setlinewidth stroke

0.3 0.5 0.85 setrgbcolor 1 setlinewidth
0 45 315 {
    /ang exch def
    /rdx ang cos pr mul def
    /rdy ang sin pr mul def
    newpath px py moveto px rdx add py rdy add lineto stroke
} for

0.85 0.3 0.3 setrgbcolor
0 45 315 {
    /ang exch def
    0.0 0.4 3.6 {
        /hrad exch def
        hrad ang hpolar
        /hdy exch def /hdx exch def
        newpath px hdx pr mul add py hdy pr mul add 3.2 0 360 arc fill
    } for
} for

/Palatino findfont 10 scalefont setfont
0.1 0.1 0.12 setrgbcolor
(equal hyperbolic steps \(hpolar\)) px py pr sub 16 sub showctr

% --- bottom-right: hgeo, raw geodesics between scattered points ---------
/qx 550 def /qy 128 def /qr 92 def
newpath qx qy qr 0 360 arc
0.15 0.15 0.18 setrgbcolor 1 setlinewidth stroke

/pts [
    0.05 0.10   0.70 0.55   -0.60 0.30   0.40 -0.65
    -0.20 -0.75  0.80 -0.10  -0.75 -0.35  0.15 0.80
] def
0.2 0.55 0.35 setrgbcolor 1.1 setlinewidth
0 1 pts length 2 idiv 2 sub {
    /i exch def
    newpath
    qx qy qr
        pts i 2 mul get pts i 2 mul 1 add get
        pts i 2 mul 2 add get pts i 2 mul 3 add get
    hgeo
    stroke
} for

0.85 0.3 0.3 setrgbcolor
0 1 pts length 2 idiv 1 sub {
    /i exch def
    qx pts i 2 mul get qr mul add
    qy pts i 2 mul 1 add get qr mul add
    newpath 2.6 0 360 arc fill
} for

/Palatino findfont 10 scalefont setfont
0.1 0.1 0.12 setrgbcolor
(raw geodesics between points \(hgeo\)) qx qy qr sub 16 sub showctr

showpage
