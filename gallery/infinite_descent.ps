%!PS-Adobe-3.0
%%Title: Infinite Descent
%%BoundingBox: 0 0 640 640
%%EndComments

% A Poincare-disk hyperbolic tessellation: 232 heptagons, three meeting
% at every vertex ({7,3} in the standard notation), generated by
% starting from one heptagon at the center and reflecting it across its
% own edges to spawn its neighbors, out to four reflection generations.
% Every tile is congruent in the *hyperbolic* metric this disk models —
% the shrinking toward the rim is the model's own distortion, not a
% property of the tiling. Colored by generation, so the reflections read
% as rings radiating from the center, the way ripples would if the
% "flat" surface they crossed actually curved this way. Seeded rand only
% picks the palette rotation's starting offset; the tiling itself is
% pure arithmetic, no randomness in the geometry.
%
% Gallery II (issue #10, hyperbolic geometry) — inlines horthocircle,
% hreflect, hpoly, and httile from lib/artkit.ps per the gallery's
% self-containment doctrine (see hortus.ps). hpoint and hgeo are the two
% library procs *not* needed here — httile never calls either.
%
%   pscat --page 640x640 gallery/infinite_descent.ps

3 srand

% --- the toolkit subset (from lib/artkit.ps) --------------------------
/horthocircle {
    /hoy2 exch def /hox2 exch def /hoy1 exch def /hox1 exch def
    /hod1 hox1 dup mul hoy1 dup mul add def
    /hod2 hox2 dup mul hoy2 dup mul add def
    /hodeg hod1 0.000001 lt hod2 0.000001 lt or def
    hodeg not {
        /hocx2 hox2 hod2 div def /hocy2 hoy2 hod2 div def
        /hod hox1 hoy2 hocy2 sub mul hox2 hocy2 hoy1 sub mul add
             hocx2 hoy1 hoy2 sub mul add 2 mul def
        /hodeg hodeg hod abs 0.000001 lt or def
    } if
    hodeg not {
        /hoa2 hod1 def /hob2 hod2 def
        /hoc2 hocx2 dup mul hocy2 dup mul add def
        /houx hoa2 hoy2 hocy2 sub mul hob2 hocy2 hoy1 sub mul add
              hoc2 hoy1 hoy2 sub mul add hod div def
        /houy hoa2 hocx2 hox2 sub mul hob2 hox1 hocx2 sub mul add
              hoc2 hox2 hox1 sub mul add hod div def
        /hor houx hox1 sub dup mul houy hoy1 sub dup mul add sqrt def
        /hodeg hodeg hor 50 gt or def
    } if
    hodeg {
        /hodx hox2 hox1 sub def /hody hoy2 hoy1 sub def
        /hodn hodx dup mul hody dup mul add sqrt def
        hodx hodn div hody hodn div 0 true
    } { houx houy hor false } ifelse
} def
/hreflect {
    /hry exch def /hrx exch def
    /hrisline exch def /hrr exch def /hrb exch def /hra exch def
    hrisline {
        /hrd hrx hra mul hry hrb mul add def
        hrd 2 mul hra mul hrx sub hrd 2 mul hrb mul hry sub
    } {
        /hrdx hrx hra sub def /hrdy hry hrb sub def
        /hrd2 hrdx dup mul hrdy dup mul add def
        hra hrr dup mul hrdx mul hrd2 div add
        hrb hrr dup mul hrdy mul hrd2 div add
    } ifelse
} def
/hpoly {
    /hyverts exch def /hyr exch def /hycy exch def /hycx exch def
    /hyn hyverts length 2 idiv def
    hycx hyverts 0 get hyr mul add hycy hyverts 1 get hyr mul add moveto
    0 1 hyn 1 sub {
        /hyi exch def /hyj hyi 1 add hyn mod def
        /hyx1 hyverts hyi 2 mul get def /hyy1 hyverts hyi 2 mul 1 add get def
        /hyx2 hyverts hyj 2 mul get def /hyy2 hyverts hyj 2 mul 1 add get def
        hyx1 hyy1 hyx2 hyy2 horthocircle
        /hyisline exch def /hyor exch def /hyob exch def /hyoa exch def
        hyisline {
            hycx hyx2 hyr mul add hycy hyy2 hyr mul add lineto
        } {
            /hya1 hyy1 hyob sub hyx1 hyoa sub atan def
            /hya2 hyy2 hyob sub hyx2 hyoa sub atan def
            /hyfwd hya2 hya1 sub 360 add def
            hyfwd 360 ge { /hyfwd hyfwd 360 sub def } if
            /hymid hya1 hyfwd 2 div add def
            /hymx hyoa hymid cos hyor mul add def
            /hymy hyob hymid sin hyor mul add def
            /hydcx hycx hyoa hyr mul add def /hydcy hycy hyob hyr mul add def
            /hydr hyor hyr mul def
            hymx dup mul hymy dup mul add 1 lt
                { hydcx hydcy hydr hya1 hya2 arc }
                { hydcx hydcy hydr hya1 hya2 arcn } ifelse
        } ifelse
    } for
    closepath
} def
/htmax 20000 def
/httile {
    /htproc exch def /htdepth exch def /htq exch def /htp exch def
    /htr exch def /htcy exch def /htcx exch def
    /htC 180 htp div cos 180 htp div sin div
         180 htq div cos 180 htq div sin div mul def
    /htR htC 1 sub htC 1 add div sqrt def
    /htfund htp 2 mul array def
    0 1 htp 1 sub {
        /hti exch def /hta 360 hti mul htp div def
        htfund hti 2 mul htR hta cos mul put
        htfund hti 2 mul 1 add htR hta sin mul put
    } for
    /htqueue htmax array def
    /htvisited htmax 2 mul array def
    /htqhead 0 def
    htqueue 0 [htfund 0] put
    /htqtail 1 def
    htvisited 0 0 put
    htvisited 1 0 put
    {
        htqhead htqtail ge { exit } if
        htqueue htqhead get aload pop
        /htgen exch def /htverts exch def
        /htqhead htqhead 1 add def
        htcx htcy htr htverts hpoly
        htgen htproc
        htgen htdepth lt {
            0 1 htp 1 sub {
                /hti exch def /htj hti 1 add htp mod def
                /htx1 htverts hti 2 mul get def
                /hty1 htverts hti 2 mul 1 add get def
                /htx2 htverts htj 2 mul get def
                /hty2 htverts htj 2 mul 1 add get def
                htx1 hty1 htx2 hty2 horthocircle
                /htisline exch def /htor exch def /htob exch def /htoa exch def
                /htnb htp 2 mul array def
                0 1 htp 1 sub {
                    /htk exch def
                    /htvx htverts htk 2 mul get def
                    /htvy htverts htk 2 mul 1 add get def
                    htoa htob htor htisline htvx htvy hreflect
                    /htny exch def /htnx exch def
                    htnb htk 2 mul htnx put
                    htnb htk 2 mul 1 add htny put
                } for
                /htsc 0 def
                0 1 htp 1 sub {
                    /htk exch def /htk2 htk 1 add htp mod def
                    /htedx htnb htk 2 mul get htnb htk2 2 mul get sub def
                    /htedy htnb htk 2 mul 1 add get htnb htk2 2 mul 1 add get sub def
                    /hted htedx dup mul htedy dup mul add sqrt def
                    hted htsc gt { /htsc hted def } if
                } for
                /htccx 0 def /htccy 0 def
                0 1 htp 1 sub {
                    /htk exch def
                    /htccx htccx htnb htk 2 mul get add def
                    /htccy htccy htnb htk 2 mul 1 add get add def
                } for
                /htccx htccx htp div def /htccy htccy htp div def
                /httol htsc 0.3 mul def
                /htdup false def
                0 1 htqtail 1 sub {
                    /htm exch def
                    htdup not {
                        /htdx htccx htvisited htm 2 mul get sub def
                        /htdy htccy htvisited htm 2 mul 1 add get sub def
                        htdx dup mul htdy dup mul add sqrt httol lt { /htdup true def } if
                    } if
                } for
                htdup not htqtail htmax lt and {
                    htqueue htqtail [htnb htgen 1 add] put
                    htvisited htqtail 2 mul htccx put
                    htvisited htqtail 2 mul 1 add htccy put
                    /htqtail htqtail 1 add def
                } if
            } for
        } if
    } loop
} def

% --- the palette: a ring cycle from midnight blue out to ember --------
/rings [
    [0.05 0.07 0.20] [0.13 0.16 0.38] [0.30 0.20 0.45]
    [0.55 0.25 0.40] [0.80 0.35 0.28] [0.95 0.55 0.20]
] def
/ink [0.03 0.03 0.06] def
/paper [0.97 0.95 0.90] def

paper aload pop setrgbcolor
newpath 0 0 moveto 640 0 lineto 640 640 lineto 0 640 lineto closepath fill

/cx 320 def /cy 310 def /r 245 def

cx cy r 7 3 4 {
    /gen exch def
    gsave
        rings gen rings length mod get aload pop setrgbcolor fill
    grestore
    ink aload pop setrgbcolor 0.4 setlinewidth stroke
} httile

ink aload pop setrgbcolor
newpath cx cy r 0 360 arc 2 setlinewidth stroke

% --- frame + title -----------------------------------------------------
ink aload pop setrgbcolor
1.5 setlinewidth
newpath 30 30 580 580 rectstroke

/Palatino-Bold findfont 28 scalefont setfont
(INFINITE DESCENT) dup stringwidth pop 2 div 320 exch sub 592 moveto show
/Palatino-Italic findfont 12 scalefont setfont
(a \{7,3\} tessellation of the Poincare disk, four reflections deep)
dup stringwidth pop 2 div 320 exch sub 50 moveto show

showpage
