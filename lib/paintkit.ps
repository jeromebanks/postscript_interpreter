%!PS-Adobe-3.0
%%Title: paintkit.ps — pressure-sensitive ribbon strokes for artkit
%%Creator: pscat — issue #41, the painterly-brush series' foundation
%%EndComments

% A fifth sibling to graph.ps/dataviz.ps/etching.ps/pagekit.ps, but --
% like pagekit -- it depends on lib/artkit.ps, specifically walkpath
% (issue #40, the centerline sampler). Load artkit first:
%
%   (lib/artkit.ps) run  (lib/paintkit.ps) run
%
% What's inside: `pkribbon`, that treats the current path as a
% centerline and fills a variable-width ribbon along it -- the minimum
% useful abstraction for a PostScript path as the motion of a physical
% tool rather than a uniform geometric stroke -- and `pknib` (issue
% #42), an angled-nib calligraphy preset built on top of it. See
% `pknib`'s own header, near the end of this file, for its docs.
%
% `pkdry` (issue #43) is a dry-bristle preset also built on `pkribbon`:
% a bounded family of thin offset bristles scattered across the
% centerline, each broken into ink/no-ink runs by a seeded two-state
% Markov chain, so the mark ranges from a mostly loaded brush to
% visibly broken coverage without any raster work. See its own header,
% after `pknib`'s, for full docs.
%
% `pkoil` (issue #45) is a stylized oil-paint preset — layered pressure
% ribbons and bristle traces suggesting loaded impasto without any 3D
% height map or fluid simulation. See its own header, after `pkspray`'s,
% for full docs.
%
% `pkspray` (issue #44) is not built on `pkribbon` -- spray is discrete
% particle deposition, not an offset band -- but it shares the same
% walkpath-driven shape: seeded particles scattered around each sampled
% centerline stop under the caller's own srand, with a radial falloff,
% overspray mist past the nozzle edge, and optional start/end trigger-
% dwell bursts. See its own header, after `pkdry`'s, for full docs.
%
%   opts pkribbon -
%
% `opts` is a dict of optional keys (a sparse or empty dict still
% renders -- a plain constant-width band):
%
%   /Width       base width (default 6). Must be > 0.
%   /Pitch       walkpath sampling pitch (default Width*0.5, capped at
%                6 so wide ribbons don't facet). Must be > 0.
%   /Pressure    {t -> mult} proc, t = walkpath's normalized progress
%                through the current subpath. Default `pkflat`
%                (constant 1.0). Two more presets ship: `pktaper`
%                (linear, t itself is the multiplier) and `pkbell`
%                (non-linear, a 0->1->0 hump via `sin`). Reference a
%                preset as `{ pktaper }`, or write an inline proc. Must
%                actually be a procedure, checked with `xcheck`.
%   /StartTaper  /EndTaper   0..1 fraction of progress over which
%                width additionally ramps 0->1 at the very start/end,
%                independent of and multiplicative with /Pressure --
%                needed for a clean taper regardless of the pressure
%                curve's own shape. Default 0 (no extra ramp).
%   /StartCap    /EndCap     /round (default), /flat, or /pointed --
%                any other value is rejected rather than silently
%                falling through to /flat. A cap whose computed
%                half-width is exactly 0 (taper or a zero-pressure
%                endpoint) degrades to /pointed automatically rather
%                than emitting a zero-radius arc (safe in both pscat
%                and Ghostscript, but pointless).
%   /Jitter      amount (default 0): each edge point is displaced
%                along the local perpendicular by up to +/-amount,
%                drawn from artkit's seeded `frnd` -- reproducible
%                under the caller's own `N srand`, same doctrine as
%                the rest of artkit (no library-owned seed). Skipped
%                entirely at /pointed (or degenerate) tips, and not
%                drawn at all when amount is 0 (so an unjittered call
%                doesn't perturb the caller's rand sequence). An
%                amount past Width/2 can push a point across the
%                centerline to the far side; `fill`'s nonzero winding
%                absorbs the resulting local self-crossing without
%                error, but past that point "jitter" is closer to
%                "noise" -- keep it well under Width/2 for a ribbon
%                that still reads as one continuous band.
%
% Color is deliberately not a key: `pkribbon` fills with whatever
% color the caller already set (`setrgbcolor` et al.), same as any
% other artkit shape helper.
%
% Same contract as walkpath: the caller's current path survives,
% flattened, since `pkribbon`'s own drawing happens inside its own
% `gsave`/`newpath`/`grestore`, never touching the path it just walked.
%
% Multiple subpaths in the source path each become an independent
% ribbon. A subpath actually closed with `closepath` -- tracked
% directly from the path itself (`pkscanclosed`), not inferred from
% its endpoints merely coinciding, since an open subpath can
% legitimately end exactly where it started too -- is filled as two
% concentric closed loops with no caps at all -- /StartCap//EndCap
% only apply to open paths. A degenerate single-point subpath, or a
% closed subpath too short to leave a genuinely distinct interior
% sample, falls
% back to a single filled dot (diameter Width*Pressure at that point)
% rather than erroring. An entirely empty source path is a no-op.
%
% Built with plain `fill` (nonzero winding), not `eofill`: a
% self-intersecting offset -- unavoidable wherever the centerline's
% curvature radius drops below half the ribbon's width, e.g. a tight
% Bezier at a generous /Width -- still paints the whole ribbon rather
% than punching a hole in it. That's a real, documented limitation of
% simple offset-curve stroking, not a bug. (A closed polygon's sharp
% corners might look like the same problem -- no miter/bevel joint
% between consecutive segments -- but empirically don't show it even
% at a ribbon width several times the polygon's own size: nonzero
% fill's overlap tolerance absorbs the unmitered per-vertex offset
% cleanly for the shapes this library actually renders.)
%
% Scratch prefixes: pk- (pkribbon/dispatch), pkbr- (pkbuildrun),
% pko- (pkopenrun), pkl- (pkloop), pke- (pkedge), pkh- (pkhalfwat),
% pktf- (pktaperf), pkd- (pkdot), pkg- (pkgetdef), pksc- (pkscanclosed).
% pn- (pknib/dispatch, pnangleat, pnpressure) -- issue #42, see below.
% pb- (pkdry/dispatch, pbdashrun) -- issue #43, see below. Deliberately
% distinct from pk-/pn-: pkdry calls pkribbon itself once per bristle
% dash, and pkribbon's own body freely redefines every pk*-prefixed
% name listed above on each call -- a pkdry-owned name sharing that
% prefix would get silently clobbered by its own nested pkribbon call.
% pz- (pkspray/dispatch, pzpdot, pzburstcluster) -- issue #44, see
% below; also deliberately distinct, same reasoning as pkdry's pb-.
% po- (pkoil/dispatch, porad, poroll) -- issue #45, see below; also
% deliberately distinct, same reasoning — pkoil calls pkribbon once per
% bristle dash and pkribbon's own body redefines every pk*-prefixed name.

% - [bool0 bool1 ...]   (one flag per subpath, in path order: was it
% closed with an explicit closepath?)
% A subpath whose open endpoint merely happens to coincide with its
% start (a `lineto` back to the exact starting coordinate, a full-circle
% `arc`, no `closepath`) is not the same thing as a subpath actually
% closed with `closepath` -- comparing walkpath's start/end stop
% coordinates can't tell the two apart, so the ribbon has to ask the
% path itself. `pathforall`'s close proc fires only for a real
% `closepath` segment, never for coordinates merely matching, so this
% is authoritative where a coordinate comparison is only a heuristic
% (Codex review, round 4). Same two-pass shape as artkit's own
% wkmeasure: emit the previous subpath's flag on each new moveto
% (skipped on the very first), then once more after the loop for the
% last subpath.
/pkscanclosed {
    /pkscclosed false def /pkscfirst true def
    [
        { pop pop
          pkscfirst { /pkscfirst false def } { pkscclosed } ifelse
          /pkscclosed false def }
        { pop pop }
        { pop pop pop pop pop pop }
        { /pkscclosed true def }
        pathforall
        pkscfirst not { pkscclosed } if
    ]
} def

% opts key default pkgetdef  value -
% The default is wrapped in a 1-element array rather than bound
% straight to a name -- a name bound directly to a procedure (e.g. a
% /Pressure default) auto-executes on bare reference, same as calling
% any other proc by name in this file, so returning it as `pkgdef`
% would silently invoke the default instead of yielding it. Reading it
% back with `get` sidesteps that regardless of the default's type.
/pkgetdef {                                      % dict key default -
    /pkgdef exch 1 array astore def
    /pkgkey exch def
    /pkgdict exch def
    pkgdict pkgkey known
        { pkgdict pkgkey get }
        { pkgdef 0 get }
    ifelse
} def

% --- pressure presets: t -> mult -------------------------------------
/pkflat  { pop 1.0 } def                          % constant
/pktaper { } def                                  % linear (t is the mult)
/pkbell  { 180 mul sin } def                      % non-linear 0->1->0 hump

% t -> mult   (StartTaper/EndTaper ramp; reads pkstarttaper/pkendtaper)
% Both ramps are computed unconditionally and combined with the
% minimum, not picked by a mutually exclusive branch on which side of
% the midpoint t falls -- if /StartTaper and /EndTaper sum past 1
% their ramp regions overlap, and a branch that applies only one would
% jump discontinuously right at the branch boundary (Codex review,
% round 1). Each ramp already evaluates to 1.0 (no constraint) outside
% its own region, so the minimum is exactly "whichever ramp constrains
% more here," continuous everywhere including the overlap.
/pktaperf {
    /pktft exch def
    /pktfs
        pktft pkstarttaper lt pkstarttaper 0 gt and
            { pktft pkstarttaper div }
            { 1.0 }
        ifelse
    def
    /pktfe
        pktft 1 pkendtaper sub gt pkendtaper 0 gt and
            { 1 pktft sub pkendtaper div }
            { 1.0 }
        ifelse
    def
    pktfs pktfe lt { pktfs } { pktfe } ifelse
} def

% t -> halfwidth   (reads pkwidth/pkpressure/pktaperf's globals)
/pkhalfwat {
    /pkht exch def
    pkwidth
    pkht pkpressure
    pkht pktaperf
    mul mul 2 div
} def

% amount -> offset in -amount..amount, deterministic under srand
/pkjit { frnd 2 mul 1 sub mul } def

% x y ang halfw side -> ex ey   (side: -1 right / +1 left of travel;
% applies /Jitter along the perpendicular, skipped entirely at 0)
/pkedge {
    /pkeside exch def /pkehw exch def /pkeang exch def
    /pkey exch def /pkex exch def
    /pkeoff pkjitter 0 eq { pkehw } { pkehw pkjitter pkjit add } ifelse def
    /pkepa pkeang 90 pkeside mul add def
    pkex pkepa cos pkeoff mul add
    pkey pkepa sin pkeoff mul add
} def

% [x y ang t sp atend] pkdot -   (degenerate single-point fallback)
% Diameter is Width*Pressure only -- not pkhalfwat's full
% Width*Pressure*taper. /StartTaper//EndTaper ramp width in from the
% *ends of a path*; a lone point has no path to ramp along, and
% applying them anyway could zero out the dot entirely (e.g. any
% nonzero /StartTaper at t=0) for a caller who never asked for that.
/pkdot {
    dup 0 get /pkdx exch def
    dup 1 get /pkdy exch def
    3 get /pkdt exch def
    /pkdhw pkwidth pkdt pkpressure mul 2 div def
    pkdhw 0 gt { pkdx pkdy pkdhw 0 360 arc closepath } if
} def

% start end side reverse pkloop -   (one closed offset loop, no caps)
% `reverse` must be opposite between the two loops of a ring (right
% and left side of the same closed centerline): offsetting doesn't
% change the underlying curve's own traversal direction, so building
% both loops start-to-end gives them the *same* winding sign under
% nonzero fill and they add instead of one punching a hole in the
% other -- confirmed empirically (a closed square rendered solid, no
% ring) before this fix (Codex review, round 1).
/pkloop {
    /pklrev exch def /pklside exch def /pklend exch def /pklstart exch def
    /pklfrom pklrev { pklend } { pklstart } ifelse def
    /pklto pklrev { pklstart } { pklend } ifelse def
    /pklstep pklrev { -1 } { 1 } ifelse def
    pkraw pklfrom get
    dup 0 get /pklx exch def dup 1 get /pkly exch def
    dup 2 get /pklang exch def 3 get /pklt exch def
    pklx pkly pklang pklt pkhalfwat pklside pkedge moveto
    pklfrom pklstep add pklstep pklto {
        /pkli exch def
        pkraw pkli get
        dup 0 get /pklx exch def dup 1 get /pkly exch def
        dup 2 get /pklang exch def 3 get /pklt exch def
        pklx pkly pklang pklt pkhalfwat pklside pkedge lineto
    } for
    closepath
} def

% start end pkopenrun -   (one open ribbon polygon with caps)
% A cap degrades to /pointed automatically only when its half-width is
% truly <= 0, not some small-but-scale-fragile epsilon: a zero-radius
% `arc` is well-defined and safe in both pscat and Ghostscript
% (verified directly), so there's nothing to guard against by treating
% a merely-small-in-*user-space* width as zero -- that would wrongly
% collapse a real cap to a point under a large CTM, where a user-space
% width like 0.002 can still be many device pixels wide (Codex review,
% round 1).
/pkopenrun {
    /pkoend exch def /pkostart exch def

    pkraw pkostart get
    dup 0 get /pkox0 exch def dup 1 get /pkoy0 exch def
    dup 2 get /pkoang0 exch def 3 get /pkot0 exch def
    /pkohw0 pkot0 pkhalfwat def
    /pkostartpointed
        pkstartcap /pointed eq pkohw0 0 le or
    def

    pkraw pkoend get
    dup 0 get /pkoxe exch def dup 1 get /pkoye exch def
    dup 2 get /pkoange exch def 3 get /pkotend exch def
    /pkohwe pkotend pkhalfwat def
    /pkoendpointed
        pkendcap /pointed eq pkohwe 0 le or
    def
    /pkorightlast pkoendpointed { pkoend 1 sub } { pkoend } ifelse def

    % Both ends pointed with no interior stops between them (walkpath
    % emits only start+end for a subpath shorter than /Pitch): the
    % straight start-tip-to-end-tip line this would otherwise build has
    % zero area under `fill`, silently rendering nothing for a valid
    % short pointed (or fully-tapered) stroke. Synthesize one interior
    % sample at the run's midpoint -- chord direction (exact regardless
    % of the underlying curve, since there's nothing between the two
    % known points to look at) and averaged progress -- so it renders
    % as a lens instead (Codex review, round 3).
    pkostartpointed pkoendpointed and pkorightlast pkostart le and {
        % The chord itself can be zero-length here -- an open subpath
        % that returns exactly to its own start (an unclosed full-circle
        % arc, a lineto back to the exact starting point) and is also
        % shorter than /Pitch has pkox0==pkoxe/pkoy0==pkoye, and `atan`
        % on (0,0) is undefined in both pscat and Ghostscript (Codex
        % review, round 6). No chord direction exists to synthesize a
        % midpoint from in that case; fall back to a dot, same as any
        % other genuinely degenerate short run.
        /pkomdx pkoxe pkox0 sub def
        /pkomdy pkoye pkoy0 sub def
        pkomdx 0 eq pkomdy 0 eq and
        {
            pkraw pkostart get pkdot
        } {
            /pkomidx pkox0 pkoxe add 2 div def
            /pkomidy pkoy0 pkoye add 2 div def
            /pkomidang pkomdy pkomdx atan def
            /pkomidt pkot0 pkotend add 2 div def
            pkox0 pkoy0 moveto
            pkomidx pkomidy pkomidang pkomidt pkhalfwat -1 pkedge lineto
            pkoxe pkoye lineto
            pkomidx pkomidy pkomidang pkomidt pkhalfwat 1 pkedge lineto
            closepath
        } ifelse
    } {
        pkostartpointed
            { pkox0 pkoy0 moveto }
            { pkox0 pkoy0 pkoang0 pkohw0 -1 pkedge moveto }
        ifelse

        pkostart 1 add 1 pkorightlast {
            /pkoi exch def
            pkraw pkoi get
            dup 0 get /pkoix exch def dup 1 get /pkoiy exch def
            dup 2 get /pkoiang exch def 3 get /pkoit exch def
            pkoix pkoiy pkoiang pkoit pkhalfwat -1 pkedge lineto
        } for

        pkoendpointed {
            pkoxe pkoye lineto
        } {
            pkendcap /round eq {
                pkoxe pkoye pkohwe pkoange 90 sub pkoange 90 add arc
            } {
                pkoxe pkoye pkoange pkohwe 1 pkedge lineto
            } ifelse
        } ifelse

        /pkoleftfirst pkostartpointed { pkostart 1 add } { pkostart } ifelse def
        pkoend 1 sub -1 pkoleftfirst {
            /pkoi exch def
            pkraw pkoi get
            dup 0 get /pkoix exch def dup 1 get /pkoiy exch def
            dup 2 get /pkoiang exch def 3 get /pkoit exch def
            pkoix pkoiy pkoiang pkoit pkhalfwat 1 pkedge lineto
        } for

        pkostartpointed { } {
            pkstartcap /round eq {
                pkox0 pkoy0 pkohw0 pkoang0 90 add pkoang0 270 add arc
            } if
        } ifelse
        closepath
    } ifelse
} def

% start end closed pkbuildrun -   (one subpath's worth of walkpath stops;
% closed comes from pkscanclosed, not inferred from coordinates)
/pkbuildrun {
    /pkbrclosed exch def /pkbrend exch def /pkbrstart exch def
    % Coalesce a trailing sp==0 duplicate (the guaranteed end stop
    % landing exactly on the last regular pitch-multiple stop, per
    % walkpath's own documented behavior) up front, before anything
    % below decides whether a genuine interior sample exists -- a
    % stroke whose length happens to be an exact multiple of /Pitch
    % would otherwise look like it has one real sample past the start
    % when both remaining candidates actually sit at the same position
    % (Codex review, round 4). Always safe: the only way to reach a
    % 2-stop run (pkbrend == pkbrstart+1) is a subpath shorter than one
    % pitch step, whose second stop's sp is the subpath's positive
    % length, not 0, so this never collapses a run down past pkbrend's
    % immediate predecessor.
    pkbrend pkbrstart gt pkraw pkbrend get 4 get 0 eq and {
        /pkbrend pkbrend 1 sub def
    } if
    pkbrstart pkbrend eq pkraw pkbrstart get 5 get 3 eq and {
        pkraw pkbrstart get pkdot
    } {
        pkraw pkbrstart get 0 get /pkbrx0 exch def
        pkraw pkbrstart get 1 get /pkbry0 exch def
        pkbrclosed {
            % Even after the dedup above, a closed run whose *total*
            % length is under one pitch step never gets a genuine
            % intermediate sample -- walkpath emits only its start and
            % the guaranteed end, and for a closed subpath the end
            % *always* returns to the start's own coordinates (that's
            % what closed means), so pkbrend's position is never a
            % useful signal here -- comparing it against pkbrstart is
            % comparing a closed loop's end to itself, always equal by
            % construction, regardless of whether real content exists
            % in between. What actually matters is whether at least one
            % *index* strictly between pkbrstart and pkbrend exists
            % (pkbrend >= pkbrstart+2) -- a real regular stop from
            % walkpath's own arc-length stepping, which can only differ
            % from the start position if genuine path length separates
            % them.
            /pkbrhasinterior pkbrend pkbrstart 1 add gt def
            pkbrhasinterior {
                pkbrstart pkbrend -1 false pkloop
                pkbrstart pkbrend 1 true pkloop
            } {
                pkraw pkbrstart get pkdot
            } ifelse
        } {
            pkbrstart pkbrend pkopenrun
        } ifelse
    } ifelse
} def

% opts pkribbon -
/pkribbon {
    /pkopts exch def
    % Value options (/Width here, and /Pitch/StartTaper/EndTaper/Jitter/
    % StartCap/EndCap below) must not themselves be executable: binding
    % one straight to its own name the way pkgetdef's result normally
    % is makes every later *bare* reference to that name auto-execute
    % it instead of yielding the value, since a name bound to something
    % executable always runs on reference -- the same trap /Pressure's
    % own guard exists for (see below), but these fields are documented
    % as plain values, not callbacks, so an executable one (e.g.
    % `<< /Width { 10 } >>`) is malformed input, not something to
    % support (Codex review, round 7). Checked with `load`, same
    % reason as /Pressure: a bare `pkwidth xcheck` would itself
    % auto-execute pkwidth before xcheck ever saw it.
    /pkwidth pkopts /Width 6 pkgetdef def
    /pkwidth load xcheck { pkribbon-width-must-not-be-a-procedure } if
    pkwidth 0 le { pkribbon-width-must-be-positive } if
    /pkpitch
        pkopts /Pitch
        pkwidth 0.5 mul dup 6 gt { pop 6 } if
        pkgetdef
    def
    /pkpitch load xcheck { pkribbon-pitch-must-not-be-a-procedure } if
    pkpitch 0 le { pkribbon-pitch-must-be-positive } if
    % /Pressure must actually be a procedure: pkhalfwat calls it as
    % `t pkpressure`, expecting it to consume t and leave one number.
    % A non-procedure value (e.g. a bare number) is never auto-executed
    % -- it just gets pushed instead of run -- leaking extra operands
    % into every downstream computation instead of raising a clean
    % error (Codex review, round 2). Checked with `/pkpressure load
    % xcheck`, not a bare `pkpressure xcheck`: pkpressure is *already*
    % bound to a procedure in the common case, and a bare reference to
    % a name bound to an executable auto-runs it -- the exact trap
    % `pkgetdef`'s own header comment documents -- which would call the
    % default pressure proc with nothing to operate on before `xcheck`
    % ever saw it. `load` fetches the bound value without executing it,
    % regardless of its type. `xcheck` alone isn't sufficient either
    % (Codex review, round 3): it only tests the executable attribute,
    % and an executable non-procedure (e.g. `2 cvx`) passes it despite
    % `pkht pkpressure` just pushing the number instead of running
    % anything, same corruption as an unvalidated plain number -- so
    % `type` must also be an actually-callable kind: `arraytype` for a
    % user proc, `operatortype` for a bound built-in, or (Codex review,
    % round 5) `packedarraytype` -- under a Level 2 interpreter with
    % packing enabled (`true setpacking`; confirmed against real
    % Ghostscript, though pscat itself doesn't actually pack), a plain
    % procedure literal like the /Pressure default itself, `{ pkflat }`,
    % can legitimately have this type instead of `arraytype`, and
    % rejecting it would make `pkribbon` fail even on its own default.
    /pkpressure pkopts /Pressure { pkflat } pkgetdef def
    /pkpressure load xcheck
    /pkpressure load type
    dup /arraytype eq
    exch dup /operatortype eq
    exch /packedarraytype eq
    or or
    and
    not { pkribbon-pressure-must-be-a-procedure } if
    % /StartTaper//EndTaper: the documented range is 0..1 -- outside it
    % doesn't crash (pktaperf's guard conditions just degrade: negative
    % silently disables the ramp, above 1 keeps the whole stroke short
    % of full width) but that's a real contract violation, not merely a
    % style choice, so it's validated the same as every other documented
    % constraint here (Codex review, round 5).
    /pkstarttaper pkopts /StartTaper 0 pkgetdef def
    /pkstarttaper load xcheck { pkribbon-starttaper-must-not-be-a-procedure } if
    pkstarttaper 0 lt pkstarttaper 1 gt or
        { pkribbon-starttaper-must-be-0-to-1 } if
    /pkendtaper pkopts /EndTaper 0 pkgetdef def
    /pkendtaper load xcheck { pkribbon-endtaper-must-not-be-a-procedure } if
    pkendtaper 0 lt pkendtaper 1 gt or
        { pkribbon-endtaper-must-be-0-to-1 } if
    % /StartCap//EndCap: anything other than the three documented
    % values used to fall through to /flat silently (Codex review,
    % round 2) -- validated explicitly instead. Checked for executable-
    % ness first, same reason as /Width above: an executable value
    % (even one that happens to push a valid cap name when run) isn't
    % itself one of the three documented literal values.
    /pkstartcap pkopts /StartCap /round pkgetdef def
    /pkstartcap load xcheck { pkribbon-startcap-must-not-be-a-procedure } if
    pkstartcap /round eq pkstartcap /flat eq or pkstartcap /pointed eq or not
        { pkribbon-startcap-must-be-round-flat-or-pointed } if
    /pkendcap pkopts /EndCap /round pkgetdef def
    /pkendcap load xcheck { pkribbon-endcap-must-not-be-a-procedure } if
    pkendcap /round eq pkendcap /flat eq or pkendcap /pointed eq or not
        { pkribbon-endcap-must-be-round-flat-or-pointed } if
    /pkjitter pkopts /Jitter 0 pkgetdef def
    /pkjitter load xcheck { pkribbon-jitter-must-not-be-a-procedure } if

    /pkclosedflags pkscanclosed def

    % Two walkpath passes over the same (surviving, per its own
    % contract) flattened path -- count, then fill a preallocated
    % array -- same shape as artkit's own wkmeasure/wkseg split.
    % Tried a one-pass `[ pitch { 6 array astore } walkpath ]` first:
    % it looks like it should work (walkpath's own state lives in
    % named vars, not the stack), and it does for a single-segment
    % path, but it breaks on a second subpath. walkpath's own moveto
    % handler calls `wkend` (emitting the previous subpath's guaranteed
    % end stop through wkproc) *before* consuming the x/y pathforall
    % just pushed it for the new subpath -- so a wkproc that leaves an
    % array sitting on the stack instead of consuming it steals that
    % x/y out from under it. Confirmed empirically against plain
    % walkpath, no paintkit involved. A proc that fully consumes its 6
    % inputs every call (store-by-index, net stack effect zero) sidesteps
    % it regardless of how deep it's nested in someone else's callback.
    /pkcount 0 def
    pkpitch { pop pop pop pop pop pop /pkcount pkcount 1 add def } walkpath
    /pkraw pkcount array def
    /pkci 0 def
    pkpitch {
        6 array astore pkraw pkci 3 -1 roll put
        /pkci pkci 1 add def
    } walkpath
    /pkn pkraw length def

    pkn 0 gt {
        gsave
        newpath
        /pki 0 def
        /pkrunstart 0 def
        /pksubidx 0 def
        {
            pki pkn ge { exit } if
            pkraw pki get 5 get /pkae exch def
            pkae 1 and 1 eq { /pkrunstart pki def } if
            pkae 2 and 2 eq {
                pkrunstart pki pkclosedflags pksubidx get pkbuildrun
                /pksubidx pksubidx 1 add def
            } if
            /pki pki 1 add def
        } loop
        fill
        grestore
    } if
} def

% --- angled-nib calligraphy brush (issue #42) -------------------------
% opts pknib -
% A chisel/broad-edge calligraphic-nib preset built on `pkribbon`: mark
% width is driven by the angle between the path's local direction of
% travel and a fixed nib angle (`/Angle`), the same physical model as a
% real flat-nib pen -- widest where travel runs perpendicular to the
% nib, narrowing toward a hairline where travel runs parallel to it
% (`width ~ |sin(travel - Angle)|`). Pressure, taper, caps, and seeded
% jitter all still come straight from `pkribbon` (the brush core) and
% compose multiplicatively with the nib-angle response.
%
%   opts pknib -
%
% The current path must be exactly one *open* subpath -- a nib stroke
% has a start and an end by definition, the same as lifting a real pen
% off the page; a closed loop has no ends to cap or taper, and more
% than one subpath has no single well-defined travel direction for
% `/Pressure` to reset against at each one's own t=0. Both are rejected
% with a clear error rather than guessing which subpath is "the"
% stroke or silently treating a closed loop as open. Draw multiple
% strokes by calling `pknib` once per stroke -- the natural mental
% model for a pen that's picked up and set down again. An empty path
% is a no-op, same as `pkribbon`.
%
% Approximation, stated plainly: this varies *width* with travel angle
% but still offsets edges perpendicular to travel (via `pkribbon`'s own
% `pkedge`) and caps perpendicular to travel too -- a real broad nib
% instead shears its edges along the fixed nib axis and leaves a flat
% end-cut *at* the nib angle, regardless of travel direction. That
% distinction shows up mainly at corners and cut ends, not along a
% stroke's body. The issue's own framing -- "derive mark width from the
% relationship between path direction and a configurable nib angle" --
% asks for the width response, which this delivers exactly; the sheared
% -edge/angled-cut refinement is a real, deliberately out-of-scope next
% step for a later revision, not an oversight.
%
%   /Angle       nib angle in degrees (default 45). Perpendicular to
%                Angle is widest; parallel to Angle narrows toward
%                /MinWidth.
%   /MinWidth    0..1 floor on the nib-angle response itself (not a
%                floor on the final rendered width) -- the multiplier
%                `|sin(travel - Angle)|` never drops below this before
%                /Pressure and the tapers multiply through, modeling a
%                real nib's own finite edge thickness rather than a
%                mathematically perfect zero-width hairline. Default
%                0.08.
%   /Width, /Pitch, /Pressure, /StartTaper, /EndTaper, /StartCap,
%                /EndCap, /Jitter -- forwarded to `pkribbon` verbatim;
%                see its own docs. /Pressure (default `pkflat`)
%                multiplies with the nib-angle response rather than
%                replacing it, the same kind of composition
%                /StartTaper//EndTaper already have with /Pressure
%                inside `pkribbon` itself.
%
% Implementation: a preliminary `walkpath` pass, at the same pitch
% `pkribbon` would use, samples (t, travel angle) once per stop; a
% synthesized `/Pressure` proc installed on a shallow copy of `opts`
% looks up the *nearest* sample's angle for a given t -- no
% interpolation, deliberately: a real chisel nib's width genuinely
% jumps at a sharp corner, so smoothing across one would be less
% faithful, not more, and it sidesteps degrees-wraparound interpolation
% entirely -- and folds in the nib-angle multiplier before calling
% through to the caller's own /Pressure. `pkribbon` itself never
% inspects /Angle//MinWidth -- unknown dict keys are already ignored
% elsewhere in this file (`pkgetdef` only reads keys it's told to), so
% the shallow copy doesn't need to strip them. `pkribbon` re-walks the
% same (already-flattened, so identically flattened both times) path
% itself when it actually fills, at the same default pitch when the
% caller didn't override /Pitch -- its own stops land at the same t
% values this pass already sampled.
% Each pnangles entry is [t x y ang] -- x/y are needed only for the
% two-sample chord fallback below, not the ordinary nearest-sample path.
/pnangleat {                                      % t -> travel angle (degrees)
    /pnqt exch def
    pnangles 0 get
    dup 0 get pnqt sub abs /pnbestd exch def
    3 get /pnbestang exch def
    1 1 pnangles length 1 sub {
        /pnqi exch def
        pnangles pnqi get
        dup 0 get pnqt sub abs /pnqd exch def
        3 get /pnqang exch def
        pnqd pnbestd lt {
            /pnbestd pnqd def
            /pnbestang pnqang def
        } if
    } for
    % A run with exactly two raw samples (start+end, no interior stop
    % -- a subpath shorter than one pitch step) has nothing at t values
    % strictly between them. pkopenrun's own short-run synthesis (both
    % ends pointed or zero-width) fills that gap with one interior
    % bulge point, evaluated at the *chord's* own direction, not either
    % endpoint's travel angle -- so a query for that synthesized point
    % previously fell back to whichever endpoint's t happened to be
    % numerically closer, an arbitrary and sometimes very wrong answer
    % (a short symmetric arch with a horizontal midpoint tangent could
    % render at nearly full width instead of the requested near-
    % hairline; Codex review, PR #77, round 2). pkribbon only ever
    % evaluates /Pressure at a raw stop's own t or at that one
    % synthesized t, so a query that doesn't closely match either of
    % our two raw samples can only be the synthesized point -- switch
    % to the chord direction then, computed the same way pkopenrun
    % computes it. A coincident-endpoint chord (an open path with
    % positive arc length that still returns to its own start -- same
    % edge case pkopenrun's own round-6 fix guards) has no direction to
    % synthesize either; fall back to the nearest-sample angle already
    % computed above rather than call `atan` on a zero chord.
    pnangles length 2 eq pnbestd 1.0e-6 gt and {
        pnangles 0 get /pnq0 exch def
        pnangles 1 get /pnq1 exch def
        pnq1 1 get pnq0 1 get sub /pnqdx exch def
        pnq1 2 get pnq0 2 get sub /pnqdy exch def
        pnqdx 0 eq pnqdy 0 eq and
            { pnbestang }
            { pnqdy pnqdx atan }
        ifelse
    } {
        pnbestang
    } ifelse
} def

% t -> mult   (installed as pkribbon's own /Pressure; reads
% pnangle/pnminwidth/pnuserpressure/pnangles, set fresh by pknib)
% A single-sample pnangles table (pnn/pnangles length 1) means the
% source subpath was a degenerate single point -- walkpath's own
% contract guarantees any subpath with real length gets at least two
% stops, so this is an unambiguous signal, not a heuristic. A lone
% point has no direction of travel (walkpath reports a synthetic
% ang=0 for it, not a real one), so the nib-angle response has nothing
% meaningful to attenuate against; using it anyway made the degenerate-
% point dot fallback either vanish (Angle 0, MinWidth 0) or resize
% arbitrarily with Angle, silently breaking pkribbon's own documented
% "degenerate paths fall back to a dot" contract this preset is
% supposed to preserve (Codex review, PR #77). Skip the nib multiplier
% entirely in that case -- full response, same as if travel were
% perfectly perpendicular to the nib -- so the dot's size tracks only
% /Pressure, exactly like pkribbon's own undiminished pkdot.
/pnpressure {
    /pnpt exch def
    pnangles length 1 eq
        { 1.0 }
        {
            pnpt pnangleat pnangle sub sin abs
            dup pnminwidth lt { pop pnminwidth } if
        }
    ifelse
    pnpt pnuserpressure mul
} def

/pknib {
    /pnopts exch def

    /pnmoveto 0 def /pnclosed false def
    {
        pop pop /pnmoveto pnmoveto 1 add def
    } {
        pop pop
    } {
        pop pop pop pop pop pop
    } {
        /pnclosed true def
    } pathforall
    pnmoveto 1 gt { pknib-path-must-be-a-single-subpath } if
    pnclosed { pknib-path-must-not-be-closed } if

    % Same Width/Pitch validation pkribbon itself does, and -- like
    % pkribbon -- run unconditionally, not only when the path is
    % non-empty: pkribbon validates its whole opts dict before ever
    % looking at the path, so a malformed dict (wrong types, a bare
    % non-dict operand) errors the same way regardless of what's on
    % the path. Gating validation behind `pnmoveto 0 gt` let a
    % malformed opts dict through silently whenever the path happened
    % to be empty -- `newpath 42 pknib` never even read `pnopts` as a
    % dict, unlike pkribbon's own `typecheck` for the same call (Codex
    % review, PR #77). Only the sampling/rendering work below is
    % actually conditional on a non-empty path.
    /pnwidth pnopts /Width 6 pkgetdef def
    /pnwidth load xcheck { pknib-width-must-not-be-a-procedure } if
    pnwidth 0 le { pknib-width-must-be-positive } if
    /pnpitch
        pnopts /Pitch
        pnwidth 0.5 mul dup 6 gt { pop 6 } if
        pkgetdef
    def
    /pnpitch load xcheck { pknib-pitch-must-not-be-a-procedure } if
    pnpitch 0 le { pknib-pitch-must-be-positive } if

    /pnangle pnopts /Angle 45 pkgetdef def
    /pnangle load xcheck { pknib-angle-must-not-be-a-procedure } if

    /pnminwidth pnopts /MinWidth 0.08 pkgetdef def
    /pnminwidth load xcheck { pknib-minwidth-must-not-be-a-procedure } if
    pnminwidth 0 lt pnminwidth 1 gt or { pknib-minwidth-must-be-0-to-1 } if

    % Same /Pressure validation as pkribbon's own (Codex rounds 2/3/5
    % there): must actually be callable, not just executable, since
    % pnpressure above calls it by bare reference expecting it to
    % consume t and leave one number.
    /pnuserpressure pnopts /Pressure { pkflat } pkgetdef def
    /pnuserpressure load xcheck
    /pnuserpressure load type
    dup /arraytype eq
    exch dup /operatortype eq
    exch /packedarraytype eq
    or or
    and
    not { pknib-pressure-must-be-a-procedure } if

    % Unconditional, like the validation above: pkribbon validates
    % *every* forwarded field (including /StartTaper//EndTaper//
    % StartCap//EndCap//Jitter, which pknib itself never checks) before
    % looking at whether the path is empty, and its own `pkn 0 gt`
    % guard already handles the actual no-op correctly -- gating this
    % block behind `pnmoveto 0 gt` let those forwarded-only fields
    % through unvalidated on an empty path (Codex review, PR #77,
    % round 2). Sampling an empty path is harmless (walkpath's own
    % callback never fires, same as pkribbon's own width-computation
    % pass over an empty path), so nothing here needs a separate guard.
    /pnn 0 def
    pnpitch { pop pop pop pop pop pop /pnn pnn 1 add def } walkpath
    /pnangles pnn array def
    /pnj 0 def
    pnpitch {
        /pnaatend exch def /pnasp exch def /pnat exch def
        /pnaang exch def /pnay exch def /pnax exch def
        pnangles pnj pnat pnax pnay pnaang 4 array astore put
        /pnj pnj 1 add def
    } walkpath

    /pnribbonopts pnopts length 1 add dict def
    pnopts pnribbonopts copy pop
    pnribbonopts /Pressure /pnpressure load put
    pnribbonopts pkribbon
} def

% --- dry-bristle brush (issue #43) ------------------------------------
% opts pkdry -
% A bounded family of thin offset bristles scattered across the
% centerline, each broken into its own ink/no-ink runs by a seeded
% two-state Markov chain -- the physical model of a brush that's
% running low on paint: some bristles keep full contact, others skip
% and catch unevenly, the breakup tracking the path itself rather than
% reading as unrelated page noise. Ranges from a mostly loaded stroke
% (high /Load, low /Dropout) to visibly broken dry-brush texture (low
% /Load, high /Dropout) with no raster work at all: every dash is a
% small `pkribbon` call, so caps, taper, and a single isolated fleck
% (walkpath's own degenerate single-point fallback -- see pkribbon's
% own dot doc) all come for free.
%
%   opts pkdry -
%
%   /Width         envelope width the bristles scatter across (default
%                  6). Must be > 0. Same role as pkribbon's /Width, but
%                  here it bounds the *scatter*, not one mark's own
%                  thickness -- see /BristleWidth for that.
%   /Bristles      bristle count (default 18). Must be a whole number,
%                  1..100 -- a hard safety cap chosen so even the cap
%                  combined with a
%                  long path at the default /Pitch stays in the
%                  single-digit seconds (measured, see Performance
%                  below), not unbounded. This alone doesn't bound
%                  total ink deposits (a long path at a fine /Pitch
%                  still multiplies out) -- see the deposit-budget
%                  check below, the real limit the issue asks for.
%   /Spread        0..1 fraction of Width the bristles scatter across,
%                  centered on the centerline (default 0.85). Must be
%                  0..1.
%   /BristleWidth  base width of each individual bristle's own mark
%                  (default Width*0.12). Must be > 0.
%   /WidthJitter   0..1 fraction of BristleWidth that each bristle's
%                  own width randomly varies by, one draw per bristle,
%                  clamped to never go below 5% of BristleWidth
%                  (default 0.4). Must be 0..1.
%   /Load          the resume-contact rate: how readily a bristle
%                  picks ink back up after a gap (default 0.6).
%   /Dropout       the lose-contact rate: how readily a loaded bristle
%                  skips contact (default 0.4).
%                  Both /Load and /Dropout are expressed as a rate per
%                  one /Width's worth of travel along the path, *not*
%                  per raw walkpath sample -- scaled down to a
%                  per-sample transition probability by (Pitch/Width),
%                  clamped to 0..1, so the same numbers read as the
%                  same dryness regardless of /Pitch. Both must be
%                  0..1 (the rate itself, before that scaling).
%                  Loaded: high Load, low Dropout. Very dry: low Load,
%                  high Dropout. A subpath's very first sample rolls
%                  initial contact with the raw (unscaled) Load
%                  probability, not the Pitch-scaled per-step rate --
%                  "does this bristle start loaded" is a one-time
%                  boundary condition, not a rate along the path, and
%                  it's the *only* roll a degenerate single-point
%                  subpath (see below) ever gets.
%   /Jitter        edge roughness, forwarded verbatim as each dash's
%                  own pkribbon /Jitter (default 0). Shares the same
%                  seeded random stream as the Markov chain above --
%                  changing /Jitter from 0 reshuffles every downstream
%                  on/off roll too, not just the edges, so two renders
%                  that differ only in /Jitter will generally have a
%                  *different breakup pattern*, not the same pattern
%                  with rougher edges. Still fully deterministic under
%                  the caller's own `N srand` either way.
%   /Pitch         walkpath sampling pitch for the shared centerline
%                  pass (default BristleWidth*0.6, capped at 6, same
%                  shape as pkribbon's own default). Must be > 0.
%   /ColorJitter   0..1 magnitude of small per-bristle color variation
%                  (default 0.06): each bristle applies one `shade`
%                  draw, k = 1 +/- ColorJitter, around whatever color
%                  is active when pkdry is called (`currentrgbcolor`)
%                  -- consistent with the rest of this file, color is
%                  deliberately not a settable key here either. 0
%                  disables the variation. Must be 0..1. The caller's
%                  own current color is restored before pkdry returns.
%
% Determinism: same doctrine as pkribbon -- no library-owned seed,
% reproducible under the caller's own `N srand`.
%
% A degenerate single-point subpath (a bare moveto) has no direction
% of travel to offset perpendicular to (walkpath reports a synthetic
% ang=0, not a real one, same case pknib's own pnpressure guards
% against) -- fanning bristles perpendicular to that arbitrary angle
% would draw a straight line of dots, not a dab. Instead each bristle
% scatters isotropically around the point (both x and y independently
% jittered by its own offset magnitude) so a lone point reads as a
% pressed-down dab cluster, not a line.
%
% Multiple subpaths in the source path each get their own independent
% bristle scatter and Markov runs, same generality as pkribbon. Unlike
% pkribbon, pkdry does not special-case a *truly* closed subpath into
% a two-loop ring -- every subpath, closed or not, is walked once as a
% linear sequence of raw stops for dash purposes, and the Markov chain
% does not wrap across a closed subpath's own seam. A deliberate
% simplification, not an oversight: dashes are discrete marks, not a
% continuous offset band, so there's no ring geometry to get right,
% and not wrapping keeps the seam no more special-cased than any other
% sample.
%
% Performance: the dominant cost is the per-sample Markov walk itself
% (O(Bristles * PathLength/Pitch) loop iterations, each with a handful
% of small `pkribbon` calls layered on top), not raster work. The
% `Bristles` * (raw stop count) product is checked against a fixed
% budget (150000) before any drawing starts
% (`pkdry-deposit-count-exceeds-safety-limit`) -- the documented safety
% limit against an accidentally unbounded bristle or deposit count.
% Measured on a ~700-unit curved stroke (the demo's flourish, Width
% 24): the default (18 bristles, default Pitch) renders in ~1.5s; the
% /Bristles safety cap (100) at the same default Pitch takes ~8s.
% Custom, finer /Pitch values raise the sample count and cost
% proportionally -- see NOTES.md's issue #43 entry for the full
% figures.
%
% Known residual gap, not closed here (issue #79): the deposit budget
% above bounds `Bristles * stops`, not the cost of each dash's own
% *nested* pkribbon call, which re-walks that dash's offset polyline at
% /Pitch. That nested cost normally tracks the corresponding centerline
% segment's own length closely -- but at a sharp cusp (a near-180
% degree tangent reversal between two adjacent walkpath stops), the two
% stops' perpendicular offsets (each up to Width/2*Spread from the
% centerline) can end up O(Width) apart even though the centerline
% stops themselves were close together, and re-walking that one segment
% at /Pitch then costs O(Width/Pitch) nested samples the outer guard
% never sees (Codex review, PR #78 round 3; repro in issue #79). Two
% fixes were evaluated and rejected: a blanket worst-case multiplier on
% the deposit budget rejects pkdry's own *default* settings on the
% demo's flourish (~373000 against the 150000 budget); a static
% (Width*Spread)/Pitch ratio cap, independent of the path's actual
% geometry, rejects legitimate smooth large-Width strokes that never
% approach a real cusp. Both point at the same root cause -- walkpath's
% contract is one global, uniform pitch across the whole path, with no
% way to sample finely along a genuine curve while sampling coarsely
% across a single cusp-induced jump -- which needs its own per-segment-
% adaptive design, not a quick patch. Triggering this needs a /Width//
% Pitch ratio in the thousands *plus* a genuine cusp, three orders of
% magnitude past anything in examples/paintkit_dry_demo.ps or realistic
% use.
%
% Scratch prefix pb- (pkdry/pbdashrun) -- deliberately distinct from
% pk-/pn-, see the file header.
/pkdry {
    /pbopts exch def

    /pbwidth pbopts /Width 6 pkgetdef def
    /pbwidth load xcheck { pkdry-width-must-not-be-a-procedure } if
    pbwidth 0 le { pkdry-width-must-be-positive } if

    /pbbristles pbopts /Bristles 18 pkgetdef def
    /pbbristles load xcheck { pkdry-bristles-must-not-be-a-procedure } if
    % Must be a whole number, not just in range: /Bristles feeds the
    % deposit-budget calculation below (Bristles * raw stop count) as
    % well as the `1 1 pbbristles for` loop bound, and a fractional
    % value like 1.5 would silently truncate through `for`'s own
    % semantics (drawing exactly one bristle) rather than erroring on
    % malformed input, undermining both the documented count and the
    % safety-budget math that assumes an integer (Codex review).
    pbbristles 1 lt pbbristles 100 gt or pbbristles truncate pbbristles ne or
        { pkdry-bristles-must-be-1-to-100 } if

    /pbspread pbopts /Spread 0.85 pkgetdef def
    /pbspread load xcheck { pkdry-spread-must-not-be-a-procedure } if
    pbspread 0 lt pbspread 1 gt or { pkdry-spread-must-be-0-to-1 } if

    /pbbristlewidth pbopts /BristleWidth pbwidth 0.12 mul pkgetdef def
    /pbbristlewidth load xcheck
        { pkdry-bristlewidth-must-not-be-a-procedure } if
    pbbristlewidth 0 le { pkdry-bristlewidth-must-be-positive } if

    /pbwidthjitter pbopts /WidthJitter 0.4 pkgetdef def
    /pbwidthjitter load xcheck
        { pkdry-widthjitter-must-not-be-a-procedure } if
    pbwidthjitter 0 lt pbwidthjitter 1 gt or
        { pkdry-widthjitter-must-be-0-to-1 } if

    /pbload pbopts /Load 0.6 pkgetdef def
    /pbload load xcheck { pkdry-load-must-not-be-a-procedure } if
    pbload 0 lt pbload 1 gt or { pkdry-load-must-be-0-to-1 } if

    /pbdropout pbopts /Dropout 0.4 pkgetdef def
    /pbdropout load xcheck { pkdry-dropout-must-not-be-a-procedure } if
    pbdropout 0 lt pbdropout 1 gt or { pkdry-dropout-must-be-0-to-1 } if

    /pbjitter pbopts /Jitter 0 pkgetdef def
    /pbjitter load xcheck { pkdry-jitter-must-not-be-a-procedure } if

    /pbpitch
        pbopts /Pitch
        pbbristlewidth 0.6 mul dup 6 gt { pop 6 } if
        pkgetdef
    def
    /pbpitch load xcheck { pkdry-pitch-must-not-be-a-procedure } if
    pbpitch 0 le { pkdry-pitch-must-be-positive } if

    /pbcolorjitter pbopts /ColorJitter 0.06 pkgetdef def
    /pbcolorjitter load xcheck
        { pkdry-colorjitter-must-not-be-a-procedure } if
    pbcolorjitter 0 lt pbcolorjitter 1 gt or
        { pkdry-colorjitter-must-be-0-to-1 } if

    % Two walkpath passes over the shared centerline, same shape as
    % pkribbon's own pkraw collection (count, then fill) -- reused
    % across every bristle rather than re-walking the source path once
    % per bristle.
    %
    % The documented safety limit -- /Bristles alone (capped at 100
    % above) doesn't bound total deposits, since a long path at a fine
    % /Pitch multiplies out regardless -- is checked *inside* this
    % counting pass, on every stop, not only once after it finishes:
    % checking only afterward would still let a pathologically small
    % /Pitch on a long path run the counting walk itself to completion
    % first (potentially billions of interpreted iterations) before
    % ever rejecting anything, defeating the "before any drawing
    % starts" guarantee (Codex review). 150000 is calibrated against
    % the measured per-iteration cost in the header's Performance note
    % -- comfortably above the /Bristles cap (100) at the default
    % /Pitch on a long (~1500-unit) stroke, while still rejecting a
    % custom /Pitch fine enough to multiply that out by another order
    % of magnitude.
    /pbcount 0 def
    pbpitch {
        pop pop pop pop pop pop
        /pbcount pbcount 1 add def
        pbbristles pbcount mul 150000 gt
            { pkdry-deposit-count-exceeds-safety-limit } if
    } walkpath
    /pbn pbcount def

    /pbraw pbn array def
    /pbci 0 def
    pbpitch {
        6 array astore pbraw pbci 3 -1 roll put
        /pbci pbci 1 add def
    } walkpath

    pbn 0 gt {
        gsave
        /pbbasecolor [ currentrgbcolor ] def
        /pbhalfspread pbwidth 0.5 mul pbspread mul def
        1 1 pbbristles {
            /pbbi exch def
            /pbevenfrac pbbi 0.5 sub pbbristles div def

            /pbsi 0 def
            /pbrunstart 0 def
            {
                pbsi pbn ge { exit } if
                pbraw pbsi get 5 get /pbae exch def
                pbae 1 and 1 eq { /pbrunstart pbsi def } if
                pbae 2 and 2 eq {
                    % Offset/width/color are drawn fresh for each
                    % subpath, not once for the whole bristle: reusing
                    % a single draw across every subpath made the same
                    % bristle index render at an identical position,
                    % width, and color on every subpath, contradicting
                    % pkribbon's own "each subpath becomes an
                    % independent [mark]" contract that pkdry's header
                    % explicitly claims too (Codex review). /pbevenfrac
                    % (the bristle's systematic slot within the
                    % envelope) stays fixed across subpaths -- only the
                    % jitter/width/color *draws* are re-rolled.
                    /pboff
                        pbevenfrac 0.5 sub 2 mul pbhalfspread mul
                        pbhalfspread 0.15 mul pkjit
                        add
                    def
                    /pbw
                        pbbristlewidth pbwidthjitter pbbristlewidth mul pkjit
                        add
                    def
                    pbw pbbristlewidth 0.05 mul lt
                        { /pbw pbbristlewidth 0.05 mul def } if
                    /pbk pbcolorjitter pkjit 1 add def
                    pbbasecolor pbk shade setrgbcolor

                    pboff pbw pbrunstart pbsi pbdashrun
                } if
                /pbsi pbsi 1 add def
            } loop
        } for
        grestore
    } if
} def

% rate -> bool   (true with probability rate, clamped at both ends: a
% rate >= 1 is *always* true and a rate <= 0 is *always* false, not
% left to a bare `frnd rate lt`. artkit's `frnd` (rand's high bits
% divided down) can land on exactly 1.0, which would otherwise make
% even `frnd 1 lt` false and silently break a documented "rate 1 means
% certain" contract -- confirmed: seed 5659 with a single bristle drew
% nothing at /Load 1 before this fix (Codex review). Used for every
% probabilistic decision pbdashrun makes.
/pbroll {
    dup 1 ge
        { pop true }
        { dup 0 le { pop false } { frnd exch lt } ifelse }
    ifelse
} def

% pboff pbw pbrunstart pbrunend pbdashrun -   (one bristle's dashes
% across one subpath's raw-stop range [pbrunstart pbrunend], inclusive
% -- see pkdry's own header for the model)
% A two-state Markov chain over consecutive raw stops decides ink
% contact per sample: each transition's own probability is
% pkdry's pbload/pbdropout scaled by (that stop's own `sp` field /
% pbwidth) -- `sp` is the *actual* arc-length distance from the
% previous stop (walkpath's own doc: not always == Pitch -- 0 for a
% subpath's first stop, and whatever's left over for the guaranteed
% final stop), not the nominal `pbpitch`. Using the nominal pitch
% instead of each stop's real `sp` overstated the transition
% probability for the guaranteed short final stop specifically (Codex
% review) -- the "per one Width of travel" contract has to hold
% per-stop, not just on average, since a stop's actual travel can be
% shorter than a full pitch step. Each contiguous on-run becomes its
% own small polyline, flushed through a nested `pkribbon` call as soon as
% the run ends (an off transition, or the range's last sample) --
% pkribbon's own single-point-subpath handling turns a lone on-sample
% into a dot automatically, exactly the isolated-fleck fallback a real
% skipping bristle should have. Each flush passes `/Pitch pbpitch`
% explicitly rather than letting `pkribbon` default it from `pbdrw`
% (the dash's own, often tiny, width): `pkribbon`'s default Pitch is
% `Width*0.5`, so a very small `/BristleWidth` would otherwise make
% every dash internally re-walk its own short polyline at an
% arbitrarily fine resolution, unaccounted for by pkdry's own
% deposit-budget check above (which only counts the coarser outer
% `pbraw` stops) -- an unbounded amount of extra work a valid, in-range
% `/BristleWidth`/`/Pitch` combination could still trigger (Codex
% review). Reusing the same `pbpitch` already validated and budgeted
% at the outer level keeps a dash's own internal resampling the same
% order of magnitude as the stops it was built from.
/pbdashrun {
    /pbdrend exch def /pbdrstart exch def
    /pbdrw exch def /pbdroff exch def

    % A single-index range (pbdrstart == pbdrend) can only be walkpath's
    % own degenerate single-point case -- any real, even very short,
    % subpath gets at least two raw stops by walkpath's own documented
    % contract. Offset isotropically then, not perpendicular to the
    % synthetic ang=0 (see pkdry's own header).
    /pbdrsingle pbdrstart pbdrend eq def

    % The very first sample's state uses raw (unscaled) pbload, not a
    % travel-scaled rate: "does this bristle start loaded" is a
    % one-time boundary condition, not a rate along the path, so it
    % shouldn't shrink with a finer /Pitch the way a genuine per-step
    % transition probability should. This matters most for a
    % single-sample run (pbdrsingle): with no second sample to ever
    % roll a transition, this is the *only* roll that decides whether
    % that bristle marks at all -- using a scaled rate there made
    % /Load 1 /Dropout 0 still leave most bristles unmarked for an
    % isolated dab, since a Pitch/Width-scaled rate is typically well
    % under 1 even at pbload 1.
    /pbdrstate pbload pbroll def
    /pbdrwasoff true def

    /pbdri pbdrstart def
    {
        pbdri pbdrend gt { exit } if
        pbraw pbdri get
        dup 0 get /pbdrpx exch def
        dup 1 get /pbdrpy exch def
        dup 2 get /pbdrpang exch def
        4 get /pbdrsp exch def

        pbdrsingle
            {
                /pbdrex pbdrpx pbdroff pkjit add def
                /pbdrey pbdrpy pbdroff pkjit add def
            }
            {
                /pbdrex pbdrpx pbdrpang 90 add cos pbdroff mul add def
                /pbdrey pbdrpy pbdrpang 90 add sin pbdroff mul add def
            }
        ifelse

        % Each transition's own probability is scaled by *this stop's*
        % actual sp (arc-length since the previous stop), not the
        % nominal pbpitch -- see this proc's own header.
        pbdri pbdrstart gt {
            pbdrstate
                {
                    pbdropout pbdrsp pbwidth div mul pbroll
                        { /pbdrstate false def } if
                }
                {
                    pbload pbdrsp pbwidth div mul pbroll
                        { /pbdrstate true def } if
                }
            ifelse
        } if

        pbdrstate {
            pbdrwasoff
                { newpath pbdrex pbdrey moveto }
                { pbdrex pbdrey lineto }
            ifelse
        } {
            pbdrwasoff not {
                << /Width pbdrw /Jitter pbjitter /Pitch pbpitch >> pkribbon
            } if
        } ifelse
        /pbdrwasoff pbdrstate not def
        /pbdri pbdri 1 add def
    } loop

    pbdrstate {
        << /Width pbdrw /Jitter pbjitter /Pitch pbpitch >> pkribbon
    } if
} def

% --- spray-paint brush (issue #44) ------------------------------------
% opts pkspray -
% Seeded particle deposition around the sampled centerline: at each
% walkpath stop a small cloud of opaque dots is scattered around that
% point, denser near the centerline and thinning outward, with an
% optional sparse mist escaping past the nozzle edge -- the physical
% model of an aerosol can moved along a gesture. Not built on
% `pkribbon` (discrete dots, not an offset band) but the same
% walkpath-driven shape as every preset here.
%
%   opts pkspray -
%
% Emission is a *cumulative accumulator*, not a fixed count per stop:
% each stop adds `Density * sp / (2*Nozzle)` to a running total (sp is
% the actual arc-length since the previous stop, walkpath's own
% contract), deposits its integer part, and keeps the fraction for the
% next stop. Total particles therefore tracks arc length --
% approximately `Density * (path length / nozzle diameter)` --
% regardless of /Pitch, so the same options read as the same density
% at any sampling pitch (the portability contract pkdry's per-Width
% rate scaling gives its Markov rates). The accumulator resets at each
% subpath's first stop: subpaths are independent marks, same doctrine
% as pkribbon/pkdry, and this makes each subpath's own total track its
% own length exactly rather than borrowing from its neighbors. The
% guaranteed-final-stop duplicate (walkpath's sp==0 coincidence case)
% then naturally deposits nothing extra.
%
%   /Nozzle     spray radius around the centerline (default 8). Must
%               be > 0.
%   /Density    mean particles deposited per one nozzle-*diameter* of
%               travel (default 30). Must be >= 0; 0 renders nothing.
%               Uncapped by itself -- total deposits are bounded by
%               the safety limit below instead, which sees Density
%               directly.
%   /Falloff    0..1 (default 0.5): how quickly particle density
%               thins from the centerline outward. Implemented as a
%               radial draw r = Nozzle * (minimum of m fresh frnd
%               draws), m = 1 + truncate(2*Falloff): min-of-m-uniforms
%               has radial density proportional to (1 - r/Nozzle)^(m-1)
%               -- m=1 spreads particles uniformly *in radius* (areal
%               density still rises mildly toward the center), m=2
%               falls off linearly, m=3 quadratically. Three discrete
%               levels, deliberately not interpolated: the jump at
%               Falloff 0.5 changes the texture visibly but predictably,
%               and keeping m integral keeps the draw count (and the
%               deposit budget below) honest.
%   /Overspray  0..1 (default 0.12): probability each particle escapes
%               past its base radius as finer mist, placed uniformly in
%               the band [R, R*(1+Overspray)] -- R is the particle's
%               own base radius: the nozzle for ordinary particles,
%               the bloomed Nozzle*(1+Burst*0.5) for burst/dab
%               particles -- and drawn at half size. The escape roll is
%               clamped at both ends the
%               way pkdry's own probability rolls are (`pzroll`): frnd
%               can return exactly 1.0, so a bare `frnd rate lt` would
%               never escape at /Overspray 1.
%   /Speck      mean particle diameter (default 1.4). Must be > 0.
%   /Speckle    0..1 (default 0.35): per-particle diameter variation of
%               up to +/-Speckle*Speck, clamped to never go below 10%
%               of Speck (same clamp shape as pkdry's /WidthJitter).
%   /Pitch      walkpath sampling pitch (default Nozzle*0.5, capped at
%               6, same shape as every sibling). Must be > 0.
%   /StartBurst /EndBurst   0..1 (default 0): extra particles pooled at
%               each subpath's first/last stop -- trigger dwell before
%               the hand starts moving / after it stops. Count is
%               truncate(Burst * Density * 2) (a dwell of about two
%               nozzle-diameters' worth of emission), scattered with
%               the same radial profile over radius
%               Nozzle*(1 + Burst*0.5) -- a dwelling nozzle blooms.
%
% A degenerate single-point subpath (walkpath's atend=3 case) gets one
% dab of truncate(Density*2) particles around the point -- without it,
% a zero-length sp would deposit nothing and a pressed-down spray dot
% would vanish entirely (the same failure mode pkdry's dab fallback
% guards against). A single point is also both its subpath's first and
% last stop, so requested /StartBurst//EndBurst clusters land there
% too, on top of the dab.
%
% Stencil/clipping needs no support here: every particle is a plain
% fill inside whatever clip the caller set up (`clip` after a
% `charpath`, an arbitrary path, anything), exactly like every other
% mark in this file.
%
% Determinism: same doctrine as the rest of the file -- no library-
% owned seed, fully reproducible under the caller's own `N srand`.
% Per-particle draw order is pinned and deliberate: overspray roll,
% then radial position (m interior draws, or one band draw when
% oversprayed), then angle, then size jitter. Changing /Falloff changes
% the number of radial draws and therefore reshuffles the whole random
% stream downstream -- two renders differing only in /Falloff are not
% the same pattern with different spread, they're different patterns
% (same caveat pkdry documents for /Jitter). Still fully deterministic
% under any fixed seed either way.
%
% Color is deliberately not a key: all particles fill with whatever
% color the caller already set, same as every other preset here. The
% caller's current path survives (flattened); drawing happens inside
% its own gsave/newpath/grestore, batched into one path and filled
% once for the whole call.
%
% Multiple subpaths each get their own independent scatter, burst(s),
% and accumulator share. Closed subpaths need no ring special-casing:
% their stops are walked once linearly like any other subpath's, and
% the end burst lands where the nozzle lifts.
%
% Safety limit: total expected deposits are estimated during the cheap
% counting pass (accumulated per-stop emissions + 1 per stop + both
% bursts' counts per subpath + the degenerate-dab count for atend==3
% stops) and rejected past 150000
% (`pkspray-deposit-count-exceeds-safety-limit`) before any drawing or
% even the second walkpath pass starts. The per-stop +1 is not a
% truncation-loss allowance -- the fractional carry means deposits
% telescope to the floor of the accumulated emissions, with nothing
% lost per stop -- it is what guarantees the running estimate grows by
% at least 1 every callback, so a pathological fine /Pitch crosses the
% budget within ~150k callbacks instead of walking an unbounded path
% to completion first (the same placement argument pkdry's own check
% makes). The dab term is not
% optional: a page of bare movetos reports sp=0 for every one of them
% (zero accumulated emissions), so without it an uncapped /Density
% could slip arbitrarily many dab particles past the estimate.
%
% Scratch prefix pz- (pkspray/pzpdot/pzburstcluster/pzroll) --
% deliberately distinct from pk-/pn-/pb-, see the file header.
/pzroll {                                          % rate -> bool
% Clamped probability roll: true with probability rate, certain at
% rate >= 1, impossible at rate <= 0. Mirrors pkdry's pbroll -- artkit's
% frnd can land on exactly 1.0, which a bare `frnd rate lt` would turn
% into "never" even for a documented-certain rate of 1 (pkdry's own
% header records the confirmed seed-5659 failure that fix came from).
    dup 1 ge
        { pop true }
        { dup 0 le { pop false } { frnd exch lt } ifelse }
    ifelse
} def

% cx cy baseradius pzpdot -   (append one particle dot to the current
% path; consumes this particle's randomness in the pinned order the
% pkspray header documents. Reads the pzm/pzoverspray/pznozzle/
% pzspeck/pzspeckle globals pkspray sets fresh on every call.)
/pzpdot {
    /pzdbR exch def /pzdy exch def /pzdx exch def
    pzoverspray pzroll {
        % Escaped mist: uniformly in the outer band, half size. The
        % band scales off the particle's own base radius -- the nozzle
        % for ordinary particles, the bloomed burst radius for
        % trigger-dwell/dab particles (Codex review, PR #83).
        frnd pzdbR pzoverspray mul mul pzdbR add
        /pzdr exch def
        /pzdsz pzspeck 0.5 mul def
    } {
        % Interior: minimum of m fresh draws, scaled by the base
        % radius. Init above 1 (frnd's ceiling) so the first draw
        % always wins the min.
        /pzrmin 2 def
        1 1 pzm {
            pop frnd dup pzrmin lt { /pzrmin exch def } { pop } ifelse
        } for
        /pzdr pzdbR pzrmin mul def
        /pzdsz pzspeck def
    } ifelse
    % Angle and size jitter draw regardless of branch, in pinned order.
    /pzda frnd 360 mul def
    /pzdsz pzdsz pzspeckle pzspeck mul pkjit add def
    pzdsz pzspeck 0.1 mul lt { /pzdsz pzspeck 0.1 mul def } if
    /pzdpx pzdx pzdr pzda cos mul add def
    /pzdpz pzdy pzdr pzda sin mul add def
    % Jump to the circle's own start point before arcing: `arc` from a
    % current point would connect the previous particle to this one
    % with a stray line across the whole batched path.
    pzdpx pzdsz 2 div add pzdpz moveto
    pzdpx pzdpz pzdsz 2 div 0 360 arc
} def

% x y baseradius count pzburstcluster -   (count particles pooled
% around one point: trigger-dwell bursts and the degenerate dab)
/pzburstcluster {
    /pzbc exch def /pzbbR exch def /pzby exch def /pzbx exch def
    1 1 pzbc { pop pzbx pzby pzbbR pzpdot } for
} def

% opts pkspray -
/pkspray {
    /pzopts exch def

    % Validation runs unconditionally, before any walking, even for an
    % empty path -- pkribbon validates its whole dict before looking at
    % the path and pknib learned the hard way not to gate that on
    % non-emptiness (Codex review, PR #77). No proc-valued options
    % exist here, so every field gets only the executable-value guard:
    % binding a procedure straight to its name would auto-execute it on
    % every later bare reference (the trap pkgetdef's own header
    % documents), so `/key load xcheck` rejects them outright the way
    % pkribbon rejects an executable /Width (Codex review, round 7).
    /pznozzle pzopts /Nozzle 8 pkgetdef def
    /pznozzle load xcheck { pkspray-nozzle-must-not-be-a-procedure } if
    pznozzle 0 le { pkspray-nozzle-must-be-positive } if

    /pzdensity pzopts /Density 30 pkgetdef def
    /pzdensity load xcheck { pkspray-density-must-not-be-a-procedure } if
    pzdensity 0 lt { pkspray-density-must-be-non-negative } if

    /pzfalloff pzopts /Falloff 0.5 pkgetdef def
    /pzfalloff load xcheck { pkspray-falloff-must-not-be-a-procedure } if
    pzfalloff 0 lt pzfalloff 1 gt or { pkspray-falloff-must-be-0-to-1 } if

    /pzoverspray pzopts /Overspray 0.12 pkgetdef def
    /pzoverspray load xcheck
        { pkspray-overspray-must-not-be-a-procedure } if
    pzoverspray 0 lt pzoverspray 1 gt or
        { pkspray-overspray-must-be-0-to-1 } if

    /pzspeck pzopts /Speck 1.4 pkgetdef def
    /pzspeck load xcheck { pkspray-speck-must-not-be-a-procedure } if
    pzspeck 0 le { pkspray-speck-must-be-positive } if

    /pzspeckle pzopts /Speckle 0.35 pkgetdef def
    /pzspeckle load xcheck { pkspray-speckle-must-not-be-a-procedure } if
    pzspeckle 0 lt pzspeckle 1 gt or
        { pkspray-speckle-must-be-0-to-1 } if

    /pzpitch
        pzopts /Pitch
        pznozzle 0.5 mul dup 6 gt { pop 6 } if
        pkgetdef
    def
    /pzpitch load xcheck { pkspray-pitch-must-not-be-a-procedure } if
    pzpitch 0 le { pkspray-pitch-must-be-positive } if

    /pzstartburst pzopts /StartBurst 0 pkgetdef def
    /pzstartburst load xcheck
        { pkspray-startburst-must-not-be-a-procedure } if
    pzstartburst 0 lt pzstartburst 1 gt or
        { pkspray-startburst-must-be-0-to-1 } if

    /pzendburst pzopts /EndBurst 0 pkgetdef def
    /pzendburst load xcheck { pkspray-endburst-must-not-be-a-procedure } if
    pzendburst 0 lt pzendburst 1 gt or
        { pkspray-endburst-must-be-0-to-1 } if

    % Radial draw count for /Falloff: three discrete levels 1..3, see
    % the header.
    /pzm 1 pzfalloff 2 mul truncate add def

    % Counting pass: number the stops, run the deposit-budget check
    % inside the callback (see the header for why inside), and consume
    % all six operands every call -- walkpath's moveto handler emits a
    % subpath's closing stop *before* consuming the next subpath's x/y,
    % so anything left on the stack corrupts it (artkit's own warning;
    % store atend/sp by name first, then drop the rest).
    /pzcount 0 def /pzest 0 def
    pzpitch {
        /pzae exch def /pzasp exch def pop pop pop pop
        /pzest
            pzest
            pzdensity pzasp mul pznozzle 2 mul div
            add 1 add
        def
        % Burst estimates key off the same bitmask bits the drawing
        % pass does, with no atend==3 carve-out either side: a
        % degenerate single point is both its subpath's first and last
        % stop (3 has both bits set), so both bursts apply there and
        % both terms belong in the estimate (Codex review, PR #83).
        pzae 1 and 1 eq {
            /pzest pzest pzstartburst pzdensity 2 mul mul add def
        } if
        pzae 2 and 2 eq {
            /pzest pzest pzendburst pzdensity 2 mul mul add def
        } if
        % Degenerate single-point dab: sp arrives 0, so the accumulated-
        % emission term never sees it -- the dab's full count goes into
        % the estimate explicitly or an uncapped /Density slips past
        % the budget (review finding on this very implementation plan).
        pzae 3 eq {
            /pzest pzest pzdensity 2 mul add def
        } if
        pzest 150000 gt
            { pkspray-deposit-count-exceeds-safety-limit } if
        /pzcount pzcount 1 add def
    } walkpath

    % Collection pass into a preallocated array -- count, then fill,
    % the only shape that survives walkpath's cross-subpath stack
    % discipline (same as pkribbon's pkraw).
    /pzraw pzcount array def
    /pzci 0 def
    pzpitch {
        6 array astore pzraw pzci 3 -1 roll put
        /pzci pzci 1 add def
    } walkpath

    pzcount 0 gt {
        gsave
        newpath
        /pzacc 0 def
        0 1 pzcount 1 sub {
            /pzi exch def
            pzraw pzi get
            dup 0 get /pzx exch def
            dup 1 get /pzy exch def
            dup 4 get /pzsp exch def
            5 get /pzae exch def
            pzae 3 eq {
                % Degenerate single point: one pressed-down dab. A
                % single point is also both its subpath's first and
                % last stop, so requested endpoint bursts apply here
                % too (Codex review, PR #83).
                pzx pzy pznozzle pzdensity 2 mul truncate
                pzburstcluster
                pzstartburst 0 gt {
                    pzx pzy pznozzle pzstartburst 0.5 mul 1 add mul
                    pzstartburst pzdensity mul 2 mul truncate
                    pzburstcluster
                } if
                pzendburst 0 gt {
                    pzx pzy pznozzle pzendburst 0.5 mul 1 add mul
                    pzendburst pzdensity mul 2 mul truncate
                    pzburstcluster
                } if
            } {
                pzae 1 and 1 eq {
                    % Subpath start: reset this subpath's accumulator
                    % (subpaths are independent marks) and fire the
                    % start burst if any.
                    /pzacc 0 def
                    pzstartburst 0 gt {
                        pzx pzy pznozzle pzstartburst 0.5 mul 1 add mul
                        pzstartburst pzdensity mul 2 mul truncate
                        pzburstcluster
                    } if
                } if
                /pzacc pzacc pzdensity pzsp mul pznozzle 2 mul div add def
                /pzn pzacc truncate def
                /pzacc pzacc pzn sub def
                1 1 pzn { pop pzx pzy pznozzle pzpdot } for
                pzae 2 and 2 eq {
                    pzendburst 0 gt {
                        pzx pzy
                        pznozzle pzendburst 0.5 mul 1 add mul
                        pzendburst pzdensity mul 2 mul truncate
                        pzburstcluster
                    } if
                } if
            } ifelse
        } for
        fill
        grestore
    } if
} def
% --- stylized oil-paint brush (issue #45) -----------------------------
% opts pkoil -
% A stylized oil-paint impasto preset built from layered pressure ribbons
% and bristle traces: a solid base ribbon suggesting a loaded brush, a
% bounded family of thin offset bristle ridges that catch and skip
% slightly (Markov, like pkdry but with high load), and restrained
% highlight/shadow edge lifts that read as paint thickness without any
% 3D height map, fluid mixing, or blending. Pure vector fill, portable
% to pscat and Ghostscript.
%
%   opts pkoil -
%
%   /Width         envelope width the ridges scatter across (default
%                  14). Must be > 0. Same role as pkdry's /Width.
%   /Pitch         walkpath sampling pitch (default Width*0.35, capped
%                  at 4). Must be > 0.
%   /Ridges        bristle ridge count (default 12). Must be whole
%                  1..40 — hard cap so even at default Pitch on a long
%                  stroke the work stays bounded (see Safety below).
%   /RidgeSpread   0..1 fraction of Width ridges scatter across,
%                  centered on the centerline (default 0.75). 0..1.
%   /RidgeWidth    base width of each ridge's own mark (default
%                  Width*0.14). Must be > 0.
%   /WidthJitter   0..1 fraction of RidgeWidth each ridge's width
%                  varies by (default 0.3). 0..1. Clamped to 5% floor.
%   /Load          0..1 resume-contact rate (default 0.85). High load
%                  means ridges stay inked; low load breaks up. 0..1.
%   /Dropout       0..1 lose-contact rate (default 0.18). 0..1. Both
%                  rates are per one Width of travel, scaled by
%                  (sp/Width) per step like pkdry, same portability.
%   /ColorJitter   0..1 per-ridge color variation via `shade` around
%                  the caller's current color (default 0.08). 0..1.
%   /EdgePickup    0..1 darker pickup at the envelope edges (default
%                  0.15). 0..1. Implemented as subtle darkening of the
%                  outermost ridges' shade, not a separate pass.
%   /Highlight     0..1 restrained highlight strength (default 0.12).
%                  Lighter lift on one side of each stroke. 0..1.
%   /Shadow        0..1 restrained shadow strength (default 0.10).
%                  Darker lift on the opposite side. 0..1.
%   /Pressure      {t -> mult} proc (default pkflat). Must be a
%                  procedure (xcheck + type check same as pkribbon).
%   /Jitter        edge roughness forwarded to each dash's pkribbon
%                  /Jitter (default 0). Shares the seeded rand stream.
%
% Determinism: no library seed, fully reproducible under the caller's
% own `N srand`, same doctrine as pkribbon/pkdry/pkspray.
%
% Multiple subpaths each get independent ridge scatter and Markov runs.
% A single-point subpath scatters ridges isotropically around the point
% so a dab reads as a pressed impasto cluster, not a line.
%
% Layering order (documented, deterministic):
%  1. Base load ribbon at current color (full Width)
%  2. Bristle ridges (Ridges thin ribbons, each broken by Markov)
%  3. Highlight ridge on the + side, shadow ridge on the - side
% Later layers are drawn on top of earlier ones.
%
% Safety: Ridges * stopCount is checked against 120000 before any
% drawing, same placement argument as pkdry's 150000 (checked inside
% the counting walk, not after). The per-ridge dash calls reuse
% poPitch for their own nested pkribbon resampling, so the budget
% accounts for outer stops only, not multiplied nested cost — same
% scope as pkdry's own limit and its documented #79 residual gap.
%
% Scratch prefix po- (pkoil/poroll/porad) — deliberately distinct from
% pk-/pn-/pb-/pz-, since pkoil calls pkribbon and would clobber pk*
% names.
%
/poroll {
    dup 1 ge { pop true } { dup 0 le { pop false } { frnd exch lt } ifelse } ifelse
} def

% pooff porw porunstart porunend porad -
/porad {
    /porend exch def /porstart exch def /porw exch def /poroff exch def
    /porsingle porstart porend eq def
    /porstate poLoad poroll def
    /porwasoff true def
    /pori porstart def
    {
        pori porend gt { exit } if
        poraw pori get dup 0 get /porpx exch def dup 1 get /porpy exch def dup 2 get /porpang exch def 4 get /porsp exch def
        porsingle {
            /porex porpx poroff pkjit add def
            /porey porpy poroff pkjit add def
        } {
            /porex porpx porpang 90 add cos poroff mul add def
            /porey porpy porpang 90 add sin poroff mul add def
        } ifelse
        pori porstart gt {
            porstate {
                poDropout porsp poWidth div mul poroll { /porstate false def } if
            } {
                poLoad porsp poWidth div mul poroll { /porstate true def } if
            } ifelse
        } if
        porstate {
            porwasoff { newpath porex porey moveto } { porex porey lineto } ifelse
        } {
            porwasoff not { << /Width porw /Jitter poJitter /Pitch poPitch >> pkribbon } if
        } ifelse
        /porwasoff porstate not def
        /pori pori 1 add def
    } loop
    porstate { << /Width porw /Jitter poJitter /Pitch poPitch >> pkribbon } if
} def

/pkoil {
    /poopts exch def
    /poWidth poopts /Width 14 pkgetdef def
    /poWidth load xcheck { pkoil-width-must-not-be-a-procedure } if
    poWidth 0 le { pkoil-width-must-be-positive } if
    /poPitch poopts /Pitch poWidth 0.35 mul dup 4 gt { pop 4 } if pkgetdef def
    /poPitch load xcheck { pkoil-pitch-must-not-be-a-procedure } if
    poPitch 0 le { pkoil-pitch-must-be-positive } if
    /poRidges poopts /Ridges 12 pkgetdef def
    /poRidges load xcheck { pkoil-ridges-must-not-be-a-procedure } if
    poRidges 1 lt poRidges 40 gt or poRidges truncate poRidges ne or { pkoil-ridges-must-be-1-to-40 } if
    /poRidgeSpread poopts /RidgeSpread 0.75 pkgetdef def
    /poRidgeSpread load xcheck { pkoil-ridgespread-must-not-be-a-procedure } if
    poRidgeSpread 0 lt poRidgeSpread 1 gt or { pkoil-ridgespread-must-be-0-to-1 } if
    /poRidgeWidth poopts /RidgeWidth poWidth 0.14 mul pkgetdef def
    /poRidgeWidth load xcheck { pkoil-ridgewidth-must-not-be-a-procedure } if
    poRidgeWidth 0 le { pkoil-ridgewidth-must-be-positive } if
    /poWidthJitter poopts /WidthJitter 0.3 pkgetdef def
    /poWidthJitter load xcheck { pkoil-widthjitter-must-not-be-a-procedure } if
    poWidthJitter 0 lt poWidthJitter 1 gt or { pkoil-widthjitter-must-be-0-to-1 } if
    /poLoad poopts /Load 0.85 pkgetdef def
    /poLoad load xcheck { pkoil-load-must-not-be-a-procedure } if
    poLoad 0 lt poLoad 1 gt or { pkoil-load-must-be-0-to-1 } if
    /poDropout poopts /Dropout 0.18 pkgetdef def
    /poDropout load xcheck { pkoil-dropout-must-not-be-a-procedure } if
    poDropout 0 lt poDropout 1 gt or { pkoil-dropout-must-be-0-to-1 } if
    /poColorJitter poopts /ColorJitter 0.08 pkgetdef def
    /poColorJitter load xcheck { pkoil-colorjitter-must-not-be-a-procedure } if
    poColorJitter 0 lt poColorJitter 1 gt or { pkoil-colorjitter-must-be-0-to-1 } if
    /poEdgePickup poopts /EdgePickup 0.15 pkgetdef def
    /poEdgePickup load xcheck { pkoil-edgepickup-must-not-be-a-procedure } if
    poEdgePickup 0 lt poEdgePickup 1 gt or { pkoil-edgepickup-must-be-0-to-1 } if
    /poHighlight poopts /Highlight 0.12 pkgetdef def
    /poHighlight load xcheck { pkoil-highlight-must-not-be-a-procedure } if
    poHighlight 0 lt poHighlight 1 gt or { pkoil-highlight-must-be-0-to-1 } if
    /poShadow poopts /Shadow 0.10 pkgetdef def
    /poShadow load xcheck { pkoil-shadow-must-not-be-a-procedure } if
    poShadow 0 lt poShadow 1 gt or { pkoil-shadow-must-be-0-to-1 } if
    /poJitter poopts /Jitter 0 pkgetdef def
    /poJitter load xcheck { pkoil-jitter-must-not-be-a-procedure } if
    /poPressure poopts /Pressure { pkflat } pkgetdef def
    /poPressure load xcheck /poPressure load type dup /arraytype eq exch dup /operatortype eq exch /packedarraytype eq or or and not { pkoil-pressure-must-be-a-procedure } if
    % counting pass with safety budget
    /pocount 0 def
    poPitch { pop pop pop pop pop pop /pocount pocount 1 add def poRidges pocount mul 120000 gt { pkoil-deposit-count-exceeds-safety-limit } if } walkpath
    /pon pocount def
    /poraw pon array def
    /poci 0 def
    poPitch { 6 array astore poraw poci 3 -1 roll put /poci poci 1 add def } walkpath
    pon 0 gt {
        gsave
        /pobasecolor [ currentrgbcolor ] def
        /pohalfspread poWidth 0.5 mul poRidgeSpread mul def
        % 1. base load ribbon at full Width
        pobasecolor aload pop setrgbcolor
        << /Width poWidth /Pitch poPitch /Jitter poJitter >> dup /Pressure /poPressure load put pkribbon
        % 2. bristle ridges
        pobasecolor aload pop setrgbcolor
        1 1 poRidges {
            /pori exch def
            /poevenfrac pori 0.5 sub poRidges div def
            /pooff poevenfrac 0.5 sub 2 mul pohalfspread mul pohalfspread 0.15 mul pkjit add def
            /porw poRidgeWidth poWidthJitter poRidgeWidth mul pkjit add def
            porw poRidgeWidth 0.05 mul lt { /porw poRidgeWidth 0.05 mul def } if
            % edge pickup darkens outermost ridges slightly
            /poedgefrac poevenfrac 0.5 sub abs 2 mul def
            /poshade 1 poevenfrac 0.5 sub abs 0.4 gt { poEdgePickup 0.5 mul neg } { 0 } ifelse poColorJitter pkjit add add def
            pobasecolor poshade 1 add shade setrgbcolor
            % walk subpaths
            /posi 0 def /porunstart 0 def
            {
                posi pon ge { exit } if
                poraw posi get 5 get /poae exch def
                poae 1 and 1 eq { /porunstart posi def } if
                poae 2 and 2 eq { pooff porw porunstart posi porad } if
                /posi posi 1 add def
            } loop
            pobasecolor aload pop setrgbcolor
        } for
        % 3. highlight on + side
        poHighlight 0 gt {
            /pohoff pohalfspread 0.85 mul def
            /pohpow poRidgeWidth 0.6 mul def
            pobasecolor poHighlight 1 add shade setrgbcolor
            /posi 0 def /porunstart 0 def
            {
                posi pon ge { exit } if
                poraw posi get 5 get /poae exch def
                poae 1 and 1 eq { /porunstart posi def } if
                poae 2 and 2 eq { pohoff pohpow porunstart posi porad } if
                /posi posi 1 add def
            } loop
            pobasecolor aload pop setrgbcolor
        } if
        % 4. shadow on - side
        poShadow 0 gt {
            /posoff pohalfspread -0.85 mul def
            /pospow poRidgeWidth 0.6 mul def
            pobasecolor poShadow neg 1 add shade setrgbcolor
            /posi 0 def /porunstart 0 def
            {
                posi pon ge { exit } if
                poraw posi get 5 get /poae exch def
                poae 1 and 1 eq { /porunstart posi def } if
                poae 2 and 2 eq { posoff pospow porunstart posi porad } if
                /posi posi 1 add def
            } loop
            pobasecolor aload pop setrgbcolor
        } if
        grestore
    } if
} def
