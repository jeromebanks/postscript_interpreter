%!PS-Adobe-3.0
%%Title: artkit.ps — a toolkit for generative art in PostScript
%%Creator: pscat — Stage 19, the art toolkit
%%EndComments

% The pscat art toolkit: the procedures a generative piece reaches for
% before it reaches for anything else. Defines into the current dict
% (userdict, normally), draws nothing on load, runs unchanged in
% Ghostscript. Everything is deterministic under `N srand` — the
% reproducible-art doctrine: same seed, same picture.
%
%   (lib/artkit.ps) run          % from the repo root
%
% What's inside (details at each section):
%   random    n chance | j jit | frnd | arr oneof
%   color     [rgb] [rgb] t mix3 | [rgb] k shade | /name pal | /name palpick
%   turtle    x y h thome | d fd | d hop | a tl | a tr | tpush | tpop
%   L-systems (axiom) <<rules>> depth lsys | (str) step angle ldraw
%   brushes   pitch {x y ang ...} alongpath | (str) pathtext
%             cx cy r ang (str) ctext | cx cy r (str) ctextctr
%   shapes    cx cy r n ngon | cx cy r1 r2 n star | x y w h r rrect
%   text      (s) cx y showctr | (s) w fitfont
%   layout    x y w h cols rows {x y w h ...} grid
%   tiling    x0 y0 v1 v2 n1 n2 {x y ...} lattice | cx cy r hex
%             cx cy s up tri | x y w h cols rows {...} hexgrid | trigrid
%             | truchet
%
% Convention: helper names are lowercase and short; internal scratch
% names carry two-letter prefixes (ap-, ct-, ld-, ls-, pt-, tg-, tk-) —
% avoid redefining those inside brush/draw procs.

% --- random ----------------------------------------------------------
% Deterministic (rand), reproducible under srand. Drawn from rand's
% high bits — successive low bits correlate (the marquee.ps finding).

/chance { rand 8192 idiv exch mod } def          % n -> 0..n-1
/jit { dup 2 mul 1 add chance exch sub } def     % j -> -j..j
/frnd { rand 8192 idiv 262143 and 262143 div } def  % -> 0.0..1.0
/oneof { dup length chance get } def             % array -> element

% --- color -----------------------------------------------------------

% [r g b] [r g b] t mix3 -> r g b   (t=0 first color, t=1 second)
/mix3 {
    /tkt exch def /tkb exch def /tka exch def
    tka 0 get tkb 0 get tka 0 get sub tkt mul add
    tka 1 get tkb 1 get tka 1 get sub tkt mul add
    tka 2 get tkb 2 get tka 2 get sub tkt mul add
} def

% [r g b] k shade -> r g b   (k<1 toward black, k>1 toward white)
/shade {
    /tkk exch def aload pop
    tkk 1 le {
        tkk mul exch tkk mul exch 3 -1 roll tkk mul 3 1 roll
    } {
        /tkm tkk 1 sub dup 1 gt { pop 1 } if def
        /tkb exch def /tkg exch def /tkr exch def
        tkr 1 tkr sub tkm mul add
        tkg 1 tkg sub tkm mul add
        tkb 1 tkb sub tkm mul add
    } ifelse
} def

% Eight moods, five colors each. `/dusk pal` -> the array;
% `/dusk palpick` -> one of its colors as r g b.
/Palettes <<
    /dusk      [[0.10 0.09 0.22] [0.23 0.16 0.36] [0.48 0.25 0.42]
                [0.85 0.48 0.34] [0.98 0.80 0.53]]
    /ember     [[0.09 0.05 0.05] [0.42 0.09 0.06] [0.78 0.26 0.06]
                [0.98 0.55 0.12] [1.00 0.85 0.40]]
    /tide      [[0.03 0.14 0.20] [0.05 0.31 0.37] [0.13 0.52 0.53]
                [0.47 0.76 0.68] [0.89 0.94 0.87]]
    /meadow    [[0.18 0.29 0.12] [0.36 0.51 0.19] [0.60 0.71 0.30]
                [0.91 0.80 0.38] [0.83 0.40 0.44]]
    /carnival  [[0.94 0.26 0.33] [1.00 0.72 0.16] [0.24 0.62 0.94]
                [0.36 0.78 0.42] [0.72 0.42 0.90]]
    /parchment [[0.96 0.93 0.85] [0.88 0.82 0.68] [0.62 0.51 0.36]
                [0.38 0.29 0.20] [0.20 0.15 0.12]]
    /nocturne  [[0.02 0.03 0.08] [0.07 0.10 0.22] [0.13 0.55 0.72]
                [0.25 0.90 0.85] [0.95 0.35 0.65]]
    /stone     [[0.24 0.22 0.21] [0.45 0.42 0.39] [0.65 0.61 0.56]
                [0.82 0.78 0.72] [0.93 0.91 0.87]]
>> def

/pal { Palettes exch get } def                   % /name -> array
/palpick { pal oneof aload pop } def             % /name -> r g b

% --- turtle ----------------------------------------------------------
% A pen with a heading. `thome` moveto's the start; `fd` draws into
% the current path (stroke it yourself, with whatever line dress);
% `hop` travels without drawing; `tl`/`tr` turn (NOT lt/rt — those
% are PostScript's comparison operators). Angles in degrees, 0 = +x,
% counterclockwise.
% `tpush`/`tpop` save and restore pose (depth 64) — the bracket ops
% L-systems need.

/TurtleState 16 dict def
TurtleState begin
    /tx 0 def /ty 0 def /th 0 def
    /tstk 64 array def /tsp 0 def
end

/thome {                                         % x y heading -
    TurtleState begin
        /th exch def /ty exch def /tx exch def
        /tsp 0 def
        tx ty moveto
    end
} def

/fd {                                            % dist -  (draws)
    TurtleState begin
        /tkd exch def
        /tx tx th cos tkd mul add def
        /ty ty th sin tkd mul add def
        tx ty lineto
    end
} def

/hop {                                           % dist -  (pen up)
    TurtleState begin
        /tkd exch def
        /tx tx th cos tkd mul add def
        /ty ty th sin tkd mul add def
        tx ty moveto
    end
} def

/tl { TurtleState begin th add /th exch def end } def    % ang -
/tr { TurtleState begin th exch sub /th exch def end } def

/tpush {
    TurtleState begin
        tstk tsp [tx ty th] put
        /tsp tsp 1 add def
    end
} def

/tpop {
    TurtleState begin
        /tsp tsp 1 sub def
        tstk tsp get aload pop
        /th exch def /ty exch def /tx exch def
        tx ty moveto
    end
} def

% --- L-systems -------------------------------------------------------
% (axiom) rules depth lsys -> (expanded)
% Rules map *character codes* to replacement strings; write entries as
%   << (F) 0 get (F[+F]F[-F]F) >>
% Expansion stops early (silently) if the next pass would pass 60000
% characters — PostScript strings cap at 65535.

/lsys {
    /lsdepth exch def /lsrules exch def /lscur exch def
    lsdepth {
        /lsnext 0 def
        lscur {
            /lsc exch def
            lsrules lsc known
                { /lsnext lsnext lsrules lsc get length add def }
                { /lsnext lsnext 1 add def } ifelse
        } forall
        lsnext 60000 gt { exit } if
        /lsbuf lsnext string def
        /lsi 0 def
        lscur {
            /lsc exch def
            lsrules lsc known {
                /lsrep lsrules lsc get def
                lsbuf lsi lsrep putinterval
                /lsi lsi lsrep length add def
            } {
                lsbuf lsi lsc put
                /lsi lsi 1 add def
            } ifelse
        } forall
        /lscur lsbuf def
    } repeat
    lscur
} def

% (string) step angle ldraw -
% Drive the turtle from an L-system string: F draw, f hop, + left,
% - right, [ push, ] pop; everything else ignored (letters other than
% F make fine no-op symbols in rules). Start with `thome` first.
/ldraw {
    /ldang exch def /ldstep exch def
    {
        /ldc exch def
        ldc 70 eq { ldstep fd } {                % F
        ldc 102 eq { ldstep hop } {              % f
        ldc 43 eq { ldang tl } {                 % +
        ldc 45 eq { ldang tr } {                 % -
        ldc 91 eq { tpush } {                    % [
        ldc 93 eq { tpop } if
        } ifelse } ifelse } ifelse } ifelse } ifelse
    } forall
} def

% --- brushes: walk any path ------------------------------------------
% pitch {x y ang -> -} alongpath -
% Flattens the current path, then calls the proc at even arc-length
% stops along it — x y in user space, ang the local direction in
% degrees. This is how a path (charpath text included!) becomes a
% string of bulbs, stitches, leaves, or anything else you can stamp.
% The current path survives (flattened). The proc runs between
% newpath-building stamps, so build your stamp inside gsave/grestore
% or on a fresh path, and don't touch ap- names.

/alintern {                                      % pitchproc stampproc -
    /apstamp exch def /appitch exch def
    flattenpath
    /aprem 0 def /aplx 0 def /aply 0 def /apsx 0 def /apsy 0 def
    { /aply exch def /aplx exch def /apsx aplx def /apsy aply def
      /aprem 0 def }
    { apseg }
    { pop pop pop pop pop pop }
    { apsx apsy apseg }
    pathforall
} def

/apseg {                                         % x y -  (segment end)
    /apy1 exch def /apx1 exch def
    /apdx apx1 aplx sub def /apdy apy1 aply sub def
    /aplen apdx dup mul apdy dup mul add sqrt def
    aplen 0.0001 gt {
        /apang apdy apdx atan def
        /apt aprem def
        {
            apt aplen gt { exit } if
            aplx apdx apt mul aplen div add
            aply apdy apt mul aplen div add
            apang apstamp
            /apt apt appitch add def
        } loop
        /aprem apt aplen sub def
    } if
    /aplx apx1 def /aply apy1 def
} def

/alongpath {                                     % pitch proc -
    exch /aponepitch exch def
    { aponepitch } exch alintern
} def

% (string) pathtext -
% Set a string along the current path in the current font: each glyph
% lands at its own advance, rotated to the path's local direction.
% Best on gentle curves at generous point sizes.
/pathtext {
    /ptstr exch def
    /pti 0 def
    % The pitch to the *next* stop is the advance of the glyph just
    % stamped (the pitch proc only ever runs after a stamp, so pti >= 1).
    { pti ptstr length le pti 0 gt and {
          ptstr pti 1 sub 1 getinterval stringwidth pop
          dup 0.001 lt { pop 0.001 } if
      } { 100000 } ifelse }
    { pti ptstr length lt {
          gsave
              3 1 roll translate rotate
              0 0 moveto
              ptstr pti 1 getinterval show
          grestore
          /pti pti 1 add def
      } { pop pop pop } ifelse }
    alintern
} def

% cx cy r ang (str) ctext -
% Circular text: sets (str) along a circle of radius r centered at
% cx,cy, starting at ang degrees (arc's convention — 0 = east, angle
% grows counterclockwise) and sweeping *clockwise* from there. That
% direction is what keeps glyphs upright and reading left-to-right
% along the top of the circle (the usual seal/coin composition);
% placed along the bottom half, the same text reads upside down —
% a real property of circular type, not a bug here. Built on pathtext,
% so it inherits pathtext's own documented limits (plain-stringwidth
% advance, one tangent per flattened path segment — visible as faceting
% at large radii). The arc is swept a little wider than the string's
% measured width so float/flattening error can't clip the last glyph.
% The caller's current path survives, same contract as alongpath: the
% arc built to walk is scoped inside gsave/grestore (path is part of
% this interpreter's graphics state), not left behind in its place.
/ctext {
    /ctstr exch def /ctang exch def /ctr exch def /cty exch def /ctx exch def
    /ctspan ctstr stringwidth pop ctr div 57.29578 mul def  % 57.29578 = degrees/radian
    gsave
        newpath ctx cty ctr ctang ctang ctspan 1.05 mul sub arcn
        ctstr pathtext
    grestore
} def

% cx cy r (str) ctextctr -
% ctext's common case: center (str) at the top of the circle (90
% degrees) instead of taking an explicit start angle — the one-liner
% for a "ring of type" composition without hand-deriving the start
% angle from the string's width.
/ctextctr {
    /ctcstr exch def /ctcr exch def /ctcy exch def /ctcx exch def
    /ctcspan ctcstr stringwidth pop ctcr div 57.29578 mul def  % degrees/radian
    ctcx ctcy ctcr 90 ctcspan 2 div add ctcstr ctext
} def

% --- shapes (appended to the current path) ---------------------------

/ngon {                                          % cx cy r n -
    /tkn exch def /tkr exch def /tky exch def /tkx exch def
    tkx tkr add tky moveto
    1 1 tkn 1 sub {
        360 mul tkn div /tka exch def
        tkx tka cos tkr mul add tky tka sin tkr mul add lineto
    } for
    closepath
} def

/star {                                          % cx cy r-out r-in n -
    /tkn exch def /tkri exch def /tkro exch def
    /tky exch def /tkx exch def
    tkx tkro add tky moveto
    1 1 tkn 2 mul 1 sub {
        /tki exch def
        /tka tki 180 mul tkn div def
        /tkr tki 2 mod 0 eq { tkro } { tkri } ifelse def
        tkx tka cos tkr mul add tky tka sin tkr mul add lineto
    } for
    closepath
} def

/rrect {                                         % x y w h r -
    /tkr exch def /tkh exch def /tkw exch def /tky exch def /tkx exch def
    tkx tkr add tky moveto
    tkx tkw add tkr sub tky tkr add tkr -90 0 arc
    tkx tkw add tkr sub tky tkh add tkr sub tkr 0 90 arc
    tkx tkr add tky tkh add tkr sub tkr 90 180 arc
    tkx tkr add tky tkr add tkr 180 270 arc
    closepath
} def

% --- text ------------------------------------------------------------

/showctr {                                       % (s) cx y -
    /tky exch def /tkx exch def /tks exch def
    tkx tks stringwidth pop 2 div sub tky moveto
    tks show
} def

/fitfont {                                       % (s) targetwidth -
    /tkw exch def
    stringwidth pop /tkcur exch def
    tkcur 0.001 gt { currentfont tkw tkcur div scalefont setfont } if
} def

% --- layout ----------------------------------------------------------

/grid {                                          % x y w h cols rows proc -
    /tkproc exch def /tkrows exch def /tkcols exch def
    /tkh exch def /tkw exch def /tky exch def /tkx exch def
    /tkcw tkw tkcols div def
    /tkch tkh tkrows div def
    0 1 tkrows 1 sub {
        /tkj exch def
        0 1 tkcols 1 sub {
            /tki exch def
            tkx tki tkcw mul add
            tky tkj tkch mul add
            tkcw tkch tkproc
        } for
    } for
} def

% --- tiling (regular and randomized tessellations) --------------------
% `grid` above already covers the square case. This section adds one
% general lattice-walk primitive, two shape primitives to go with
% ngon/star/rrect, and drivers for the other two regular tilings (hex,
% triangular) plus a randomized-orientation driver for Truchet tiles —
% a single motif, randomly quarter-turned per cell, that reads as a
% flowing maze even though the underlying grid is perfectly regular.
% True aperiodic (Penrose-style) tiling is a deliberate omission: it
% needs matching-rule/substitution machinery well beyond a lattice
% walk, where Truchet already delivers the "looks aperiodic" effect
% generative art actually wants.
%
% Composition gotcha, same one grid/ngon already have (shared tk-
% prefix): a driver here (lattice/hexgrid/trigrid/truchet) re-reads its
% own tg-named position state from the *current dict* on every
% iteration, so a stamp proc that calls hex/tri/another driver
% un-wrapped clobbers that state the instant the first cell runs (their
% `/tgx exch def` etc. land in the same dict). Fix: wrap just the
% inner call in its own small dict — `3 dict begin cx cy r hex end` —
% so its defs shadow there instead. Do NOT wrap a proc's own persistent
% per-cell state (a running counter, an array index) inside that same
% nested dict — `def` always targets the innermost open dict, so an
% incrementing counter defined inside the wrapper is discarded at
% `end` instead of surviving to the next cell; keep counters outside
% the wrapper (or store them in an array via `put`, immune to this).

% x0 y0 v1x v1y v2x v2y n1 n2 {x y -} lattice -
% Walks an n1 x n2 grid of points x0,y0 + i*v1 + j*v2 (i in 0..n1-1, j
% in 0..n2-1), calling proc at each — the primitive hexgrid/trigrid
% are built on. Any v1/v2 pair (square, oblique, brick-bond offsets)
% lets a caller tile a custom motif — Escher-style interlocking shapes
% included — the same way alongpath lets a brush walk any path.
/lattice {
    /tgproc exch def /tgn2 exch def /tgn1 exch def
    /tgv2y exch def /tgv2x exch def /tgv1y exch def /tgv1x exch def
    /tgy0 exch def /tgx0 exch def
    0 1 tgn2 1 sub {
        /tgj exch def
        0 1 tgn1 1 sub {
            /tgi exch def
            tgx0 tgi tgv1x mul add tgj tgv2x mul add
            tgy0 tgi tgv1y mul add tgj tgv2y mul add
            tgproc
        } for
    } for
} def

% cx cy r hex -  (appended to current path; pointy-top, like ngon/star)
/hex {
    /tgr exch def /tgy exch def /tgx exch def
    tgx tgr 90 cos mul add tgy tgr 90 sin mul add moveto
    1 1 5 {
        /tgk exch def
        /tga 90 tgk 60 mul add def
        tgx tga cos tgr mul add tgy tga sin tgr mul add lineto
    } for
    closepath
} def

% cx cy s up tri -  (appended to current path; up true points up)
/tri {
    /tgup exch def /tgs exch def /tgy exch def /tgx exch def
    /tgR tgs 0.577350 mul def                    % centroid-to-vertex
    /tga tgs 0.288675 mul def                    % centroid-to-edge
    tgup {
        tgx tgy tgR add moveto
        tgx tgs 2 div sub tgy tga sub lineto
        tgx tgs 2 div add tgy tga sub lineto
    } {
        tgx tgy tgR sub moveto
        tgx tgs 2 div sub tgy tga add lineto
        tgx tgs 2 div add tgy tga add lineto
    } ifelse
    closepath
} def

% x y w h cols rows {cx cy r -} hexgrid -
% Pointy-top hex lattice, cols hexes spanning w, odd rows staggered by
% half a hex. h is accepted (for signature symmetry with grid) but NOT
% used to size the hexes — a regular hexagon's width and height aren't
% independent, so only w/cols sets the scale; rows is just "how many
% rows of that size to draw," not a second fit constraint. Mismatched
% rows can leave most of the box empty or run well past its bottom
% edge — e.g. 10 cols/1 row on a square box covers only a thin top
% strip. To actually span h, pick rows yourself: r = (w/cols)/sqrt(3),
% then rows ~= h / (r*1.5).
/hexgrid {
    /tgproc exch def /tgrows exch def /tgcols exch def
    /tgh exch def /tgw exch def /tgy exch def /tgx exch def
    /tgr tgw tgcols div 1.732051 div def         % 1.732051 ~= sqrt(3)
    /tgdx tgr 1.732051 mul def
    /tgdy tgr 1.5 mul def
    0 1 tgrows 1 sub {
        /tgj exch def
        /tgoff tgj 2 mod 0 eq { 0 } { tgdx 2 div } ifelse def
        0 1 tgcols 1 sub {
            /tgi exch def
            tgx tgi tgdx mul add tgoff add
            tgy tgj tgdy mul add
            tgr tgproc
        } for
    } for
} def

% x y w h cols rows {cx cy s up -} trigrid -
% Triangular lattice: cols upward triangles span w; each row packs
% cols*2 triangles (alternating up/down) at the derived edge length s.
% Same h caveat as hexgrid just above: an equilateral triangle's row
% height is fixed by s (= w/cols), so h isn't an independent fit
% constraint — pick rows yourself if you need the tiling to actually
% reach the box's bottom edge: rows ~= h / (s*0.866025).
/trigrid {
    /tgproc exch def /tgrows exch def /tgcols exch def
    /tgh exch def /tgw exch def /tgy exch def /tgx exch def
    /tgs tgw tgcols div def
    /tgrh tgs 0.866025 mul def                   % row height = s*sqrt(3)/2
    /tga tgs 0.288675 mul def
    /tgR tgs 0.577350 mul def
    0 1 tgrows 1 sub {
        /tgj exch def
        /tgyb tgy tgj tgrh mul add def
        0 1 tgcols 2 mul 1 sub {
            /tgi exch def
            /tgup tgi 2 mod 0 eq def
            tgx tgi tgs mul 2 div add tgs 4 div add
            tgup { tgyb tga add } { tgyb tgR add } ifelse
            tgs tgup tgproc
        } for
    } for
} def

% x y w h cols rows {w h -} truchet -
% Truchet tiles: walks a square grid like grid, but wraps each call in
% gsave / translate-to-cell-center / rotate-by-a-random-quarter-turn /
% grestore first, so proc only ever draws one motif centered on the
% origin — the random rotation is what turns a single repeated tile
% into the classic flowing Truchet look.
/truchet {
    /tgproc exch def /tgrows exch def /tgcols exch def
    /tgh exch def /tgw exch def /tgy exch def /tgx exch def
    /tgcw tgw tgcols div def
    /tgch tgh tgrows div def
    0 1 tgrows 1 sub {
        /tgj exch def
        0 1 tgcols 1 sub {
            /tgi exch def
            gsave
                tgx tgi tgcw mul add tgcw 2 div add
                tgy tgj tgch mul add tgch 2 div add
                translate
                4 chance 90 mul rotate
                tgcw tgch tgproc
            grestore
        } for
    } for
} def
%%EOF
