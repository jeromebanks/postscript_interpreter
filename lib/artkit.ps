%!PS-Adobe-3.0
%%Title: artkit.ps — a toolkit for generative art in PostScript
%%Creator: pscat — Stage 19, the art toolkit
%%EndComments

% The pscat art toolkit: the procedures a generative piece reaches for
% before it reaches for anything else. Defines into the current dict
% (userdict, normally), draws nothing on load, runs unchanged in
% Ghostscript. Everything is deterministic under `N srand` — the
% reproducible-art doctrine: same seed, same picture.
%
%   (lib/artkit.ps) run          % from the repo root
%
% What's inside (details at each section):
%   random    n chance | j jit | frnd | arr oneof
%   color     [rgb] [rgb] t mix3 | [rgb] k shade | /name pal | /name palpick
%   turtle    x y h thome | d fd | d hop | a tl | a tr | tpush | tpop
%   L-systems (axiom) <<rules>> depth lsys | (str) step angle ldraw
%   brushes   pitch {x y ang ...} alongpath | (str) pathtext
%             cx cy r ang (str) ctext | cx cy r (str) ctextctr
%             pitch {x y ang t sp atend ...} walkpath (centerline sampler)
%   shapes    cx cy r n ngon | cx cy r1 r2 n star | x y w h r rrect
%   text      (s) cx y showctr | (s) w fitfont
%   layout    x y w h cols rows {x y w h ...} grid
%   scatter   x y w h screct | scpath -> region | x y region scin
%             region scarea | region <</Mark {x y s a ...}>> scatter
%   tiling    x0 y0 v1 v2 n1 n2 {x y ...} lattice | cx cy r hex
%             cx cy s up tri | x y w h cols rows {...} hexgrid | trigrid
%             | truchet
%   fractals  len angle turns scale depth edgefractal | [verts] turns
%             scale depth edgepoly | /koch or /quadkoch fgen
%             | x1 y1 x2 y2 x3 y3 depth {...} gasket
%             | x y w h depth {...} carpet
%   hyperbolic (Poincare disk)  cx cy r x y hpoint | hr ang hpolar
%             x1 y1 x2 y2 horthocircle | cx cy r x1 y1 x2 y2 hgeo
%             cx cy r [verts] hpoly | a b r isline x y hreflect
%             cx cy r p q depth {proc} httile
%   noise/flow  noiseinit | x y noise2 | x y eps {proc} curl2 -> dx dy
%             | x y n stepsize {proc} advect
%   gradients [[rgb]...] gradfn -> fndict | x0 y0 x1 y1 [[rgb]...] axialsh
%             | x0 y0 r0 x1 y1 r1 [[rgb]...] radialsh | shdict gradfill
%
% Convention: helper names are lowercase and short; internal scratch
% names carry two-letter prefixes (ad-, ap-, c2-, cp-, ct-, ef-, ep-,
% g2-, gd-, gh-, gk-, ha-, hg-, ho-, hp-, hr-, ht-, hy-, ld-, ls-, n2-,
% nf-, ni-, nl-, pt-, sc-, si-, sq-, tg-, tk-, wk-) — avoid redefining
% those inside brush/draw procs.

% --- random ----------------------------------------------------------
% Deterministic (rand), reproducible under srand. Drawn from rand's
% high bits — successive low bits correlate (the marquee.ps finding).

/chance { rand 8192 idiv exch mod } def          % n -> 0..n-1
/jit { dup 2 mul 1 add chance exch sub } def     % j -> -j..j
/frnd { rand 8192 idiv 262143 and 262143 div } def  % -> 0.0..1.0
/oneof { dup length chance get } def             % array -> element

% --- color -----------------------------------------------------------

% [r g b] [r g b] t mix3 -> r g b   (t=0 first color, t=1 second)
/mix3 {
    /tkt exch def /tkb exch def /tka exch def
    tka 0 get tkb 0 get tka 0 get sub tkt mul add
    tka 1 get tkb 1 get tka 1 get sub tkt mul add
    tka 2 get tkb 2 get tka 2 get sub tkt mul add
} def

% [r g b] k shade -> r g b   (k<1 toward black, k>1 toward white)
/shade {
    /tkk exch def aload pop
    tkk 1 le {
        tkk mul exch tkk mul exch 3 -1 roll tkk mul 3 1 roll
    } {
        /tkm tkk 1 sub dup 1 gt { pop 1 } if def
        /tkb exch def /tkg exch def /tkr exch def
        tkr 1 tkr sub tkm mul add
        tkg 1 tkg sub tkm mul add
        tkb 1 tkb sub tkm mul add
    } ifelse
} def

% Eight moods, five colors each. `/dusk pal` -> the array;
% `/dusk palpick` -> one of its colors as r g b.
/Palettes <<
    /dusk      [[0.10 0.09 0.22] [0.23 0.16 0.36] [0.48 0.25 0.42]
                [0.85 0.48 0.34] [0.98 0.80 0.53]]
    /ember     [[0.09 0.05 0.05] [0.42 0.09 0.06] [0.78 0.26 0.06]
                [0.98 0.55 0.12] [1.00 0.85 0.40]]
    /tide      [[0.03 0.14 0.20] [0.05 0.31 0.37] [0.13 0.52 0.53]
                [0.47 0.76 0.68] [0.89 0.94 0.87]]
    /meadow    [[0.18 0.29 0.12] [0.36 0.51 0.19] [0.60 0.71 0.30]
                [0.91 0.80 0.38] [0.83 0.40 0.44]]
    /carnival  [[0.94 0.26 0.33] [1.00 0.72 0.16] [0.24 0.62 0.94]
                [0.36 0.78 0.42] [0.72 0.42 0.90]]
    /parchment [[0.96 0.93 0.85] [0.88 0.82 0.68] [0.62 0.51 0.36]
                [0.38 0.29 0.20] [0.20 0.15 0.12]]
    /nocturne  [[0.02 0.03 0.08] [0.07 0.10 0.22] [0.13 0.55 0.72]
                [0.25 0.90 0.85] [0.95 0.35 0.65]]
    /stone     [[0.24 0.22 0.21] [0.45 0.42 0.39] [0.65 0.61 0.56]
                [0.82 0.78 0.72] [0.93 0.91 0.87]]
>> def

/pal { Palettes exch get } def                   % /name -> array
/palpick { pal oneof aload pop } def             % /name -> r g b

% --- turtle ----------------------------------------------------------
% A pen with a heading. `thome` moveto's the start; `fd` draws into
% the current path (stroke it yourself, with whatever line dress);
% `hop` travels without drawing; `tl`/`tr` turn (NOT lt/rt — those
% are PostScript's comparison operators). Angles in degrees, 0 = +x,
% counterclockwise.
% `tpush`/`tpop` save and restore pose (depth 64) — the bracket ops
% L-systems need.

/TurtleState 16 dict def
TurtleState begin
    /tx 0 def /ty 0 def /th 0 def
    /tstk 64 array def /tsp 0 def
end

/thome {                                         % x y heading -
    TurtleState begin
        /th exch def /ty exch def /tx exch def
        /tsp 0 def
        tx ty moveto
    end
} def

/fd {                                            % dist -  (draws)
    TurtleState begin
        /tkd exch def
        /tx tx th cos tkd mul add def
        /ty ty th sin tkd mul add def
        tx ty lineto
    end
} def

/hop {                                           % dist -  (pen up)
    TurtleState begin
        /tkd exch def
        /tx tx th cos tkd mul add def
        /ty ty th sin tkd mul add def
        tx ty moveto
    end
} def

/tl { TurtleState begin th add /th exch def end } def    % ang -
/tr { TurtleState begin th exch sub /th exch def end } def

/tpush {
    TurtleState begin
        tstk tsp [tx ty th] put
        /tsp tsp 1 add def
    end
} def

/tpop {
    TurtleState begin
        /tsp tsp 1 sub def
        tstk tsp get aload pop
        /th exch def /ty exch def /tx exch def
        tx ty moveto
    end
} def

% --- L-systems -------------------------------------------------------
% (axiom) rules depth lsys -> (expanded)
% Rules map *character codes* to replacement strings; write entries as
%   << (F) 0 get (F[+F]F[-F]F) >>
% Expansion stops early (silently) if the next pass would pass 60000
% characters — PostScript strings cap at 65535.

/lsys {
    /lsdepth exch def /lsrules exch def /lscur exch def
    lsdepth {
        /lsnext 0 def
        lscur {
            /lsc exch def
            lsrules lsc known
                { /lsnext lsnext lsrules lsc get length add def }
                { /lsnext lsnext 1 add def } ifelse
        } forall
        lsnext 60000 gt { exit } if
        /lsbuf lsnext string def
        /lsi 0 def
        lscur {
            /lsc exch def
            lsrules lsc known {
                /lsrep lsrules lsc get def
                lsbuf lsi lsrep putinterval
                /lsi lsi lsrep length add def
            } {
                lsbuf lsi lsc put
                /lsi lsi 1 add def
            } ifelse
        } forall
        /lscur lsbuf def
    } repeat
    lscur
} def

% (string) step angle ldraw -
% Drive the turtle from an L-system string: F draw, f hop, + left,
% - right, [ push, ] pop; everything else ignored (letters other than
% F make fine no-op symbols in rules). Start with `thome` first.
/ldraw {
    /ldang exch def /ldstep exch def
    {
        /ldc exch def
        ldc 70 eq { ldstep fd } {                % F
        ldc 102 eq { ldstep hop } {              % f
        ldc 43 eq { ldang tl } {                 % +
        ldc 45 eq { ldang tr } {                 % -
        ldc 91 eq { tpush } {                    % [
        ldc 93 eq { tpop } if
        } ifelse } ifelse } ifelse } ifelse } ifelse
    } forall
} def

% --- brushes: walk any path ------------------------------------------
% pitch {x y ang -> -} alongpath -
% Flattens the current path, then calls the proc at even arc-length
% stops along it — x y in user space, ang the local direction in
% degrees. This is how a path (charpath text included!) becomes a
% string of bulbs, stitches, leaves, or anything else you can stamp.
% The current path survives (flattened). The proc runs between
% newpath-building stamps, so build your stamp inside gsave/grestore
% or on a fresh path, and don't touch ap- names.

/alintern {                                      % pitchproc stampproc -
    /apstamp exch def /appitch exch def
    flattenpath
    /aprem 0 def /aplx 0 def /aply 0 def /apsx 0 def /apsy 0 def
    { /aply exch def /aplx exch def /apsx aplx def /apsy aply def
      /aprem 0 def }
    { apseg }
    { pop pop pop pop pop pop }
    { apsx apsy apseg }
    pathforall
} def

/apseg {                                         % x y -  (segment end)
    /apy1 exch def /apx1 exch def
    /apdx apx1 aplx sub def /apdy apy1 aply sub def
    /aplen apdx dup mul apdy dup mul add sqrt def
    aplen 0.0001 gt {
        /apang apdy apdx atan def
        /apt aprem def
        {
            apt aplen gt { exit } if
            aplx apdx apt mul aplen div add
            aply apdy apt mul aplen div add
            apang apstamp
            /apt apt appitch add def
        } loop
        /aprem apt aplen sub def
    } if
    /aplx apx1 def /aply apy1 def
} def

/alongpath {                                     % pitch proc -
    exch /aponepitch exch def
    { aponepitch } exch alintern
} def

% --- brushes: centerline sampler (foundation for painterly brushes) --
% pitch {x y ang t sp atend -> -} walkpath -
% A richer alongpath: walks the current path (flattened, any mix of
% line/curve/closepath segments, any number of subpaths) at even
% arc-length stops, same as alongpath, but hands the proc four extra
% numbers per stop:
%   t      normalized progress through the *current subpath*, 0.0 at
%          its first point to 1.0 at its last — each subpath restarts
%          at 0 (matching alongpath's existing per-subpath reset).
%   sp     arc-length distance from the previously emitted stop (not
%          always == pitch: 0 for the very first stop of a subpath,
%          and whatever's left over for the guaranteed final stop).
%   atend  a bitmask: bit 0 (1) set at the first stop of a subpath,
%          bit 1 (2) set at the last. A degenerate subpath (zero
%          length -- a moveto with no following segment) gets exactly
%          one stop, both bits set (3), t=0, sp=0, ang=0 (no direction
%          is defined for a single point). A short *nonzero* subpath
%          (shorter than one pitch step) still gets two: the start
%          (atend=1) and the guaranteed end (atend=2) -- distinct
%          points, not coalesced, so a brush can still draw a mark
%          between them.
% pitch must be positive; the file's malformed-input convention
% (self-documenting undefined-name guard, see et-spacing-must-be-
% positive in lib/etching.ps) raises an error rather than looping
% forever on pitch <= 0.
% Every subpath's regular pitch-spaced stops (0, pitch, 2*pitch, ...)
% land exactly where alongpath's would. walkpath additionally
% *guarantees* one more call at the literal end of each subpath (the
% true last point pathforall reports, atend bit 1 set) even when that
% doesn't fall on a pitch multiple — painterly brushes need an exact
% endpoint to place tapers/caps, which alongpath's stepping alone
% can't promise. When pitch evenly divides the subpath length, that
% guaranteed call coincides with the last regular stop (sp==0 there);
% callers that care can treat sp==0 on an atend-bit-1 call as "already
% covered." alongpath is left untouched rather than rebuilt on top of
% walkpath: alintern's pitch is itself a *procedure*, called fresh
% before every stamp (pathtext relies on this to vary the pitch by
% each glyph's advance), which walkpath's scalar pitch can't express.
% The current path survives (flattened), same contract as alongpath.
% The proc's `-> -` really means it: it must consume all six operands
% every call, leaving the stack exactly as it found it. walkpath's own
% moveto handler calls a subpath-closing proc invocation (for the
% guaranteed end stop) *before* consuming the x/y pathforall already
% pushed for the *next* subpath's start, so a proc that leaves anything
% behind -- even something that looks harmless, like collecting stops
% by wrapping each call's six values in an array instead of popping
% them -- steals that x/y out from under walkpath's own bookkeeping the
% moment the source path has more than one subpath. Confirmed the hard
% way building paintkit.ps (issue #41); store results by index into a
% preallocated array (count first, then fill -- same shape as this
% file's own wkmeasure/wkseg split) instead.

/wkmeasure {                                     % - [len0 len1 ...]
    % One flattened-path traversal, mark-collecting each subpath's
    % total arc length in path order (handles any number of subpaths
    % without a fixed bound). Read a second time by walkpath itself.
    /wkmx 0 def /wkmy 0 def /wkmsx 0 def /wkmsy 0 def
    /wkmsum 0 def /wkmfirst true def
    [
        { /wkmy exch def /wkmx exch def
          wkmfirst { /wkmfirst false def } { wkmsum } ifelse
          /wkmsx wkmx def /wkmsy wkmy def /wkmsum 0 def }
        { /wkmpy exch def /wkmpx exch def
          /wkmsum wkmsum wkmpx wkmx sub dup mul wkmpy wkmy sub dup mul add sqrt add def
          /wkmx wkmpx def /wkmy wkmpy def }
        { pop pop pop pop pop pop }
        { /wkmsum wkmsum wkmsx wkmx sub dup mul wkmsy wkmy sub dup mul add sqrt add def
          /wkmx wkmsx def /wkmy wkmsy def }
        pathforall
        wkmfirst not { wkmsum } if
    ]
} def

/wkseg {                                         % x1 y1 -  (segment end)
    /wky1 exch def /wkx1 exch def
    /wkdx wkx1 wkx sub def /wkdy wky1 wky sub def
    /wkseglen wkdx dup mul wkdy dup mul add sqrt def
    % Strict positivity, not an absolute epsilon: atan/division only
    % fail at exactly zero (Codex review, round 2 -- an absolute
    % 0.0001 threshold misclassified genuinely short-but-positive
    % segments as degenerate under a large scale, e.g. a path drawn in
    % normalized 0..1 space and scaled up at render time).
    wkseglen 0 gt {
        /wkang wkdy wkdx atan def
        /wkt2 wkrem def
        {
            wkt2 wkseglen gt { exit } if
            /wkpx wkx wkdx wkt2 mul wkseglen div add def
            /wkpy wky wkdy wkt2 mul wkseglen div add def
            /wkc wkcum wkt2 add def
            wkpx wkpy wkang
            wksub 0 gt { wkc wksub div } { 0 } ifelse
            wkc wklast sub
            wkfirst { 1 } { 0 } ifelse
            wkproc
            /wklast wkc def
            /wkfirst false def
            /wkemitted true def
            /wkt2 wkt2 wkpitch add def
        } loop
        /wkrem wkt2 wkseglen sub def
        /wkcum wkcum wkseglen add def
    } if
    /wkx wkx1 def /wky wky1 def
} def

/wkend {                                         % -  (subpath close-out)
    wkemitted {
        wkx wky wkang 1.0 wksub wklast sub 2 wkproc
    } {
        wkx wky 0 0 0 3 wkproc
    } ifelse
} def

/walkpath {                                      % pitch proc -
    /wkproc exch def /wkpitch exch def
    wkpitch 0 le { walkpath-pitch-must-be-positive } if
    flattenpath
    wkmeasure /wklens exch def
    /wksi 0 def /wkx 0 def /wky 0 def /wksx 0 def /wksy 0 def
    /wksub 0 def /wkrem 0 def /wkcum 0 def /wklast 0 def
    /wkfirst true def /wkemitted false def /wkstarted false def
    {                                             % moveto x y
        wkstarted { wkend } if
        /wky exch def /wkx exch def
        /wksx wkx def /wksy wky def
        /wksub wklens wksi get def
        /wkrem 0 def /wkcum 0 def /wklast 0 def
        /wkfirst true def /wkemitted false def
        /wkstarted true def
        /wksi wksi 1 add def
    }
    { wkseg }
    { pop pop pop pop pop pop }
    { wksx wksy wkseg }
    pathforall
    wkstarted { wkend } if
} def

% (string) pathtext -
% Set a string along the current path in the current font: each glyph
% lands at its own advance, rotated to the path's local direction.
% Best on gentle curves at generous point sizes.
/pathtext {
    /ptstr exch def
    /pti 0 def
    % The pitch to the *next* stop is the advance of the glyph just
    % stamped (the pitch proc only ever runs after a stamp, so pti >= 1).
    { pti ptstr length le pti 0 gt and {
          ptstr pti 1 sub 1 getinterval stringwidth pop
          dup 0.001 lt { pop 0.001 } if
      } { 100000 } ifelse }
    { pti ptstr length lt {
          gsave
              3 1 roll translate rotate
              0 0 moveto
              ptstr pti 1 getinterval show
          grestore
          /pti pti 1 add def
      } { pop pop pop } ifelse }
    alintern
} def

% cx cy r ang (str) ctext -
% Circular text: sets (str) along a circle of radius r centered at
% cx,cy, starting at ang degrees (arc's convention — 0 = east, angle
% grows counterclockwise) and sweeping *clockwise* from there. That
% direction is what keeps glyphs upright and reading left-to-right
% along the top of the circle (the usual seal/coin composition);
% placed along the bottom half, the same text reads upside down —
% a real property of circular type, not a bug here. Built on pathtext,
% so it inherits pathtext's own documented limits (plain-stringwidth
% advance, one tangent per flattened path segment — visible as faceting
% at large radii). The arc is swept a little wider than the string's
% measured width so float/flattening error can't clip the last glyph.
% The caller's current path survives, same contract as alongpath: the
% arc built to walk is scoped inside gsave/grestore (path is part of
% this interpreter's graphics state), not left behind in its place.
/ctext {
    /ctstr exch def /ctang exch def /ctr exch def /cty exch def /ctx exch def
    /ctspan ctstr stringwidth pop ctr div 57.29578 mul def  % 57.29578 = degrees/radian
    gsave
        newpath ctx cty ctr ctang ctang ctspan 1.05 mul sub arcn
        ctstr pathtext
    grestore
} def

% cx cy r (str) ctextctr -
% ctext's common case: center (str) at the top of the circle (90
% degrees) instead of taking an explicit start angle — the one-liner
% for a "ring of type" composition without hand-deriving the start
% angle from the string's width.
/ctextctr {
    /ctcstr exch def /ctcr exch def /ctcy exch def /ctcx exch def
    /ctcspan ctcstr stringwidth pop ctcr div 57.29578 mul def  % degrees/radian
    ctcx ctcy ctcr 90 ctcspan 2 div add ctcstr ctext
} def

% --- shapes (appended to the current path) ---------------------------

/ngon {                                          % cx cy r n -
    /tkn exch def /tkr exch def /tky exch def /tkx exch def
    tkx tkr add tky moveto
    1 1 tkn 1 sub {
        360 mul tkn div /tka exch def
        tkx tka cos tkr mul add tky tka sin tkr mul add lineto
    } for
    closepath
} def

/star {                                          % cx cy r-out r-in n -
    /tkn exch def /tkri exch def /tkro exch def
    /tky exch def /tkx exch def
    tkx tkro add tky moveto
    1 1 tkn 2 mul 1 sub {
        /tki exch def
        /tka tki 180 mul tkn div def
        /tkr tki 2 mod 0 eq { tkro } { tkri } ifelse def
        tkx tka cos tkr mul add tky tka sin tkr mul add lineto
    } for
    closepath
} def

/rrect {                                         % x y w h r -
    /tkr exch def /tkh exch def /tkw exch def /tky exch def /tkx exch def
    tkx tkr add tky moveto
    tkx tkw add tkr sub tky tkr add tkr -90 0 arc
    tkx tkw add tkr sub tky tkh add tkr sub tkr 0 90 arc
    tkx tkr add tky tkh add tkr sub tkr 90 180 arc
    tkx tkr add tky tkr add tkr 180 270 arc
    closepath
} def

% --- text ------------------------------------------------------------

/showctr {                                       % (s) cx y -
    /tky exch def /tkx exch def /tks exch def
    tkx tks stringwidth pop 2 div sub tky moveto
    tks show
} def

/fitfont {                                       % (s) targetwidth -
    /tkw exch def
    stringwidth pop /tkcur exch def
    tkcur 0.001 gt { currentfont tkw tkcur div scalefont setfont } if
} def

% --- paragraph / flowing text -----------------------------------------
% Greedy word-wrap (not Knuth-Plass optimal-fit) under the current font,
% built up from one primitive (tflinebreak, peels off one wrapped line)
% through wrapping (tfwrap), alignment (tfdrawline), the general flow
% engine (tfflow), and two conveniences over it (tfblock for a plain
% rectangle, tfcols for columns). No hyphenation -- a word wider than
% its line is placed alone rather than split, the same scope cut
% pathtext documents for its plain-stringwidth advance. Space (32) and
% newline (10) are the only recognized separators -- a tab is ordinary
% word content, not a break point, matching this interpreter's `show`/
% `stringwidth` giving tab no special treatment either (wrapping on a
% character neither of those understands would make the glyph run and
% the wrap logic disagree about where words are, worse than not
% wrapping on it). Runs of spaces around a wrap point are preserved
% verbatim into the line that keeps them rather than collapsed. An
% embedded newline in the source string always forces a line break,
% whether or not the line so far is anywhere near full -- that's what
% lets a caller pass multiple paragraphs (or manual line breaks) as one
% string.
%
% tfflow itself (tf-prefixed) and tfblock/tfcols (tb-/tc-prefixed, plus
% the tf- globals of the tfflow call they make internally) are all
% plain globals, the same no-dict-frame convention as every other
% driver in this file (tk-/tg-/ap- above). That means, like the
% documented hexgrid+hex/grid+ngon gotcha, a boundsproc that calls
% tfflow, tfblock, or tfcols again -- flowing sub-text of its own into
% a nested region -- clobbers the outer call's own tfstr/tfy/tflast/...
% out from under it the instant the inner one runs, and confirmed to
% actually happen (not just a theoretical risk): the outer call's own
% leftover silently comes back empty, discarding real unflowed text,
% not merely drawing the wrong thing. Same fix as hexgrid+hex: wrap
% just the inner call in its own dict (`8 dict begin ... end`) so its
% defs shadow there instead of landing on the outer's own bindings --
% confirmed to restore the outer call's correct leftover once wrapped.
%
% Vertical fit is judged by baseline, not glyph box: tfflow stops once
% the *next* baseline would fall below its ybot bound, so the last
% line drawn has its baseline at or above ybot -- that line's own
% descenders can still fall a little below it, same latitude grid/
% rrect leave a caller to manage with margin.

% (str) width tflinebreak  (line) (rest) lastline -
% Peels the next wrapped line off str: greedily keeps whitespace-
% separated words while they fit within width (stringwidth), stopping
% at the first word that would overflow, or immediately at an embedded
% newline. lastline is true when this line ends the whole string or an
% explicit newline (so a caller doing justify knows not to stretch it),
% false when it's a mid-paragraph wrap (more of the same paragraph
% follows in rest). Internal primitive -- tfwrap and tfflow are the
% public entry points built on it.
/tflinebreak {
    /tlw exch def /tlstr exch def
    /tlen tlstr length def
    /tli 0 def /tlbreak -1 def /tlnl false def /tlatend false def
    {
        tli tlen ge {
            % End of string: only take the whole remainder as one line
            % if it actually fits, or there was no earlier break to
            % fall back on (a single word wider than the line) --
            % otherwise keep the last break found so the final word(s)
            % still wrap instead of overflowing.
            tlstr 0 tlen getinterval stringwidth pop tlw le tlbreak 0 lt or {
                /tlbreak tlen def /tlatend true def
            } if
            exit
        } if
        /tlc tlstr tli get def
        tlc 32 eq tlc 10 eq or {
            tlstr 0 tli getinterval stringwidth pop tlw le {
                /tlbreak tli def /tlnl tlc 10 eq def
                tlnl { exit } if
            } {
                tlbreak 0 ge { exit } if
                /tlbreak tli def /tlnl tlc 10 eq def
                exit
            } ifelse
        } if
        /tli tli 1 add def
    } loop
    /tlline tlstr 0 tlbreak getinterval def
    tlatend
        { /tlrest () def }
        { /tlrest tlstr tlbreak 1 add tlen tlbreak 1 add sub getinterval def }
    ifelse
    tlline tlrest tlatend tlnl or
} def

% (str) tfwordgaps  n -
% Counts space-separated gaps in str (word count minus one), used to
% divide justify's stretch. Internal.
/tfwordgaps {
    /twgrem exch def /twgn 0 def
    {
        twgrem ( ) search
            { pop pop /twgrem exch def /twgn twgn 1 add def }
            { pop exit }
        ifelse
    } loop
    twgn
} def

% (str) width tfwrap  ARRAY -
% Wraps str into an array of lines, none wider than width under the
% current font. A standalone convenience for measuring/line-counting
% without drawing; tfflow re-wraps per line itself so a region's width
% can vary line to line, rather than calling this. An empty str yields
% an empty array (zero lines), the same "nothing to do" reading tfflow
% gives it -- not a one-element array holding a blank line.
% Bound on the preallocated scratch array: tflinebreak either finishes
% the string outright (one call) or peels off a break that strictly
% shortens what's left by at least one character (tlbreak+1 >= 1
% whenever it doesn't finish the string -- see tflinebreak), so at most
% `length` calls run before rest is empty; `length + 1` slots is always
% enough and this is checked directly by a regression test below.
/tfwrap {
    /twwidth exch def /twstr exch def
    twstr length 0 eq {
        []
    } {
        /twlines twstr length 1 add array def
        /twn 0 def
        {
            twstr twwidth tflinebreak
            /twlast exch def /twrest exch def /twline exch def
            twlines twn twline put /twn twn 1 add def
            /twstr twrest def
            twrest length 0 eq { exit } if
        } loop
        twlines 0 twn getinterval
    } ifelse
} def

% x0 x1 y just lastline (line) tfdrawline -
% Draws one already-wrapped line at baseline y within [x0,x1] under
% the current font, per just: /left /right /center /justify (any other
% name falls back to /left, this file's usual latitude-not-error
% posture). /justify stretches inter-word gaps to fill [x0,x1] exactly;
% it's skipped -- falling back to /left -- whenever lastline is true or
% the line has no internal gap (a single word), the standard
% typographic reason a paragraph's last line and lone words don't get
% stretched into ugly gaps.
% Trailing spaces are trimmed off the line first (a run of two or more
% source spaces at a wrap point leaves one on the end of the emitted
% line -- tflinebreak's own documented "whitespace preserved verbatim"
% behavior, mid-line only; see its header). Untrimmed, that invisible
% trailing space both widens tdw (nudging /right and /center off by its
% width) and, worse, counts as its own /justify gap with nothing after
% it to stretch toward -- stealing stretch from the real gaps so the
% last visible word falls short of x1. Caught by cross-model review.
/tfdrawline {
    /tdline exch def /tdlast exch def /tdjust exch def
    /tdy exch def /tdx1 exch def /tdx0 exch def
    {
        tdline length 0 eq { exit } if
        tdline tdline length 1 sub get 32 ne { exit } if
        /tdline tdline 0 tdline length 1 sub getinterval def
    } loop
    /tdw tdline stringwidth pop def
    tdjust /right eq {
        tdx1 tdw sub tdy moveto tdline show
    } {
    tdjust /center eq {
        tdx0 tdx1 tdx0 sub tdw sub 2 div add tdy moveto tdline show
    } {
    tdjust /justify eq tdlast not and {
        tdline tfwordgaps /tdgaps exch def
        tdgaps 0 gt {
            % tdw already includes the line's own natural space widths,
            % so the per-gap advance is that natural space plus an even
            % share of whatever's left to reach tdx1 -- not tdextra
            % alone (that would drop the natural space and mash every
            % word together, the real bug an example piece caught).
            /tdspace ( ) stringwidth pop def
            /tdextra tdx1 tdx0 sub tdw sub tdgaps div def
            /tdx tdx0 def /tdrem tdline def
            {
                tdrem ( ) search {
                    /tdpre exch def /tdmatch exch def /tdpost exch def
                    tdx tdy moveto tdpre show
                    /tdx tdx tdpre stringwidth pop add tdspace add tdextra add def
                    /tdrem tdpost def
                } {
                    % search's "not found" return is `string false` -- the
                    % unchanged tdrem it was searching, still sitting under
                    % the bool ifelse just consumed. tdrem (the global) is
                    % the same text, so this branch draws from that instead
                    % of the copy search handed back, and pops the copy
                    % rather than leaving it stranded on the operand stack.
                    pop
                    tdx tdy moveto tdrem show
                    exit
                } ifelse
            } loop
        } {
            tdx0 tdy moveto tdline show
        } ifelse
    } {
        tdx0 tdy moveto tdline show
    } ifelse } ifelse } ifelse
} def

% boundsproc y0 ybot leading just (str) tfflow  (leftover) -
% The general paragraph-flow engine: boundsproc is {y -> x0 x1}, called
% once per line before it's wrapped, so a region's available width can
% vary with height -- a trapezoid, a shape hugging a curve, anything,
% not just a fixed rectangle. Starting at baseline y0 and stepping down
% by leading each line, wraps and draws against boundsproc's width
% until str is exhausted or the next baseline would pass ybot, then
% returns whatever text didn't fit as leftover ("" if all of it flowed)
% -- what makes columns and multi-region flows composable: feed one
% call's leftover into the next region's tfflow/tfblock/tfcols call.
/tfflow {
    /tfstr exch def /tfjust exch def /tfleading exch def
    /tfybot exch def /tfy exch def /tfbp exch def
    {
        tfstr length 0 eq { exit } if
        tfy tfybot lt { exit } if
        tfy tfbp
        /tfx1 exch def /tfx0 exch def
        tfstr tfx1 tfx0 sub tflinebreak
        /tflast exch def /tfrest exch def /tfline exch def
        tfx0 tfx1 tfy tfjust tflast tfline tfdrawline
        /tfy tfy tfleading sub def
        /tfstr tfrest def
    } loop
    tfstr
} def

% x y w h leading just (str) tfblock  (leftover) -
% tfflow's common case: flow str into the rectangle x,y,w,h (bottom-
% left + size, the same convention as rrect/grid), top-down starting
% one leading below the box's top edge. Returns leftover text that
% didn't fit vertically, same contract as tfflow.
/tfblock {
    /tbstr exch def /tbjust exch def /tblead exch def
    /tbh exch def /tbw exch def /tby exch def /tbx exch def
    { pop tbx tbx tbw add }
    tby tbh add tblead sub
    tby tblead tbjust tbstr
    tfflow
} def

% x0 y0 colw gap h ncols leading just (str) tfcols  (leftover) -
% Flows str across ncols equal-width columns (colw wide, gap between
% them, all h tall, left edges at x0 + i*(colw+gap)), feeding each
% column's tfblock leftover into the next and stopping early once the
% text runs out. Returns whatever didn't fit after the last column,
% same contract as tfflow.
/tfcols {
    /tcstr exch def /tcjust exch def /tclead exch def
    /tcn exch def /tch exch def /tcgap exch def
    /tcw exch def /tcy exch def /tcx exch def
    0 1 tcn 1 sub {
        /tci exch def
        tcstr length 0 eq { exit } if
        tcx tci tcw tcgap add mul add
        tcy tcw tch tclead tcjust tcstr tfblock
        /tcstr exch def
    } for
    tcstr
} def

% --- layout ----------------------------------------------------------

/grid {                                          % x y w h cols rows proc -
    /tkproc exch def /tkrows exch def /tkcols exch def
    /tkh exch def /tkw exch def /tky exch def /tkx exch def
    /tkcw tkw tkcols div def
    /tkch tkh tkrows div def
    0 1 tkrows 1 sub {
        /tkj exch def
        0 1 tkcols 1 sub {
            /tki exch def
            tkx tki tkcw mul add
            tky tkj tkch mul add
            tkcw tkch tkproc
        } for
    } for
} def

% --- scatter (deterministic mark distribution) ------------------------
% The area-shaped counterpart to alongpath/walkpath's path-shaped walk:
% place a caller-supplied mark many times across a *region* instead of
% stringing it along a curve. Foliage, stars, debris, collage
% fragments, stipple, print specks — anything that wants marks
% distributed over an area. This is placement infrastructure, not a
% particle simulator: scatter decides *where* (and at what scale and
% angle) a mark goes, the caller's own procedure decides what the mark
% looks like.
%
%   x y w h screct       -> region   a rectangle
%   scpath               -> region   the current path, as `fill` sees it
%   x y region scin      -> bool     is this point inside the region?
%   region scarea        -> num      the region's area
%   region opts scatter  -           place marks
%
% A region is an ordinary dict — /Kind and /BBox, plus /Area for a
% rectangle and /Edges and /Rule for a captured path — built once and
% reused across as many scatter calls as you like. A rectangle's area
% is exact; a path region's is measured on demand by `scarea` (see its
% own header), so flipping /Rule changes the answer the way it should. `scpath` records *user-space* coordinates
% at capture time, so a region captured under one CTM is wrong under
% another: capture and scatter under the same transform (or capture
% inside the gsave that sets it).
%
% A curved region carries one more CTM dependence, inherited from
% `flattenpath`: its tolerance is a fixed fraction of a *device*
% pixel, so the same curve captured under a larger scale becomes more
% chords. That shifts /Area slightly and moves the region's boundary
% by sub-chord amounts — and inside a scatter, a boundary that moves
% changes which candidates are rejected, which shifts the whole
% random-draw sequence after it. So the same seeded scatter over a
% *curved* region is reproducible at a given scale, not across scales
% (measured on one ridge: 304 chords and an area of 119192.04 at 1x,
% 372 chords at 2x). A region with only straight edges has no such
% dependence — its capture is exact and identical at every scale, in
% this interpreter and in Ghostscript both.
%
% `scpath` flattens the current path the way alongpath does — the path
% survives, flattened — and closes every subpath implicitly, exactly
% as `fill` would. `scin` then answers with the nonzero winding rule,
% matching `fill`; `region /Rule /evenodd put` switches it to the
% even-odd rule (matching `eofill`) for that region from then on.
% `clippath scpath` is the idiom for scattering inside the current
% *clip* region rather than inside a drawn shape -- with one caveat
% that belongs to `clippath` rather than to this section: this
% interpreter's `clippath` returns the most recently established clip
% path, not the intersection of every clip in effect (Ghostscript
% returns the true intersection; confirmed by measuring both). So the
% idiom captures the whole clip when one clip is in force, which is
% the ordinary case, and only the newest of several when they have
% been nested -- candidates would then be accepted inside the newest
% but outside an older one, and painted invisibly. Clip once for the
% region you mean to scatter into, or capture the shape itself with
% `scpath` and skip `clippath` altogether.
%
% scatter's options, all optional except /Mark:
%   /Mark {x y scale angle -> -}  the mark. A procedure (or an
%           executable name for one). Called once per placed
%           mark with its position, a scale multiplier drawn from
%           /Scale, and a rotation in degrees drawn from /Rotate. It
%           MUST consume all four operands (a proc that ignores them
%           leaks four numbers per mark onto the operand stack —
%           `--lint` reports exactly that) and must not touch sc-,
%           sq-, or si- names.
%   /Count  how many marks to place (default 120). Mutually exclusive
%           with /Density — passing both is an error rather than a
%           silent winner.
%   /Density marks per square unit, resolved against the region's own
%           /Area (a 300x400 region at 0.001 wants 120 marks). The
%           region must have positive area.
%   /MinSpacing  minimum center-to-center distance between placed
%           marks (default 0, off). Enforced exactly, by rejection.
%   /Weight {x y -> w}  acceptance weight, 0..1 — the probability a
%           candidate at (x,y) survives (clamped: >=1 always, <=0
%           never). This is how a scatter gets non-uniform: pass
%           `{ ... noise2 ... }` for a coherent density field, a
%           distance falloff for a cluster, anything you can compute.
%           Called only for candidates that already passed the region
%           and spacing tests, and must consume its two operands.
%   /Scale [lo hi]   scale multiplier range (default [1 1])
%   /Rotate [lo hi]  rotation range in degrees (default [0 0])
%   /Seed n  seeds the placement with `n srand` and restores the
%           caller's random stream afterwards (via rrand), so a seeded
%           scatter reproduces regardless of what drew before it and
%           doesn't perturb what draws after it. Omit it to draw from
%           the ambient stream — still deterministic under the piece's
%           own `N srand`, just not independent of it. The restore is
%           skipped if the call *errors* out — a /Mark that raises,
%           say, caught by the caller's own `stopped`. PostScript has
%           no finally, and buying the restore back would mean
%           swallowing the error and re-raising it as a bare `stop`,
%           losing the self-documenting name that makes these errors
%           worth reading (the same shape of leak `gsave` has when an
%           error skips its `grestore`). A caller recovering from a
%           caught error who needs the stream back can bracket their
%           own `stopped` the same way: `rrand` before, `srand` after.
%   /Tries n  candidate attempts per requested mark, 1..100 (default
%           20). A mark whose attempts are all rejected is skipped and
%           the next one is attempted — scatter places *at most*
%           /Count marks, never more.
%   /Budget n  hard deposit budget, 0..200000 (default 20000). A
%           resolved count above it is rejected
%           (`scatter-count-exceeds-safety-limit`) before anything is
%           drawn, so a pathological /Density can't run away. Total
%           work is bounded regardless: at most Count*Tries candidates.
%
% The deposit budget bounds *marks*, which is not the same as bounding
% *work*: testing a candidate against a path region costs one pass
% over its edges, so a legal `/Count 200000 /Tries 100` over a
% 20000-edge region would be twenty million candidates at twenty
% thousand edge tests each, and no amount of deposit budget stops it
% (Codex review, round 3). Containment work is therefore metered as it
% is spent, against `scworkmax`, and a call that would grind raises
% `scatter-containment-work-exceeds-safety-limit` partway rather than
% running for an hour. Rectangle regions cost a bounds check rather
% than an edge scan, so they are effectively never charged.
%
% After the call, `scplaced` reports how many marks actually landed
% — deliberately read back rather than returned, since a count left on
% the operand stack is a leak waiting for a caller who forgets to pop
% it. During /Mark, `scplaced` is the 1-based index of the mark being
% drawn. It reads the count out of `ScatterState` rather than being a
% plain variable, because a plain `def` writes into whatever dict is
% current: a caller who wraps the call in the ordinary `N dict begin
% ... end` — which is exactly what a `grid` or `truchet` stamp does —
% would get the count written into their scratch dict and thrown away
% with it (Codex review, round 3). `ScatterState` follows
% `TurtleState`'s precedent above. The count a scatter publishes there
% is its own even when scatters nest: the running total is a local,
% republished on each placement, so a nested call can't reset the
% enclosing one's count or renumber its marks (Codex review, round 4).
% The one gap, and it is the caller's own timing: reading `scplaced`
% inside a /Mark *after* that mark has itself run a nested scatter
% reports the nested call's total, until the enclosing call places its
% next mark.
%
% Reproducibility: same seed, same options, same picture — the random
% draws happen in a pinned order, x then y per candidate, then the
% /Weight roll (only when /Weight is given, and only for candidates
% that passed the geometry tests), then on acceptance the scale and
% the angle (each drawn only when its range is non-degenerate). That
% pinning is within *this* interpreter: Ghostscript's `rand` is a
% different generator, so a scattered piece renders as a different
% (equally valid, equally reproducible) arrangement there. gs
% compatibility here means the file runs, not that it matches
% pixel for pixel — the same standard the rest of this file's
% rand-driven procedures hold to. Counts, areas, and rejections do
% agree exactly — with one exception, and it isn't `rand`'s doing:
% gs flattens curves to its own chord count (232 where this
% interpreter produces 304, for the same ridge at the same scale),
% so a *curved* region's /Area, and therefore any count /Density
% resolves from it, differ a little between the two. A straight-edged
% region agrees exactly.
%
% /MinSpacing is enforced through a sparse hash grid (one dict entry
% per placed mark, cell size MinSpacing/1.5 so a cell's diagonal stays
% under MinSpacing and can hold at most one mark), so each candidate
% checks a fixed 5x5 cell neighborhood instead of every mark placed so
% far. Memory tracks the number of marks, not the region's size.
%
% Scratch prefixes: sc- (scatter and its helpers), sq- (screct/scpath/
% scarea capture), si- (scin's containment test) — three distinct
% prefixes on purpose, since a /Weight proc calling `scin` runs in the
% middle of scatter's own loop. A /Mark or /Weight proc that calls
% `scatter` again is the gasket/carpet nesting case: the library stays
% unwrapped, so wrap the nested call in your own dict if you need it.

/scisnum { type dup /integertype eq exch /realtype eq or } def % v -> bool

% opts key default scgetdef -> value
% artkit's own copy of the wrap-the-default-in-an-array trick (see
% pagekit's pggetdef / paintkit's pkgetdef for the same reasoning): a
% name bound directly to a procedure auto-executes on bare reference,
% so the default is read back out of a 1-element array instead.
/scgetdef {                                      % dict key default -> value
    /scgdd exch 1 array astore def
    /scgdk exch def
    /scgdt exch def
    scgdt scgdk known { scgdt scgdk get } { scgdd 0 get } ifelse
} def

% rate scodds -> bool
% Clamped probability roll: certain at rate >= 1, impossible at
% rate <= 0. frnd can land on exactly 1.0, which a bare `frnd rate lt`
% would turn into "never" even for a documented-certain rate of 1
% (the seed-5659 finding paintkit's pkdry records).
/scodds {
    dup 1 ge
        { pop true }
        { dup 0 le { pop false } { frnd exch lt } ifelse }
    ifelse
} def

/sccallable {                                    % v -> bool
% Executable *and* of a type that runs its target when invoked. A bare
% `xcheck` isn't enough: `3 cvx` is executable, and calling it merely
% pushes 3 -- so an accepted `/Mark 3 cvx` would report placements
% while leaking five operands per mark instead of drawing one (Codex
% review, round 6). A procedure or an executable name, nothing else.
    dup xcheck exch type
    dup /arraytype eq exch /nametype eq or
    and
} def

/scokrange {                                     % v -> bool  ([lo hi]?)
    dup type /arraytype ne
        { pop false }
        { dup length 2 ne
            { pop false }
            { dup 0 get scisnum exch 1 get scisnum and }
          ifelse }
    ifelse
} def

% --- regions ---------------------------------------------------------

/screct {                                        % x y w h -> region
    /sqrh exch def /sqrw exch def /sqry exch def /sqrx exch def
    sqrx scisnum sqry scisnum and
    sqrw scisnum and sqrh scisnum and not { screct-needs-four-numbers } if
    sqrw 0 le sqrh 0 le or { screct-width-and-height-must-be-positive } if
    << /Kind /rect
       /BBox [ sqrx sqry sqrx sqrw add sqry sqrh add ]
       /Area sqrw sqrh mul >>
} def

/sqbounds {                                      % x y -
% Grow the *current subpath's* box. It reaches the region's own bbox
% only if that subpath turns out to be able to enclose something --
% see sqpmerge.
    /sqby exch def /sqbx exch def
    sqpfirst {
        /sqpx0 sqbx def /sqpx1 sqbx def
        /sqpy0 sqby def /sqpy1 sqby def
        /sqpfirst false def
    } {
        sqbx sqpx0 lt { /sqpx0 sqbx def } if
        sqbx sqpx1 gt { /sqpx1 sqbx def } if
        sqby sqpy0 lt { /sqpy0 sqby def } if
        sqby sqpy1 gt { /sqpy1 sqby def } if
    } ifelse
} def

/sqpmerge {                                      % -
% Fold the finished subpath's box into the region's, but only if that
% subpath could contribute to a fill at all. Two exclusions, both
% provable rather than heuristic: fewer than three edges cannot
% enclose anything (two edges is always an out-and-back retrace, since
% the second is the implicit close returning along the first), and a
% box with no width or no height encloses zero area whatever the rule
% says. Without them a remote `1e6 1e6 moveto 1e6+100 1e6 lineto`
% appended to a 100x100 square -- which `fill` paints nothing for --
% would stretch the region across a million units and leave a seeded
% 100-mark scatter placing none of them (Codex review, rounds 5-6).
    sqpfirst not
    sqpn 3 ge and
    sqpx1 sqpx0 gt and
    sqpy1 sqpy0 gt and {
        sqfirst {
            /sqbx0 sqpx0 def /sqbx1 sqpx1 def
            /sqby0 sqpy0 def /sqby1 sqpy1 def
            /sqfirst false def
        } {
            sqpx0 sqbx0 lt { /sqbx0 sqpx0 def } if
            sqpx1 sqbx1 gt { /sqbx1 sqpx1 def } if
            sqpy0 sqby0 lt { /sqby0 sqpy0 def } if
            sqpy1 sqby1 gt { /sqby1 sqpy1 def } if
        } ifelse
    } if
} def

/sqemit {                                        % x0 y0 x1 y1 -
% Append one edge to the growable flat edge buffer. PostScript arrays
% are fixed-size, so growth is a doubling copy; the 20000-edge ceiling
% (80000 numbers) bounds both the buffer and scin's per-point cost,
% which is linear in the edge count.
    /sqe3 exch def /sqe2 exch def /sqe1 exch def /sqe0 exch def
    sqn 4 add 80000 gt { scpath-too-many-edges } if
    sqn 4 add sqcap gt {
        /sqcap sqcap 2 mul def
        /sqnew sqcap array def
        sqnew 0 sqbuf putinterval
        /sqbuf sqnew def
    } if
    sqbuf sqn sqe0 put
    sqbuf sqn 1 add sqe1 put
    sqbuf sqn 2 add sqe2 put
    sqbuf sqn 3 add sqe3 put
    /sqn sqn 4 add def
} def

/sqline {                                        % x y -   (segment end)
    /sqly exch def /sqlx exch def
    % A lineto after a closepath legitimately starts a fresh subpath
    % from the closepath's own point (PLRM), so reopen rather than
    % leaving it unclosable at the end.
    sqhave not {
        /sqsx sqcx def /sqsy sqcy def /sqhave true def
    } if
    sqcx sqcy sqlx sqly sqemit
    % Bounds come from *edges*, never from a bare moveto: `fill`
    % ignores a subpath that never draws, so a stray `1e6 1e6 moveto`
    % must not stretch the region's bbox around a candidate area a
    % million times too big and leave scatter placing nothing (Codex
    % review, round 5). Both endpoints are offered here rather than
    % only the new one, since the first point of a subpath is a real
    % vertex exactly once an edge leaves it.
    sqcx sqcy sqbounds
    sqlx sqly sqbounds
    /sqpn sqpn 1 add def
    /sqcx sqlx def /sqcy sqly def
} def

/sqclose {                                       % -   (closepath)
% Emitting the closing edge also *ends* the subpath, so `sqhave` goes
% false: `pathforall` already calls this for an explicit `closepath`,
% and scpath calls it once more at the end for a subpath left open.
% Without the flag the second call would append a zero-length
% duplicate edge for every explicitly closed subpath -- geometrically
% inert (it can't cross a scanline) but it inflates /Edges and would
% trip the edge ceiling one edge early (Codex review, PR #119).
    sqhave {
        % A closing edge of zero length is no edge at all: it can't
        % cross a scanline, and emitting one would both inflate /Edges
        % and (since bounds come from edges) stretch the bbox around a
        % subpath `fill` ignores entirely -- a bare `moveto` with
        % nothing after it being exactly that case.
        sqcx sqsx ne sqcy sqsy ne or { sqsx sqsy sqline } if
        sqpmerge
        /sqhave false def
    } if
} def

/sqmove {                                        % x y -   (subpath start)
    /sqmy exch def /sqmx exch def
    sqclose                                      % close the previous one
    /sqpn 0 def
    /sqpfirst true def
    /sqcx sqmx def /sqcy sqmy def
    /sqsx sqmx def /sqsy sqmy def
    /sqhave true def
} def

/scpath {                                        % -> region
% The current path as a region. Flattens it (the path survives,
% flattened — alongpath's contract) and closes every subpath
% implicitly, exactly as `fill` would. A curveto proc is still handed
% to pathforall even though flattenpath should have removed them all,
% copying alintern's defensive shape. An empty path yields an empty
% region: zero area, no edges, and scin false everywhere.
    /sqcap 256 def
    /sqbuf sqcap array def
    /sqn 0 def
    /sqhave false def
    /sqfirst true def
    /sqpfirst true def
    /sqpn 0 def
    /sqpx0 0 def /sqpy0 0 def /sqpx1 0 def /sqpy1 0 def
    /sqcx 0 def /sqcy 0 def /sqsx 0 def /sqsy 0 def
    /sqbx0 0 def /sqby0 0 def /sqbx1 0 def /sqby1 0 def
    flattenpath
    { sqmove }
    { sqline }
    { pop pop pop pop pop pop }
    { sqclose }
    pathforall
    sqclose                                      % and the last subpath
    << /Kind /path
       /BBox [ sqbx0 sqby0 sqbx1 sqby1 ]
       /Edges sqbuf 0 sqn getinterval
       /Rule /nonzero >>
} def

% region -> num
% A rectangle's area is exact and cached in its /Area; a path region's
% is *measured*, by integrating the covered width across horizontal
% scanlines under the region's own /Rule.
%
% Measuring rather than deriving is the point. The obvious cheap
% formula -- the absolute value of the summed signed shoelace terms --
% does not measure the region `scin` accepts, and a cross-model review
% of this PR (#119) caught three ways it disagrees: two disjoint
% same-size contours wound oppositely cancel to zero, nested
% same-winding contours double-count the interior instead of reporting
% the outer one, and nothing about it responds to /Rule at all, even
% though the even-odd reading of a donut is a genuinely different
% area. Scanline integration gets all of them right by construction:
% it asks the same containment question `scin` does, just answered a
% whole row at a time.
%
% The slabs are bounded by the geometry itself -- every edge endpoint
% height, plus every height at which two edges cross -- rather than by
% a fixed count of evenly spaced samples. That matters three times
% over. Inside a slab where no edge begins, ends, or crosses another,
% the span structure is fixed and each span's width is linear in y, so
% the slab's midpoint times its height is exact: the measurement is
% exact for any polygon, self-intersecting ones included (a bow tie
% measures its two triangles, not the zero width at the pinch). No
% component can fall between samples either: a 1x1000 sliver alongside
% a 1000x1 one is a region whose two halves live at wildly different
% vertical scales, and evenly spaced sampling reports half of it while
% geometry-bounded slabs report both exactly. And nothing here is
% inferred from samples -- an earlier version subdivided a slab when
% its midpoint width missed the average of its quarter widths, which a
% path can be built to defeat by lining those three samples up across
% a real crossing.
%
% Cost is bounded rather than assumed: measurement work is roughly
% slabs times edges, both of which grow with the path, so a running
% count is checked against the `sqabudget` ceiling and a region too
% complex to measure raises `scarea-region-too-complex-to-measure`
% instead of running for minutes. The ceiling admits paths of roughly
% 800 flattened edges -- for scale, a seven-letter word set at 72pt
% and captured with `charpath` is about 330, and this repo's own
% gallery piece captures a 75-edge ridge. A path that crosses itself
% many times costs more than its edge count suggests, since every
% crossing height buys a subdivision. Real regions are nowhere near it (a few hundred
% flattened edges measures in milliseconds); a region that trips it can
% carry its own area instead -- `region /Area <num> put` short-circuits
% the measurement entirely, since a stored /Area always wins -- and
% `/Count` scatter over such a region needs no area at all.
/scarea {
    dup /Area known { /Area get } { sqmeasure } ifelse
} def

/sqainsert {                                     % y -
% One slab boundary into the sorted boundary list, coincident ones
% merged. Merging matters for more than tidiness: many edge pairs can
% cross at the *same* height -- nine stacked copies of one bow tie
% have 36 edges and hundreds of pairwise crossings, all at two
% heights -- and without merging each one claims another array slot
% until a geometrically trivial region is rejected as too complex
% (Codex review, round 5). Two boundaries closer together than a
% billionth of the region's height bound a slab of no consequence
% anyway.
    /sqav exch def
    /sqaj sqanys def
    {
        sqaj 0 le { exit } if
        sqays sqaj 1 sub get sqav le { exit } if
        /sqaj sqaj 1 sub def
        /sqawork sqawork 1 add def
    } loop
    % Merge only boundaries that coincide to within a few ulps of
    % *their own* magnitude. An epsilon scaled to the region's bbox
    % instead would swallow a whole component whose height is smaller
    % than that: a 1x1e8 sliver beside a 1e10x0.01 one is a real region
    % of about 2e8 whose short half is a hundredth of a unit tall
    % (Codex review, round 6).
    sqaj 0 gt {
        /sqaprev sqays sqaj 1 sub get def
        sqav sqaprev sub abs
        sqav abs sqaprev abs add 5e-13 mul le
    } { false } ifelse
    not {
        sqanys sqaj gt {
            sqanys -1 sqaj 1 add {
                /sqaii exch def
                sqays sqaii sqays sqaii 1 sub get put
                /sqawork sqawork 1 add def
            } for
        } if
        sqays sqaj sqav put
        /sqanys sqanys 1 add def
    } if
    sqawork sqabudget gt sqanys sqays length ge or
        { scarea-region-too-complex-to-measure } if
} def

/sqscanline {                                    % -> covered width
% Every edge crossing the horizontal line y = sqasy, insertion-sorted
% by x with its winding direction alongside (crossing counts stay
% small -- a few per scanline on real shapes -- so an insertion sort
% beats anything cleverer here; the pathological case is charged to
% the work budget rather than paid for with a more elaborate sort).
% Then one walk left to right, accumulating the width of each span the
% rule calls inside.
    /sqawork sqawork sqan add def
    sqawork sqabudget gt { scarea-region-too-complex-to-measure } if
    /sqam 0 def
    0 4 sqaedges length 4 sub {
        /sqai exch def
        /sqey0 sqaedges sqai 1 add get def
        /sqey1 sqaedges sqai 3 add get def
        sqey0 sqasy le sqey1 sqasy le ne {
            /sqex0 sqaedges sqai get def
            /sqex1 sqaedges sqai 2 add get def
            /sqat sqasy sqey0 sub sqey1 sqey0 sub div def
            /sqax sqex0 sqex1 sqex0 sub sqat mul add def
            /sqad sqey1 sqey0 gt { 1 } { -1 } ifelse def
            /sqaj sqam def
            {
                sqaj 0 le { exit } if
                sqaxs sqaj 1 sub get sqax le { exit } if
                sqaxs sqaj sqaxs sqaj 1 sub get put
                sqads sqaj sqads sqaj 1 sub get put
                /sqaj sqaj 1 sub def
                /sqawork sqawork 1 add def
            } loop
            sqaxs sqaj sqax put
            sqads sqaj sqad put
            /sqam sqam 1 add def
            sqawork sqabudget gt
                { scarea-region-too-complex-to-measure } if
        } if
    } for
    /sqacov 0 def
    /sqaw 0 def
    /sqac 0 def
    0 1 sqam 2 sub {
        /sqai exch def
        /sqaw sqaw sqads sqai get add def
        /sqac sqac 1 add def
        sqaeo { sqac 2 mod 0 ne } { sqaw 0 ne } ifelse
            { /sqacov sqacov
                  sqaxs sqai 1 add get sqaxs sqai get sub add def } if
    } for
    sqacov
} def

% Measurement work units (edge scans and sort shifts), tuned so the
% ceiling costs about a second in this interpreter rather than the
% minutes an unbounded measurement of a pathological path would.
% Measurement work units (edge scans and sort shifts), tuned so the
% ceiling costs a second or two in this interpreter rather than the
% minutes an unbounded measurement of a pathological path would.
/sqabudget 2000000 def

/sqacrossings {                                  % -
% Every height at which two edges properly cross, added to the slab
% boundaries alongside the vertex heights. That combination is what
% makes a plain midpoint exact for *any* polygon: inside a slab where
% no edge begins, ends, or crosses another, the sorted span structure
% is fixed and each span's width is linear in y, so midpoint times
% height integrates it exactly.
%
% The previous version instead sniffed for crossings, subdividing a
% slab when its midpoint width missed the average of its quarter
% widths. A fourth review round showed why sampling can't be trusted
% for this: an even-odd region can be built whose three samples line
% up despite genuine crossings between them, and the measurement then
% stops early and overstates the area by a third. Finding the
% crossings is more work up front (every edge pair, charged to the
% same budget) but it can't be fooled, and it costs *less* than three
% samples per slab on the ordinary paths that have no crossings at all.
%
% Endpoint touches are excluded (strict 0 < t < 1): a shared vertex is
% already a boundary, and admitting it would add a duplicate.
    0 4 sqaedges length 8 sub {
        /sqaci exch def
        /sqapx sqaedges sqaci get def
        /sqapy sqaedges sqaci 1 add get def
        /sqarx sqaedges sqaci 2 add get sqapx sub def
        /sqary sqaedges sqaci 3 add get sqapy sub def
        sqaci 4 add 4 sqaedges length 4 sub {
            /sqacj exch def
            /sqawork sqawork 1 add def
            /sqaqx sqaedges sqacj get def
            /sqaqy sqaedges sqacj 1 add get def
            /sqaux sqaedges sqacj 2 add get sqaqx sub def
            /sqauy sqaedges sqacj 3 add get sqaqy sub def
            /sqaden sqarx sqauy mul sqary sqaux mul sub def
            sqaden 0 ne {
                /sqadx sqaqx sqapx sub def
                /sqady sqaqy sqapy sub def
                /sqatt sqadx sqauy mul sqady sqaux mul sub sqaden div def
                /sqauu sqadx sqary mul sqady sqarx mul sub sqaden div def
                sqatt 0 gt sqatt 1 lt and
                sqauu 0 gt sqauu 1 lt and and
                    { sqapy sqary sqatt mul add sqainsert } if
            } if
        } for
        sqawork sqabudget gt { scarea-region-too-complex-to-measure } if
    } for
} def

/sqmeasure {                                     % region -> num
    /sqareg exch def
    /sqaedges sqareg /Edges get def
    /sqaeo sqareg /Rule get /evenodd eq def
    /sqan sqaedges length 4 idiv def
    sqan 0 eq { 0 } {
        /sqawork 0 def
        % Room for both endpoint heights of every edge, plus crossing
        % heights up to the point where integrating that many slabs
        % would exhaust the work budget anyway (each slab costs one
        % pass over the edges), capped so a simple path doesn't
        % allocate an enormous array it will never fill.
        /sqays
            sqan 2 mul
            sqabudget sqan idiv dup 4096 gt { pop 4096 } if add
            8 add array def
        /sqanys 0 def
        0 4 sqaedges length 4 sub {
            /sqai exch def
            sqaedges sqai 1 add get sqainsert
            sqaedges sqai 3 add get sqainsert
        } for
        sqacrossings
        /sqaxs sqan 1 add array def
        /sqads sqan 1 add array def
        /sqatotal 0 def
        0 1 sqanys 2 sub {
            /sqak exch def
            /sqalo sqays sqak get def
            /sqahi sqays sqak 1 add get def
            sqahi sqalo gt {
                /sqasy sqalo sqahi add 2 div def
                /sqatotal
                    sqatotal sqscanline sqahi sqalo sub mul add def
            } if
        } for
        sqatotal
    } ifelse
} def

/siedge {                                        % index -   (one edge)
% Half-open crossing test against the ray running +x from (six,siy):
% an edge counts when exactly one of its endpoints is at or below the
% ray, which also guarantees siy1 != siy0 in the branch that divides.
    /sii exch def
    /six0 siedges sii get def
    /siy0 siedges sii 1 add get def
    /six1 siedges sii 2 add get def
    /siy1 siedges sii 3 add get def
    siy0 siy le siy1 siy le ne {
        /sit siy siy0 sub siy1 siy0 sub div def
        six0 six1 six0 sub sit mul add six gt {
            /sic sic 1 add def
            siy1 siy0 gt { /siw siw 1 add def } { /siw siw 1 sub def } ifelse
        } if
    } if
} def

/siscan {                                        % -> bool  (path region)
    /siedges sireg /Edges get def
    /siw 0 def
    /sic 0 def
    0 4 siedges length 4 sub { siedge } for
    sireg /Rule get /evenodd eq
        { sic 2 mod 0 ne }
        { siw 0 ne }
    ifelse
} def

/scin {                                          % x y region -> bool
    /sireg exch def /siy exch def /six exch def
    /sibb sireg /BBox get def
    six sibb 0 get lt six sibb 2 get gt or
    siy sibb 1 get lt or siy sibb 3 get gt or
        { false }
        { sireg /Kind get /rect eq { true } { siscan } ifelse }
    ifelse
} def

% --- scatter ---------------------------------------------------------

/scfree {                                        % -> bool  (spacing ok?)
% The 5x5 neighborhood around the candidate's own cell. With cells of
% MinSpacing/1.5 a mark can only be within MinSpacing of a cell at
% most 2 away, so this is exact, not an approximation.
    scmin 0 le { true } {
        /scgi scpx scbx sub sccell div truncate cvi def
        /scgj scpy scby sub sccell div truncate cvi def
        /scfok true def
        -2 1 2 {
            /scdi exch def
            -2 1 2 {
                /scdj exch def
                /sckey scgi scdi add 2 add scstride mul
                       scgj scdj add 2 add add def
                scgrid sckey known {
                    /scpt scgrid sckey get def
                    scpx scpt 0 get sub dup mul
                    scpy scpt 1 get sub dup mul add
                    scmin dup mul lt { /scfok false def } if
                } if
            } for
            scfok not { exit } if
        } for
        scfok
    } ifelse
} def

/scwins {                                        % -> bool  (weight roll)
    schasw { scpx scpy scwt scodds } { true } ifelse
} def

/scdeposit {                                     % -   (place one mark)
    scmin 0 gt {
        scgrid
            scpx scbx sub sccell div truncate cvi 2 add scstride mul
            scpy scby sub sccell div truncate cvi 2 add add
            [ scpx scpy ]
        put
    } if
    /scsc scslo scshi eq
        { scslo } { scslo frnd scshi scslo sub mul add } ifelse def
    /scang scrlo scrhi eq
        { scrlo } { scrlo frnd scrhi scrlo sub mul add } ifelse def
    % The running count is a local, published to ScatterState on every
    % placement: a nested scatter (from inside a /Mark or /Weight,
    % wrapped in the caller's own dict as this section's nesting note
    % requires) then gets its own counter rather than resetting this
    % one, and this call's next placement republishes its own count.
    /scrun scrun 1 add def
    ScatterState /placed scrun put
    scpx scpy scsc scang scmark
} def

/scatter {                                       % region opts -
    /scopts exch def
    /screg exch def

    % Everything is validated before a single mark is drawn, the way
    % paintkit's presets validate their whole dict up front: a bad
    % option should fail on the empty page, not halfway through one.
    scopts type /dicttype ne { scatter-opts-must-be-a-dict } if
    screg type /dicttype ne { scatter-needs-a-region } if
    screg /BBox known screg /Kind known and not
        { scatter-needs-a-region } if

    scopts /Mark known not { scatter-mark-is-required } if
    /scmark scopts /Mark get def
    /scmark load sccallable not { scatter-mark-must-be-a-procedure } if

    /schasw scopts /Weight known def
    schasw {
        /scwt scopts /Weight get def
        /scwt load sccallable not
            { scatter-weight-must-be-a-procedure } if
    } if

    /scmin scopts /MinSpacing 0 scgetdef def
    scmin scisnum not { scatter-minspacing-must-be-a-number } if
    scmin 0 lt { scatter-minspacing-must-be-non-negative } if

    /sctries scopts /Tries 20 scgetdef def
    sctries scisnum not { scatter-tries-must-be-a-number } if
    sctries 1 lt sctries 100 gt or { scatter-tries-must-be-1-to-100 } if
    /sctries sctries truncate cvi def

    /scbudget scopts /Budget 20000 scgetdef def
    scbudget scisnum not { scatter-budget-must-be-a-number } if
    scbudget 0 lt scbudget 200000 gt or
        { scatter-budget-must-be-0-to-200000 } if

    /scsr scopts /Scale [ 1 1 ] scgetdef def
    scsr scokrange not { scatter-scale-must-be-two-numbers } if
    /scslo scsr 0 get def
    /scshi scsr 1 get def
    scslo scshi gt { scatter-scale-range-must-be-low-then-high } if

    /scrr scopts /Rotate [ 0 0 ] scgetdef def
    scrr scokrange not { scatter-rotate-must-be-two-numbers } if
    /scrlo scrr 0 get def
    /scrhi scrr 1 get def
    scrlo scrhi gt { scatter-rotate-range-must-be-low-then-high } if

    scopts /Count known scopts /Density known and
        { scatter-count-and-density-are-mutually-exclusive } if
    scopts /Density known {
        /scdens scopts /Density get def
        scdens scisnum not { scatter-density-must-be-a-number } if
        scdens 0 lt { scatter-density-must-be-non-negative } if
        /scregarea screg scarea def
        scregarea 0 le
            { scatter-density-needs-a-region-with-positive-area } if
        /scwant scdens scregarea mul def
    } {
        /scwant scopts /Count 120 scgetdef def
        scwant scisnum not { scatter-count-must-be-a-number } if
        scwant 0 lt { scatter-count-must-be-non-negative } if
    } ifelse
    scwant scbudget gt { scatter-count-exceeds-safety-limit } if
    /scwant scwant truncate cvi def

    /scbb screg /BBox get def
    /scbx scbb 0 get def
    /scby scbb 1 get def
    /scbw scbb 2 get scbx sub def
    /scbh scbb 3 get scby sub def

    scmin 0 gt {
        /sccell scmin 1.5 div def
        % A spacing this fine relative to the region isn't a
        % constraint any more, it's just an enormous key space.
        scbw sccell div scbh sccell div add 4000000 gt
            { scatter-minspacing-too-small-for-the-region } if
        /scstride scbh sccell div truncate cvi 5 add def
        /scgrid scwant 2 mul 32 add dict def
    } if

    /scseeded scopts /Seed known def
    scseeded {
        /scseed scopts /Seed get def
        scseed scisnum not { scatter-seed-must-be-a-number } if
        scseed abs 2147483647 gt { scatter-seed-out-of-range } if
        /scsaved rrand def
        scseed cvi srand
    } if

    % A candidate against a path region costs a pass over its edges;
    % against a rectangle it costs a bounds check. Charge accordingly.
    /sccost screg /Kind get /path eq
        { screg /Edges get length 4 idiv 1 max } { 1 } ifelse def
    /scwork 0 def

    /scrun 0 def
    ScatterState /placed 0 put
    1 1 scwant {
        pop
        1 1 sctries {
            pop
            /scpx scbx frnd scbw mul add def
            /scpy scby frnd scbh mul add def
            /scwork scwork sccost add def
            scwork scworkmax gt
                { scatter-containment-work-exceeds-safety-limit } if
            scpx scpy screg scin {
                scfree {
                    scwins { scdeposit exit } if
                } if
            } if
        } for
    } for

    % Republish at the end: a scatter nested inside this call's last
    % mark would otherwise leave its own count standing as the result.
    ScatterState /placed scrun put

    % rrand/srand round-trips exactly in both pscat and Ghostscript
    % (pinned by hand in both before this was written). Under
    % `--sweep-seed` the sweep overrides this restore too, which is
    % the whole point of a sweep.
    scseeded { scsaved srand } if
} def

% Containment work units (candidate tests, charged by the region's
% edge count) a single scatter call may spend before it is stopped --
% about four seconds' worth in this interpreter, and roughly six times
% what the heaviest scatter in this repo's own gallery spends. A call
% that genuinely needs more can raise it: `/scworkmax <n> def`.
/scworkmax 4000000 def

/ScatterState 4 dict def
ScatterState /placed 0 put
/scplaced { ScatterState /placed get } def       % marks placed, read-only

% --- tiling (regular and randomized tessellations) --------------------
% `grid` above already covers the square case. This section adds one
% general lattice-walk primitive, two shape primitives to go with
% ngon/star/rrect, and drivers for the other two regular tilings (hex,
% triangular) plus a randomized-orientation driver for Truchet tiles —
% a single motif, randomly quarter-turned per cell, that reads as a
% flowing maze even though the underlying grid is perfectly regular.
% True aperiodic (Penrose-style) tiling is a deliberate omission: it
% needs matching-rule/substitution machinery well beyond a lattice
% walk, where Truchet already delivers the "looks aperiodic" effect
% generative art actually wants.
%
% Composition gotcha, same one grid/ngon already have (shared tk-
% prefix): a driver here (lattice/hexgrid/trigrid/truchet) re-reads its
% own tg-named position state from the *current dict* on every
% iteration, so a stamp proc that calls hex/tri/another driver
% un-wrapped clobbers that state the instant the first cell runs (their
% `/tgx exch def` etc. land in the same dict). Fix: wrap just the
% inner call in its own small dict — `3 dict begin cx cy r hex end` —
% so its defs shadow there instead. Do NOT wrap a proc's own persistent
% per-cell state (a running counter, an array index) inside that same
% nested dict — `def` always targets the innermost open dict, so an
% incrementing counter defined inside the wrapper is discarded at
% `end` instead of surviving to the next cell; keep counters outside
% the wrapper (or store them in an array via `put`, immune to this).

% x0 y0 v1x v1y v2x v2y n1 n2 {x y -} lattice -
% Walks an n1 x n2 grid of points x0,y0 + i*v1 + j*v2 (i in 0..n1-1, j
% in 0..n2-1), calling proc at each — the primitive hexgrid/trigrid
% are built on. Any v1/v2 pair (square, oblique, brick-bond offsets)
% lets a caller tile a custom motif — Escher-style interlocking shapes
% included — the same way alongpath lets a brush walk any path.
/lattice {
    /tgproc exch def /tgn2 exch def /tgn1 exch def
    /tgv2y exch def /tgv2x exch def /tgv1y exch def /tgv1x exch def
    /tgy0 exch def /tgx0 exch def
    0 1 tgn2 1 sub {
        /tgj exch def
        0 1 tgn1 1 sub {
            /tgi exch def
            tgx0 tgi tgv1x mul add tgj tgv2x mul add
            tgy0 tgi tgv1y mul add tgj tgv2y mul add
            tgproc
        } for
    } for
} def

% cx cy r hex -  (appended to current path; pointy-top, like ngon/star)
/hex {
    /tgr exch def /tgy exch def /tgx exch def
    tgx tgr 90 cos mul add tgy tgr 90 sin mul add moveto
    1 1 5 {
        /tgk exch def
        /tga 90 tgk 60 mul add def
        tgx tga cos tgr mul add tgy tga sin tgr mul add lineto
    } for
    closepath
} def

% cx cy s up tri -  (appended to current path; up true points up)
/tri {
    /tgup exch def /tgs exch def /tgy exch def /tgx exch def
    /tgR tgs 0.577350 mul def                    % centroid-to-vertex
    /tga tgs 0.288675 mul def                    % centroid-to-edge
    tgup {
        tgx tgy tgR add moveto
        tgx tgs 2 div sub tgy tga sub lineto
        tgx tgs 2 div add tgy tga sub lineto
    } {
        tgx tgy tgR sub moveto
        tgx tgs 2 div sub tgy tga add lineto
        tgx tgs 2 div add tgy tga add lineto
    } ifelse
    closepath
} def

% x y w h cols rows {cx cy r -} hexgrid -
% Pointy-top hex lattice, cols hexes spanning w, odd rows staggered by
% half a hex. h is accepted (for signature symmetry with grid) but NOT
% used to size the hexes — a regular hexagon's width and height aren't
% independent, so only w/cols sets the scale; rows is just "how many
% rows of that size to draw," not a second fit constraint. Mismatched
% rows can leave most of the box empty or run well past its bottom
% edge — e.g. 10 cols/1 row on a square box covers only a thin top
% strip. To actually span h, pick rows yourself: r = (w/cols)/sqrt(3),
% then rows ~= h / (r*1.5).
/hexgrid {
    /tgproc exch def /tgrows exch def /tgcols exch def
    /tgh exch def /tgw exch def /tgy exch def /tgx exch def
    /tgr tgw tgcols div 1.732051 div def         % 1.732051 ~= sqrt(3)
    /tgdx tgr 1.732051 mul def
    /tgdy tgr 1.5 mul def
    0 1 tgrows 1 sub {
        /tgj exch def
        /tgoff tgj 2 mod 0 eq { 0 } { tgdx 2 div } ifelse def
        0 1 tgcols 1 sub {
            /tgi exch def
            tgx tgi tgdx mul add tgoff add
            tgy tgj tgdy mul add
            tgr tgproc
        } for
    } for
} def

% x y w h cols rows {cx cy s up -} trigrid -
% Triangular lattice: cols upward triangles span w; each row packs
% cols*2 triangles (alternating up/down) at the derived edge length s.
% Same h caveat as hexgrid just above: an equilateral triangle's row
% height is fixed by s (= w/cols), so h isn't an independent fit
% constraint — pick rows yourself if you need the tiling to actually
% reach the box's bottom edge: rows ~= h / (s*0.866025).
/trigrid {
    /tgproc exch def /tgrows exch def /tgcols exch def
    /tgh exch def /tgw exch def /tgy exch def /tgx exch def
    /tgs tgw tgcols div def
    /tgrh tgs 0.866025 mul def                   % row height = s*sqrt(3)/2
    /tga tgs 0.288675 mul def
    /tgR tgs 0.577350 mul def
    0 1 tgrows 1 sub {
        /tgj exch def
        /tgyb tgy tgj tgrh mul add def
        0 1 tgcols 2 mul 1 sub {
            /tgi exch def
            /tgup tgi 2 mod 0 eq def
            tgx tgi tgs mul 2 div add tgs 4 div add
            tgup { tgyb tga add } { tgyb tgR add } ifelse
            tgs tgup tgproc
        } for
    } for
} def

% x y w h cols rows {w h -} truchet -
% Truchet tiles: walks a square grid like grid, but wraps each call in
% gsave / translate-to-cell-center / rotate-by-a-random-quarter-turn /
% grestore first, so proc only ever draws one motif centered on the
% origin — the random rotation is what turns a single repeated tile
% into the classic flowing Truchet look.
/truchet {
    /tgproc exch def /tgrows exch def /tgcols exch def
    /tgh exch def /tgw exch def /tgy exch def /tgx exch def
    /tgcw tgw tgcols div def
    /tgch tgh tgrows div def
    0 1 tgrows 1 sub {
        /tgj exch def
        0 1 tgcols 1 sub {
            /tgi exch def
            gsave
                tgx tgi tgcw mul add tgcw 2 div add
                tgy tgj tgch mul add tgch 2 div add
                translate
                4 chance 90 mul rotate
                tgcw tgch tgproc
            grestore
        } for
    } for
} def

% --- fractals: edge-replacement and area-subdivision -------------------
% Two distinct self-similar-geometry genres, generalized from the
% one-off `koch` in examples/koch_snowflake.ps and `sierpinski` in
% examples/sierpinski.ps. L-systems (above) already cover recursive
% branching (trees, plants) via lsys/ldraw — this section is
% deliberately the other two well-known fractal genres: replacing each
% edge of a shape with a scaled copy of a generator motif (Koch-style),
% and recursively subdividing an area into self-similar sub-regions,
% omitting some (Sierpinski-style).

% len angle turns scale depth edgefractal -  (draws via rlineto from
% currentpoint, like `fd`/`koch` — stroke it yourself)
% `turns` is an array of N turn-deltas (degrees), applied cumulatively
% before each of N equal-length segments; `scale` is how many
% segments' worth of *straight-line* length the whole generator spans
% end to end (NOT necessarily N — see below). At depth 0, draws one
% straight segment of the requested length at the requested angle; at
% deeper levels, divides length by `scale` and recurses once per turn
% in `turns`.
%
% The classic Koch generator is the reason `scale` can't just be
% `turns length`: it has 4 segments (the two sides of the bump plus
% the two straight ends) but spans only 3 segment-lengths end to end
% (the bump's two sides fold back across each other). Verified by
% walking `[0 60 -120 60]` as unit-length turtle steps from heading 0:
% displacements (1,0) (cos60,sin60) (cos-60,sin-60) (1,0) sum to
% exactly (3,0) — zero net turn, net forward displacement 3, matching
% examples/koch_snowflake.ps's own `len 3 div` with its 4 recursive
% calls. A caller-supplied `turns` that doesn't close this way (net
% turn a multiple of 360, net unit-step displacement (scale,0)) will
% silently draw a curve that drifts off axis or the wrong length —
% same "caller's contract, not validated" doctrine as this file's
% other shape procs.
%
% Recurses into itself, so — like `koch`/`sierpinski` before it, and
% unlike this file's non-recursive shape procs — its whole body is
% scoped inside its own `dict begin/end`. Without that, a recursive
% call's `def`s would land in the *same* dict as the caller's own loop
% state (there being no other frame to receive them), clobbering `efa`
% between iterations of the `for` loop below the instant the first
% recursive call returns — confirmed while building this section, the
% same failure mode the tiling section's header already documents for
% tg-/tk- collisions, just self-inflicted via recursion instead of
% caller composition.
/edgefractal {
    5 dict begin
        /efdepth exch def
        /efscale exch def
        /efturns exch def
        /efangle exch def
        /eflen exch def

        efdepth 0 eq {
            efangle cos eflen mul efangle sin eflen mul rlineto
        } {
            /efseg eflen efscale div def
            /efa efangle def
            0 1 efturns length 1 sub {
                /efi exch def
                /efa efa efturns efi get add def
                efseg efa efturns efscale efdepth 1 sub edgefractal
            } for
        } ifelse
    end
} def

% Two verified generators (own dict, `Palettes`-style): `/koch` is the
% classic bump (verified above); `/quadkoch` is an 8-segment generator
% (the Minkowski-sausage / "quadratic Koch" family) verified the same
% way — walking `[0 90 -90 -90 0 90 90 -90]` as unit steps from
% heading 0 sums to exactly (4,0), zero net turn, so `scale` is 4, not
% 8. `/name fgen` (mirrors `pal`/`palpick`'s exch-and-get convenience)
% pushes `turns scale`, the order edgefractal/edgepoly expect.
/FractalGens <<
    /koch     [[0 60 -120 60] 3]
    /quadkoch [[0 90 -90 -90 0 90 90 -90] 4]
>> def
/fgen { FractalGens exch get aload pop } def   % /name -> turns scale

% [x0 y0 x1 y1 ... ] turns scale depth edgepoly -  (closed subpath
% appended to current path — stroke or fill it yourself)
% Generalizes `snowflake` in examples/koch_snowflake.ps from a
% hardcoded triangle to any closed polygon: moveto the first vertex,
% then edgefractal each edge in turn (wrapping last back to first),
% closepath. Vertices are supplied directly, same contract as hpoly's
% `[verts]` — this file has no regular-polygon vertex generator (ngon
% appends straight path segments rather than returning coordinates);
% compute a small vertex array by hand for a triangle/square base, the
% same way httile hand-computes its own fundamental polygon.
%
% Winding direction matters: a generator whose first nonzero turn is
% positive (both presets above) bulges to the *left* of each edge's own
% direction of travel. For those bumps to point outward from the
% polygon (the classic snowflake look) the vertices must run clockwise
% — confirmed by rendering both orderings: counterclockwise vertices
% here produce bumps folding inward instead (same reasoning
% examples/koch_snowflake.ps's own header already gives for its
% hardcoded triangle, generalized to any polygon here).
/edgepoly {
    /epdepth exch def
    /epscale exch def
    /epturns exch def
    /epverts exch def
    /epn epverts length 2 idiv def

    epverts 0 get epverts 1 get moveto
    0 1 epn 1 sub {
        /epi exch def
        /epj epi 1 add epn mod def
        /epx1 epverts epi 2 mul get def
        /epy1 epverts epi 2 mul 1 add get def
        /epx2 epverts epj 2 mul get def
        /epy2 epverts epj 2 mul 1 add get def
        /epdx epx2 epx1 sub def
        /epdy epy2 epy1 sub def
        /eplen epdx dup mul epdy dup mul add sqrt def
        /epang epdy epdx atan def
        eplen epang epturns epscale epdepth edgefractal
    } for
    closepath
} def

% x1 y1 x2 y2 x3 y3 depth {x1 y1 x2 y2 x3 y3 -} gasket -
% The Sierpinski gasket: at depth 0, calls proc with the triangle's
% three corners (paint it however you like — fill, stroke, stamp);
% otherwise recurses into the three corner sub-triangles formed by the
% edge midpoints (same split as examples/sierpinski.ps). Every other
% driver in this file (grid/lattice/hexgrid/trigrid/truchet) hands the
% caller a proc instead of painting for them, so this does too.
%
% Iterative (an explicit array-backed stack), not a recursive PostScript
% proc calling itself, even though the algorithm is naturally recursive
% — same reason `httile` below drives its own BFS with a queue array
% instead of recursing. A recursive version needs each level's own
% `dict begin/end` (same reason `koch`/`edgefractal` do — see there),
% but unlike those, this proc doesn't just recurse into itself, it also
% invokes a *caller-supplied* proc at the leaves; confirmed empirically
% while building this that a naive recursive version leaves every
% ancestor level's `dict` open at the moment a leaf calls `gkproc` (each
% recursive call happens *before* its own `end`, not after), so a stamp
% as simple as `{ /n n 1 add def }` — the exact idiom this file's own
% `truchet_calls_proc_once_per_cell_with_the_cell_size` test already
% relies on for a non-recursive driver — silently rebinds `/n` into
% whichever ancestor frame happens to be innermost instead of the
% caller's own dict, and the count is lost the moment that frame's
% `end` runs. Driving the walk with a stack array instead means `gkproc`
% always runs with the *caller's* own dict on top, exactly like every
% other driver here, no caveat needed.
%
% Composition gotcha, same shape as the tiling section's tg-/tk- one
% above (a cross-model review caught it here specifically): `gksp`/
% `gkstack`/`gkproc` are plain globals, not dict-scoped, so a leaf proc
% that calls `gasket` again itself (nested fractals — a gasket of
% gaskets) clobbers the *outer* traversal's own state the instant the
% inner call starts, since both bind the same names. Same fix as
% hex/tri inside hexgrid/trigrid: wrap just the inner call in its own
% `N dict begin ... end` so its `def`s shadow there instead — confirmed
% this actually restores the outer traversal (a naive unwrapped nested
% call visits only 1 of 3 outer leaves instead of 3; wrapped, all 3).
% That wrap then reintroduces the *other* documented gotcha (a plain
% `def` counter inside the inner proc is itself swallowed at the
% wrapper's `end`) — same fix as there too: an array mutated with
% `put`, immune to dict nesting. `carpet` below shares the identical
% shape (`cpsp`/`cpstack`/`cpproc`) and the identical fix.
%
% The stack never holds more than `2*depth+1` pending records: each pop
% immediately expands into its 3 children (pushed before anything else
% is popped), so the walk behaves exactly like real call-stack
% recursion — depth generations of "2 siblings not yet visited" plus
% the one record just popped, not the full 3^depth leaf count. Sized
% from `gkdepth` at call time (no fixed cap, so no silent-truncation
% path to document or to accidentally undertest).
/gasket {
    /gkproc exch def
    /gkdepth exch def
    /gky3 exch def /gkx3 exch def
    /gky2 exch def /gkx2 exch def
    /gky1 exch def /gkx1 exch def
    /gkstack gkdepth 2 mul 1 add 7 mul array def
    gkstack 0 gkx1 put gkstack 1 gky1 put
    gkstack 2 gkx2 put gkstack 3 gky2 put
    gkstack 4 gkx3 put gkstack 5 gky3 put
    gkstack 6 gkdepth put
    /gksp 1 def
    {
        gksp 0 eq { exit } if
        /gksp gksp 1 sub def
        /gkbase gksp 7 mul def
        gkstack gkbase get /gkcx1 exch def
        gkstack gkbase 1 add get /gkcy1 exch def
        gkstack gkbase 2 add get /gkcx2 exch def
        gkstack gkbase 3 add get /gkcy2 exch def
        gkstack gkbase 4 add get /gkcx3 exch def
        gkstack gkbase 5 add get /gkcy3 exch def
        gkstack gkbase 6 add get /gkcd exch def
        gkcd 0 eq {
            gkcx1 gkcy1 gkcx2 gkcy2 gkcx3 gkcy3 gkproc
        } {
            /gkmx12 gkcx1 gkcx2 add 2 div def
            /gkmy12 gkcy1 gkcy2 add 2 div def
            /gkmx23 gkcx2 gkcx3 add 2 div def
            /gkmy23 gkcy2 gkcy3 add 2 div def
            /gkmx31 gkcx3 gkcx1 add 2 div def
            /gkmy31 gkcy3 gkcy1 add 2 div def
            /gkcd1 gkcd 1 sub def
            /gkb gksp 7 mul def
            gkstack gkb gkcx1 put gkstack gkb 1 add gkcy1 put
            gkstack gkb 2 add gkmx12 put gkstack gkb 3 add gkmy12 put
            gkstack gkb 4 add gkmx31 put gkstack gkb 5 add gkmy31 put
            gkstack gkb 6 add gkcd1 put
            /gkb gksp 1 add 7 mul def
            gkstack gkb gkmx12 put gkstack gkb 1 add gkmy12 put
            gkstack gkb 2 add gkcx2 put gkstack gkb 3 add gkcy2 put
            gkstack gkb 4 add gkmx23 put gkstack gkb 5 add gkmy23 put
            gkstack gkb 6 add gkcd1 put
            /gkb gksp 2 add 7 mul def
            gkstack gkb gkmx31 put gkstack gkb 1 add gkmy31 put
            gkstack gkb 2 add gkmx23 put gkstack gkb 3 add gkmy23 put
            gkstack gkb 4 add gkcx3 put gkstack gkb 5 add gkcy3 put
            gkstack gkb 6 add gkcd1 put
            /gksp gksp 3 add def
        } ifelse
    } loop
} def

% x y w h depth {x y w h -} carpet -
% The Sierpinski carpet: the square/rectangle counterpart to `gasket`
% (a distinct algorithm, not a reparameterization of it) — splits the
% box into a 3x3 grid and recurses into the 8 outer cells, skipping
% the center one, down to depth 0 where proc paints each surviving
% cell. Unlike hexgrid/trigrid, both w and h are load-bearing (a 3x3
% split scales independently per axis, so non-square boxes still tile
% without a caveat). Same stack-array iteration as `gasket`, same
% reason — `cpproc` must always run with no ancestor frame open.
%
% Same peak-size reasoning as `gasket`'s own stack, scaled for 8
% children per non-leaf instead of 3: never more than `7*depth+1`
% pending records, sized from `cpdepth` at call time.
/carpet {
    /cpproc exch def
    /cpdepth exch def
    /cph exch def /cpw exch def /cpy exch def /cpx exch def
    /cpstack cpdepth 7 mul 1 add 5 mul array def
    cpstack 0 cpx put cpstack 1 cpy put
    cpstack 2 cpw put cpstack 3 cph put cpstack 4 cpdepth put
    /cpsp 1 def
    {
        cpsp 0 eq { exit } if
        /cpsp cpsp 1 sub def
        /cpbase cpsp 5 mul def
        cpstack cpbase get /cpcx exch def
        cpstack cpbase 1 add get /cpcy exch def
        cpstack cpbase 2 add get /cpcw exch def
        cpstack cpbase 3 add get /cpch exch def
        cpstack cpbase 4 add get /cpcd exch def
        cpcd 0 eq {
            cpcx cpcy cpcw cpch cpproc
        } {
            /cpw3 cpcw 3 div def
            /cph3 cpch 3 div def
            /cpcd1 cpcd 1 sub def
            0 1 2 {
                /cpi exch def
                0 1 2 {
                    /cpj exch def
                    cpi 1 eq cpj 1 eq and not {
                        /cpb cpsp 5 mul def
                        cpstack cpb cpcx cpi cpw3 mul add put
                        cpstack cpb 1 add cpcy cpj cph3 mul add put
                        cpstack cpb 2 add cpw3 put
                        cpstack cpb 3 add cph3 put
                        cpstack cpb 4 add cpcd1 put
                        /cpsp cpsp 1 add def
                    } if
                } for
            } for
        } ifelse
    } loop
} def

% --- hyperbolic geometry (Poincare disk model) ------------------------
% The disk model: the whole hyperbolic plane lives inside a Euclidean
% unit disk. Points map out with plain uniform scaling (hpoint below is
% just an affine map — no distortion there); all the curvature lives in
% *lines*. A hyperbolic "straight line" (geodesic) is either a diameter
% of the disk, or a circular arc that meets the disk's boundary at a
% right angle (horthocircle/hgeo). That single fact — geodesics are
% orthogonal-circle arcs — is what every procedure below is built from.
%
% Working coordinates are *logical* unit-disk coordinates (|x,y| < 1,
% origin at the disk's own center) — the caller supplies a device frame
% (cx, cy, r) the same way ctext/hex/tri take one, and every proc here
% maps logical -> device internally. Angles are plain degrees.
%
% NOTE for anyone tempted to build geodesics with a scoped
% `gsave/translate/scale/...arc.../grestore` instead: don't. In this
% interpreter (unlike stock PLRM PostScript — see ctext's header
% comment above) the current path is itself part of what gsave/grestore
% snapshot, so path segments built inside a gsave are thrown away at the
% matching grestore, not left on the path. Every proc below maps its own
% device coordinates by hand instead of leaning on the CTM.
%
% cx cy r x y hpoint -> dx dy   (logical unit-disk point -> device space)
/hpoint {
    /hpy exch def /hpx exch def
    /hpr exch def /hpcy exch def /hpcx exch def
    hpcx hpx hpr mul add
    hpcy hpy hpr mul add
} def

% hrad theta hpolar -> x y   (hyperbolic radius + angle(deg) -> logical
% Poincare coords: x = tanh(hrad/2)*cos(theta), y = tanh(hrad/2)*sin(theta).
% tanh(t/2) = (1 - e^-t) / (1 + e^-t); PostScript's `exp` is
% base^exponent, not e^x, hence the literal base below. Written with the
% negative exponent (not the algebraically-equivalent (e^t-1)/(e^t+1))
% specifically so it stays finite for any hrad a caller might actually
% pass: e^-t underflows harmlessly to 0 as hrad grows, giving the
% correct limit of 1, whereas e^t overflows to infinity long before that
% and produces NaN. hrad is assumed >= 0, like a radius anywhere else in
% this file. Places things at genuine hyperbolic distances from the
% disk's center — the crowding toward the rim as hrad grows is the
% signature look of this model, not a bug to correct for.
/hpolar {
    /hath exch def /harad exch def
    /hau 2.718281828459045 harad neg exp def
    /haR 1 hau sub 1 hau add div def
    haR hath cos mul
    haR hath sin mul
} def

% x1 y1 x2 y2 horthocircle -> a b r isline
% The geodesic through two logical points: the circle orthogonal to the
% unit circle that passes through both (or, when the points are
% collinear with the origin, the diameter through them — the one
% geodesic that isn't a proper arc). Method: a circle centered at (cx,cy)
% is orthogonal to the unit circle exactly when cx^2+cy^2 = r^2+1: combine
% that with |c-p|^2 = r^2 for each of p1, p2 and the r^2 cancels,
% collapsing to one linear equation per point, c.p = (|p|^2+1)/2. Two
% points give a 2x2 linear system for c, solved by Cramer's rule with
% determinant D = x1*y2 - y1*x2 -- exactly sin(angle between p1 and p2 as
% seen from the origin) scaled by |p1||p2|, so D is small precisely when
% p1, p2, and the origin are close to collinear (including either point
% being at/near the origin, where D vanishes trivially) and nowhere else.
% Degenerate input (D near zero) falls back to isline=true, with a,b
% repurposed as p2-p1's *unit direction* (not a circle) — hreflect below
% relies on that repurposing.
%
% This replaced an earlier version that inverted p2 in the unit circle
% and solved a circumcircle through three points instead of this direct
% 2x2 system. That formulation used a *different* determinant (of the
% circumcircle, not of the linear system above) as both its collinearity
% test and its sole divisor -- a quantity that, unlike D here, is not
% scale-invariant and can catastrophically cancel to near-zero even when
% p1/p2 are genuinely non-collinear, forcing two band-aid guards (an
% absolute near-origin cutoff, and a second tight cutoff on the
% cancelling determinant) that a cross-model review (round 4) showed both
% misclassify real, non-collinear geodesics as diameters: one on any
% point within 0.001 of the origin regardless of its partner's angle
% (`0.0005 0 0 0.5 horthocircle` reported isline=true and reflecting
% p1 across it moved p1 instead of fixing it), the other on the {10,10}
% depth-4 tiling used in this file's own tests. D as the single
% degeneracy test and the single divisor removes both band-aids and both
% failure modes at once, rather than tightening either threshold further.
%
% Always the *true* circle, however large its radius — this is also
% hreflect's transformation math, and approximating a large-but-finite
% circle as a diameter is a real, visible distortion there, not just a
% harmless simplification: a diameter's reflection formula is a mirror
% across a line THROUGH THE ORIGIN, so applying it to a chord that
% merely *looks* like a diameter (large orthogonal-circle radius, but
% not collinear with the origin) does not fix that chord's own defining
% points, breaking the one invariant every geodesic reflection must have
% (confirmed empirically: reflecting p1 across the near-diameter through
% p1=(0.010195, 0.2), p2=(0.010195, -0.2) — radius ~51, not a true
% diameter — moved p1 to (-0.010195, 0.2) instead of fixing it). The
% radius still legitimately overwhelms `arc` for *drawing* purposes
% (confirmed: gs raised `limitcheck` on one, deep in a depth-4 httile
% BFS) — hgeo/hpoly fall back to a straight chord there, but that's a
% device-space rendering approximation scoped to those two procs, not a
% change to what this proc reports.
/horthocircle {
    /hoy2 exch def /hox2 exch def
    /hoy1 exch def /hox1 exch def
    /hod1 hox1 dup mul hoy1 dup mul add def
    /hod2 hox2 dup mul hoy2 dup mul add def
    % D = 0 exactly iff p1, p2, and the origin are exactly collinear -- the
    % one case with no well-defined finite-radius orthogonal circle, so
    % it's the only case that *geometrically* needs the diameter fallback.
    % A cross-model review (round 7) found that the previous *relative*
    % threshold here (sin(angle) small compared to |p1||p2|) also fired
    % for points simply close together near the disk boundary, regardless
    % of collinearity -- confirmed with p1=(0.9371500703,0.3489261063),
    % p2=(0.9371497472,0.3489269739), ~9e-7 apart, both near-boundary:
    % sin(angle) there is tiny purely because the points are close
    % together, not because the geodesic through them is anywhere near a
    % diameter (its true orthogonal circle has radius ~9e-6, a small,
    % perfectly well-conditioned circle the old relative test discarded
    % for a wrong diameter approximation). But dropping the tolerance to
    % bare equality broke ordinary, non-extreme cases ({7,3} depth 2's
    % pinned tile count moved from 29 to 35, with ink landing outside the
    % disk) -- `hox1*hoy2` and `hoy1*hox2` accumulate their own rounding
    % error through the chain of prior reflections composing them, so two
    % values that are *mathematically* equal (true collinearity) rarely
    % subtract to bit-exact 0.0 in practice. The threshold needs to track
    % that subtraction's own noise floor instead of either extreme:
    % roughly eps times the magnitude of the terms being subtracted
    % (`|x1*y2| + |y1*x2|`), not a threshold relative to |p1||p2| (round
    % 7's failure mode) or an absolute zero (this round's own first,
    % overcorrected attempt).
    %
    % eps=1e-6, not the tighter value this file used briefly: round eight
    % found `gs` computes PostScript reals in 32-bit float (confirmed:
    % `1 3 div` prints `0.333333343` under `gs`, `0.3333333333333333`
    % here), whose noise floor for a subtraction like this is around
    % 1.2e-7 relative -- an order of magnitude looser than this
    % interpreter's f64 noise floor, which a tight eps was tuned against.
    % Too tight, `gs`'s own arithmetic corrupts `cx`/`cy` for pairs it
    % can't reliably subtract, silently inflating tile counts (confirmed:
    % the shipped {7,3} depth-4 gallery piece rendered 323 tiles under
    % `gs` instead of 232). eps=1e-6 sits in the (narrow) window above
    % `gs`'s noise floor and below the round-7 counterexample's own
    % ratio (1.42e-6) -- the largest value that still keeps every pinned
    % tile count exact under this interpreter's f64 arithmetic (29, 232,
    % 1711, 8201) and doesn't misclassify either discriminator above.
    % That narrowness is itself the finding: this interpreter's and
    % `gs`'s noise floors are only about one order of magnitude apart
    % under float32, so no single constant serves both exactly -- `gs`
    % improves substantially (323 -> 233 tiles on the gallery piece) but
    % isn't tile-count-exact with this interpreter even here, the same
    % way it isn't for the *much* shallower {7,3} depth 2 (29 here, 30
    % under `gs`) or {6,4} depth 5 (1711 here, 1653 under `gs`) --
    % see NOTES.md for why this is a documented, expected precision
    % difference rather than a bug to keep chasing.
    /hocross hox1 hoy2 mul hoy1 hox2 mul sub def
    /honoise hox1 hoy2 mul abs hoy1 hox2 mul abs add def
    /hodeg hocross abs honoise 1e-6 mul le def
    hodeg {
        % The direction of a true diameter is radial -- along the line
        % through the origin and (either) defining point -- not along the
        % chord p2-p1. Those agree only when p1/p2 are *exactly*
        % collinear with the origin; for a near-collinear pair let in by
        % this branch's tolerance, p2-p1 can be closer to tangential than
        % radial when p1 and p2 have similar magnitude (a cross-model
        % review counterexample: p1=(0.99,0), p2 a hair's-width away in
        % angle at nearly the same radius -- the chord direction there is
        % dominated by that tiny angular offset, nearly perpendicular to
        % the true ~(1,0) radial direction, and reflecting p1 across it
        % moved p1 to roughly (-0.99,-0.001) instead of fixing it). Use
        % whichever point is farther from the origin (better-conditioned
        % than the near-origin one, and exact for a true diameter since
        % both points' own directions agree with each other and with the
        % chord in that case).
        hod1 hod2 gt { hox1 hoy1 } { hox2 hoy2 } ifelse
        /hodry exch def /hodrx exch def
        /hodrn hodrx dup mul hodry dup mul add sqrt def
        % Both points at/near the origin (a zero-length or near-zero-length
        % edge) has no defined direction; fall back to an arbitrary unit
        % vector rather than propagating a NaN into the rest of the BFS.
        hodrn 0 gt { hodrx hodrn div hodry hodrn div } { 1 0 } ifelse
        0 true
    } {
        /hok1 hod1 1 add 2 div def
        /hok2 hod2 1 add 2 div def
        /hocx hok1 hoy2 mul hok2 hoy1 mul sub hocross div def
        /hocy hox1 hok2 mul hox2 hok1 mul sub hocross div def
        % Clamp against rounding noise right at the boundary of the
        % collinearity test above, where |c| can compute fractionally
        % under 1 even though it's mathematically always > 1 for two
        % distinct interior points.
        /hor2 hocx dup mul hocy dup mul add 1 sub def
        /hor hor2 0 gt { hor2 sqrt } { 0 } ifelse def
        hocx hocy hor false
    } ifelse
} def

% a b r isline x y hreflect -> x' y'
% Reflects a logical point across the geodesic horthocircle described
% (its a/b/r/isline outputs, fed straight in) — circle inversion for a
% proper arc, an ordinary mirror across the line through the origin
% (direction a,b) for the diameter case. This one operation is the whole
% tiling generator below: reflecting a tile's vertices across one of its
% own edges produces its neighbor across that edge.
/hreflect {
    /hry exch def /hrx exch def
    /hrisline exch def /hrr exch def /hrb exch def /hra exch def
    hrisline {
        /hrd hrx hra mul hry hrb mul add def
        hrd 2 mul hra mul hrx sub
        hrd 2 mul hrb mul hry sub
    } {
        /hrdx hrx hra sub def /hrdy hry hrb sub def
        /hrd2 hrdx dup mul hrdy dup mul add def
        hra hrr dup mul hrdx mul hrd2 div add
        hrb hrr dup mul hrdy mul hrd2 div add
    } ifelse
} def

% cx cy r x1 y1 x2 y2 hgeo -
% Appends the hyperbolic geodesic between two *logical* points to the
% current path as its own subpath (starts with a moveto — this is the
% self-contained single-segment primitive; hpoly below builds a
% continuous multi-edge polygon instead of chaining these). Maps
% horthocircle's circle into the device frame by hand (translate +
% uniform scale by r — angles are unchanged by that, only distances
% scale, which is why the arc's start/end angles computed in logical
% space can be reused directly as device-space angles).
/hgeo {
    /hgy2 exch def /hgx2 exch def
    /hgy1 exch def /hgx1 exch def
    /hgr exch def /hgcy exch def /hgcx exch def
    hgx1 hgy1 hgx2 hgy2 horthocircle
    /hgisline exch def /hgor exch def /hgob exch def /hgoa exch def
    % Drawing-only approximation: a large-but-finite orthogonal-circle
    % radius overwhelms `arc` (gs raised limitcheck on one) long before
    % it's visually distinguishable from a straight chord at any device
    % scale here. Scoped to this proc's own hgisline copy -- horthocircle
    % itself always reports the true circle, since hreflect needs it
    % (see horthocircle's header).
    /hgisline hgisline hgor 50 gt or def
    hgcx hgx1 hgr mul add hgcy hgy1 hgr mul add moveto
    hgisline {
        hgcx hgx2 hgr mul add hgcy hgy2 hgr mul add lineto
    } {
        /hga1 hgy1 hgob sub hgx1 hgoa sub atan def
        /hga2 hgy2 hgob sub hgx2 hgoa sub atan def
        % PostScript's `mod` is integer-only (rangecheck/typecheck on a
        % real operand) and atan's result is real, so the forward sweep
        % is wrapped into [0,360) by hand instead — one conditional
        % subtract suffices since hga2-hga1+360 is already in (0,720).
        /hgfwd hga2 hga1 sub 360 add def
        hgfwd 360 ge { /hgfwd hgfwd 360 sub def } if
        /hgmid hga1 hgfwd 2 div add def
        /hgmx hgoa hgmid cos hgor mul add def
        /hgmy hgob hgmid sin hgor mul add def
        /hgdcx hgcx hgoa hgr mul add def
        /hgdcy hgcy hgob hgr mul add def
        /hgdr hgor hgr mul def
        hgmx dup mul hgmy dup mul add 1 lt {
            hgdcx hgdcy hgdr hga1 hga2 arc
        } {
            hgdcx hgdcy hgdr hga1 hga2 arcn
        } ifelse
    } ifelse
} def

% cx cy r [v0x v0y v1x v1y ... ] hpoly -
% A closed geodesic polygon from a flat array of logical vertices, as
% one continuous subpath (moveto the first vertex, then each edge
% continues the path with lineto/arc rather than hgeo's own moveto, so
% closepath actually closes the whole polygon, not just its last edge).
% Shares horthocircle's arc-direction math rather than calling hgeo
% edge-by-edge — the price of the continuous-subpath contract.
/hpoly {
    /hyverts exch def
    /hyr exch def /hycy exch def /hycx exch def
    /hyn hyverts length 2 idiv def
    hycx hyverts 0 get hyr mul add
    hycy hyverts 1 get hyr mul add
    moveto
    0 1 hyn 1 sub {
        /hyi exch def
        /hyj hyi 1 add hyn mod def
        /hyx1 hyverts hyi 2 mul get def
        /hyy1 hyverts hyi 2 mul 1 add get def
        /hyx2 hyverts hyj 2 mul get def
        /hyy2 hyverts hyj 2 mul 1 add get def
        hyx1 hyy1 hyx2 hyy2 horthocircle
        /hyisline exch def /hyor exch def /hyob exch def /hyoa exch def
        % Same drawing-only large-radius fallback as hgeo -- see there.
        /hyisline hyisline hyor 50 gt or def
        hyisline {
            hycx hyx2 hyr mul add hycy hyy2 hyr mul add lineto
        } {
            /hya1 hyy1 hyob sub hyx1 hyoa sub atan def
            /hya2 hyy2 hyob sub hyx2 hyoa sub atan def
            /hyfwd hya2 hya1 sub 360 add def
            hyfwd 360 ge { /hyfwd hyfwd 360 sub def } if
            /hymid hya1 hyfwd 2 div add def
            /hymx hyoa hymid cos hyor mul add def
            /hymy hyob hymid sin hyor mul add def
            /hydcx hycx hyoa hyr mul add def
            /hydcy hycy hyob hyr mul add def
            /hydr hyor hyr mul def
            hymx dup mul hymy dup mul add 1 lt {
                hydcx hydcy hydr hya1 hya2 arc
            } {
                hydcx hydcy hydr hya1 hya2 arcn
            } ifelse
        } ifelse
    } for
    closepath
} def

% cx cy r p q depth {gen proc} httile -
% A regular {p,q} hyperbolic tessellation (p-gons, q meeting at every
% vertex) in the Poincare disk (cx,cy,r device frame), built by
% breadth-first reflection: start from a p-gon centered at the origin,
% sized so q of them meet at each vertex, then reflect it across each of
% its own edges (hreflect, via horthocircle on that edge) to generate its
% neighbors, and so on out to `depth` reflection generations. Requires
% the hyperbolic condition (p-2)(q-2) > 4 -- Euclidean/spherical {p,q}
% (e.g. {4,4}, {3,6}, {6,3}) aren't handled, same as artkit's other
% shape procs don't validate their inputs.
%
% The fundamental polygon's circumradius comes from the standard
% regular-tiling identity cosh(rh) = cot(pi/p)*cot(pi/q) (rh = hyperbolic
% distance from center to vertex; derived by splitting the polygon into
% 2p right triangles with angles pi/p at the center and pi/q at the
% vertex), converted to the Poincare radius via R = tanh(rh/2) =
% sqrt((cosh(rh)-1)/(cosh(rh)+1)) — the second form sidesteps needing an
% acosh. Verified against a direct measurement (not just algebra): for
% several {p,q}, building the fundamental polygon at this R and measuring
% the *Euclidean* tangent angle between adjacent edges at a shared vertex
% (equal to the hyperbolic angle there, since the disk model is
% conformal) reproduces 360/q exactly.
%
% Unlike every other driver in this file, `proc` runs with the current
% path *already built* (a closed geodesic p-gon, via hpoly) and just the
% tile's reflection-generation number (0 for the fundamental polygon, 1
% for its immediate neighbors, etc. — breadth-first order means it's
% also the draw order, so it doubles as a "distance from center" ring
% index) on the stack — its whole job is to paint it (setcolor,
% fill/stroke/both), not construct it; curved edges mean only this
% driver has the geometry hpoly needs. Every
% scratch name here is ht-prefixed, distinct from the ha-/hg-/ho-/hp-/hr-
% /hy- prefixes of the primitives it calls, specifically so a proc that
% decorates a tile by calling hgeo/hpoly/horthocircle/hreflect itself
% can't clobber this driver's own walk state underneath it (the
% tiling-section header above documents the general version of this
% gotcha for tg-/tk-; here it's sidestepped by construction rather than
% left to caller discipline).
%
% Duplicate tiles (every edge but the outermost leads back to an
% already-visited neighbor) are caught by comparing centroids against
% everything visited so far, at a tolerance scaled to that candidate's
% own max edge length — tiles shrink fast toward the rim, so a fixed
% tolerance would either miss rim duplicates or merge distinct ones (and
% scaling by distance from the *origin* instead, tried first, silently
% caps how far the tiling grows with depth: that distance stays near 1
% at the rim even as the tiles themselves keep shrinking there, so it
% under-tolerates and starts rejecting genuinely new neighbors). That
% scan is the one place this scales as O(tile-count^2); fine
% through the depths (3-5) any single piece can actually show, not
% pursued further. Tile count grows roughly geometrically with depth;
% the queue/visited storage is capped at htmax and enqueueing silently
% stops past it (same doctrine as lsys's 60000-character cap) — depth
% 3-4 is already a dense, screen-filling tessellation for any {p,q}.
% htqueue/htvisited (htmax and 2*htmax slots) are allocated fresh on
% every call, not shared/reused across calls — a few calls per piece
% (the norm; see gallery/infinite_descent.ps and examples/hyperbolic.ps)
% is 60k-120k array slots total, cheap; calling httile in a per-frame or
% per-cell loop would not be, and isn't a usage this file optimizes for.
/htmax 20000 def
/httile {
    /htproc exch def
    /htdepth exch def
    /htq exch def
    /htp exch def
    /htr exch def
    /htcy exch def
    /htcx exch def
    /htC
        180 htp div cos 180 htp div sin div
        180 htq div cos 180 htq div sin div
        mul
    def
    /htR htC 1 sub htC 1 add div sqrt def
    /htfund htp 2 mul array def
    0 1 htp 1 sub {
        /hti exch def
        /hta 360 hti mul htp div def
        htfund hti 2 mul htR hta cos mul put
        htfund hti 2 mul 1 add htR hta sin mul put
    } for
    /htqueue htmax array def
    /htvisited htmax 2 mul array def
    /htqhead 0 def
    htqueue 0 [htfund 0] put
    /htqtail 1 def
    % The fundamental polygon's centroid is the origin by construction
    % (it's built centered there) -- NOT htfund's own vertex 0, which is
    % what a naive "read the first two slots of htfund" would give. Get
    % this wrong and the dedup scan below never matches the fundamental
    % tile against its own true position, so the first neighbor to
    % reflect back across a shared edge (unavoidable by depth 2) reads as
    % a brand new tile at the disk's center instead of a duplicate.
    htvisited 0 0 put
    htvisited 1 0 put
    {
        htqhead htqtail ge { exit } if
        htqueue htqhead get aload pop      % verts gen
        /htgen exch def /htverts exch def
        /htqhead htqhead 1 add def
        % newpath first: hpoly only ever *appends* a subpath, so without
        % this a caller who didn't newpath before calling httile (or a
        % proc that leaves ink-free path segments lying around) leaks
        % into the very first tile's path instead of the documented
        % "proc sees exactly one closed p-gon" contract.
        newpath
        htcx htcy htr htverts hpoly
        htgen htproc
        htgen htdepth lt {
            0 1 htp 1 sub {
                /hti exch def
                /htj hti 1 add htp mod def
                /htx1 htverts hti 2 mul get def
                /hty1 htverts hti 2 mul 1 add get def
                /htx2 htverts htj 2 mul get def
                /hty2 htverts htj 2 mul 1 add get def
                htx1 hty1 htx2 hty2 horthocircle
                /htisline exch def /htor exch def /htob exch def /htoa exch def
                /htnb htp 2 mul array def
                0 1 htp 1 sub {
                    /htk exch def
                    /htvx htverts htk 2 mul get def
                    /htvy htverts htk 2 mul 1 add get def
                    htoa htob htor htisline htvx htvy hreflect
                    /htny exch def /htnx exch def
                    htnb htk 2 mul htnx put
                    htnb htk 2 mul 1 add htny put
                } for
                % Scale for the dedup tolerance below: this candidate's
                % own max edge length (NOT its distance from the origin
                % -- reflections are conformal, i.e. local similarities,
                % so edge length shrinks correctly toward the rim the
                % same way the tile's whole Euclidean footprint does;
                % distance-from-origin stays near 1 out there and badly
                % under-tolerances, silently capping tile growth with
                % depth -- caught by comparing against an independent
                % Python prototype of this same BFS, see NOTES.md).
                /htsc 0 def
                0 1 htp 1 sub {
                    /htk exch def
                    /htk2 htk 1 add htp mod def
                    /htedx htnb htk 2 mul get htnb htk2 2 mul get sub def
                    /htedy htnb htk 2 mul 1 add get htnb htk2 2 mul 1 add get sub def
                    /hted htedx dup mul htedy dup mul add sqrt def
                    hted htsc gt { /htsc hted def } if
                } for
                /htccx 0 def /htccy 0 def
                0 1 htp 1 sub {
                    /htk exch def
                    /htccx htccx htnb htk 2 mul get add def
                    /htccy htccy htnb htk 2 mul 1 add get add def
                } for
                /htccx htccx htp div def
                /htccy htccy htp div def
                % 0.2, not the original 0.3: a cross-model review showed
                % 0.3 merges genuinely distinct tiles for {10,10} depth 4
                % (dual-graph girth q=10 means no two of that BFS's walks
                % of length <=4 can reach the same tile combinatorially,
                % so the true count is the plain reflection-tree growth
                % 1+10+90+810+7290=8201 -- 0.3 gave 8191, ten tiles
                % short). 0.2 recovers 8201 here with no runtime cost
                % (still ~31s, same as 0.3) and leaves every other pinned
                % {p,q,depth} in this file unchanged (29, 232, 1711).
                /httol htsc 0.2 mul def
                /htdup false def
                0 1 htqtail 1 sub {
                    /htm exch def
                    htdup not {
                        /htdx htccx htvisited htm 2 mul get sub def
                        /htdy htccy htvisited htm 2 mul 1 add get sub def
                        htdx dup mul htdy dup mul add sqrt httol lt {
                            /htdup true def
                        } if
                    } if
                } for
                htdup not htqtail htmax lt and {
                    htqueue htqtail [htnb htgen 1 add] put
                    htvisited htqtail 2 mul htccx put
                    htvisited htqtail 2 mul 1 add htccy put
                    /htqtail htqtail 1 add def
                } if
            } for
        } if
    } loop
} def

% --- noise / flow fields ----------------------------------------------
% Coherent (Perlin-style) gradient noise for organic texture, curl noise
% for flow fields, and particle advection to draw along one. Build the
% permutation table once per srand with `noiseinit` (consumes rand --
% call it after `N srand`, before any noise2 sampling, same "seed once,
% draw many" contract as everything else in this file); `noise2` then
% samples deterministically off that table.
%
%   noiseinit                              -   (once per srand)
%   x y noise2 -> n                        (~[-0.66,0.66], empirically;
%                                            continuous, exactly 0 at
%                                            every integer lattice point)
%   x y eps {x y -> n} curl2 -> dx dy      (unit flow vector, or 0 0 if
%                                            the field is locally flat)
%   x y n stepsize {x y -> dx dy} advect - (moveto's x y, then walks n
%                                            steps of stepsize*(dx,dy);
%                                            stops early on a 0 0 field)
%
% `curl2`'s direction comes from a genuinely divergence-free
% construction -- the perpendicular gradient of a scalar potential is
% divergence-free exactly, a vector-calculus identity -- but the value
% it *returns* is that vector normalized to unit length, and
% normalizing (dividing by a position-dependent magnitude) does not
% preserve the identity: a cross-model review measured divergence
% around -0.27 at one test point for a field with a strongly varying
% gradient magnitude (`x*y`), confirmed by direct finite-difference
% probing of curl2's own output, not just the underlying math. This is
% the standard tradeoff curl-noise particle systems make -- a raw,
% unnormalized curl vector would be exactly divergence-free but its
% magnitude swings with the field's own steepness (huge near sharp
% features, ~0 in flat regions), which is unusable for `advect`'s
% fixed-stepsize walk. Normalizing trades a small amount of exactness
% for a particle speed that stays uniform regardless of local field
% steepness; treat "particles don't pool or source" as approximately
% true for smoothly-varying fields (`noise2` itself, or `noise2` plus a
% gently-varying bias term, like Lodestone's), not as an exact
% guarantee for an arbitrary field proc.
%
% `noise2` takes no caller proc, so it can never re-enter itself
% mid-computation -- domain warping (perturbing x/y with another
% noise2 call before sampling) is safe with its plain global scratch
% names, no dict-wrap needed, which matters since a flow-field piece
% samples it on the order of 10^5 times. `curl2` and `advect` also use
% plain global scratch (c2*/ad*), not a private dict, for the same
% reason gasket/carpet do (see gasket's header): a field proc is
% ordinary caller code, and it's entitled to hold its own mutable state
% across calls the same way every other artkit callback can (a plain
% `/seen seen 1 add def` counter, say) -- wrapping curl2/advect's own
% scratch in a dict on every call would silently swallow exactly that
% kind of caller state the instant it runs while the wrapper dict is
% current, breaking ordinary (non-nesting) field procs to protect
% against the rarer nesting case. The cost is the flip side of gasket's
% own tradeoff: a field proc that itself calls curl2/advect again
% (composing two flow fields, or a particle spawning a child trail)
% clobbers the *outer* call's own in-flight c2*/ad* scratch the instant
% the inner call starts, since both bind the same global names -- same
% shape, same fix, as every other proc-driven section in this file:
% wrap just the inner call in its own `N dict begin ... end` so its
% `def`s shadow there instead of landing on the outer's own bindings.
%
% `curl2`'s `eps` is in whatever units the field proc's x/y expect --
% typically raw caller-space if the proc does its own frequency scaling
% internally, e.g.:
%   /flow { 0.02 mul exch 0.02 mul exch noise2 } def
%   x y 0.5 /flow load curl2 -> dx dy
% Too small an eps against that scale cancels to noise-floor garbage
% (two nearly-identical noise2 samples subtracted); too large blurs
% past the field's own texture. 0.5 above is a good starting point for
% a 0.02 frequency (a ~50-unit feature size) -- scale eps down if you
% scale frequency up.

/Grad2 [
    1 0    -1 0    0 1    0 -1
    0.70710678 0.70710678    -0.70710678 0.70710678
    0.70710678 -0.70710678   -0.70710678 -0.70710678
] def

% Fisher-Yates shuffle of 0..255 via `chance`, so the field is
% `srand`-deterministic like everything else here. `and 255` (not
% `mod`) does the lattice wraparound throughout this section -- `mod`
% truncates toward zero and returns negative remainders for negative
% dividends (would index Perm out of range for x<0 or y<0); `and 255`
% on this interpreter's two's-complement ints gives the correct
% floor-mod-256 result for negative operands too (confirmed directly:
% `-1 255 and` is 255, matching floor(-1) mod 256).
/noiseinit {
    /Perm 256 array def
    0 1 255 { /nii exch def Perm nii nii put } for
    255 -1 1 {
        /nii exch def
        /nij nii 1 add chance def
        /nitmp Perm nii get def
        Perm nii Perm nij get put
        Perm nij nitmp put
    } for
} def

/gethash {                                       % xi yi -> h  (0..255)
    /ghy exch def /ghx exch def
    Perm ghx get ghy add 255 and
    Perm exch get
} def

/grad2 {                                         % h x y -> dot
    /g2y exch def /g2x exch def /g2h exch def
    /g2i g2h 7 and 2 mul def
    Grad2 g2i get g2x mul
    Grad2 g2i 1 add get g2y mul add
} def

/nfade {                                         % t -> f(t)  (quintic
    /nft exch def                                % smoothstep, fade(0)=0,
    /nft2 nft nft mul def                        % fade(1)=1 -- fade(0)=0
    /nft3 nft2 nft mul def                       % is what makes noise2
    nft3 10 mul                                  % exactly 0 at integer
    nft3 nft mul 15 mul sub                      % lattice points, since
    nft3 nft2 mul 6 mul add                      % it zeroes both lerps
} def

/nlerp { /nlt exch def /nlb exch def /nla exch def   % a b t -> a+(b-a)*t
    nlb nla sub nlt mul nla add
} def

/noise2 {                                        % x y -> n
    /n2y exch def /n2x exch def
    /n2x0 n2x floor cvi def
    /n2y0 n2y floor cvi def
    /n2xf n2x n2x0 sub def
    /n2yf n2y n2y0 sub def
    /n2xi n2x0 255 and def
    /n2yi n2y0 255 and def
    /n2xi1 n2xi 1 add 255 and def
    /n2yi1 n2yi 1 add 255 and def
    /n2u n2xf nfade def
    /n2v n2yf nfade def
    /n2n00 n2xi n2yi gethash n2xf n2yf grad2 def
    /n2n10 n2xi1 n2yi gethash n2xf 1 sub n2yf grad2 def
    /n2n01 n2xi n2yi1 gethash n2xf n2yf 1 sub grad2 def
    /n2n11 n2xi1 n2yi1 gethash n2xf 1 sub n2yf 1 sub grad2 def
    n2n00 n2n10 n2u nlerp
    n2n01 n2n11 n2u nlerp
    n2v nlerp
} def

% x y eps {x y -> n} curl2 -> dx dy
% Curl noise: the field's perpendicular gradient (dPsi/dy, -dPsi/dx),
% central-differenced at +-eps and normalized to a unit vector (see the
% section header for why normalizing costs curl2 exact divergence-
% freedom). 0 0 if the sampled gradient is (numerically) exactly flat,
% so `advect` can treat that as a stopping condition without a special
% case of its own. Plain global scratch (c2*), not dict-scoped -- see
% the section header for why, and for the nested-call wrap this trades
% for.
/curl2 {
    /c2p exch def /c2e exch def /c2y exch def /c2x exch def
    c2x c2y c2e add c2p exec
    c2x c2y c2e sub c2p exec
    sub /c2dy exch def
    c2x c2e add c2y c2p exec
    c2x c2e sub c2y c2p exec
    sub /c2dx exch def
    /c2vx c2dy def
    /c2vy c2dx neg def
    /c2len c2vx dup mul c2vy dup mul add sqrt def
    c2len 0 gt {
        c2vx c2len div c2vy c2len div
    } { 0 0 } ifelse
} def

% x y n stepsize {x y -> dx dy} advect -
% Traces one particle: moveto's the start, then n times calls the field
% proc and lineto's stepsize*(dx,dy) further along -- stops early (fewer
% than n linetos) if the field returns exactly 0 0. advect does not
% normalize the field's return value itself; it trusts whatever
% magnitude the proc hands back (curl2's is always a unit vector, but a
% hand-written field need not be -- advect just scales by stepsize and
% steps). Plain global scratch (ad*), not dict-scoped -- see the
% section header for why, and for the nested-call wrap this trades for.
/advect {
    /adf exch def /adstep exch def /adn exch def
    /ady exch def /adx exch def
    adx ady moveto
    adn {
        adx ady adf exec
        /adfy exch def /adfx exch def
        adfx 0 eq adfy 0 eq and { exit } if
        /adx adx adfx adstep mul add def
        /ady ady adfy adstep mul add def
        adx ady lineto
    } repeat
} def

% --- gradients (axial and radial shading fills) ------------------------
% A thin convenience layer over the interpreter's `shfill` operator (issue
% #20): builds PLRM shading dictionaries from a plain array of [r g b]
% colors -- the same representation `mix3`/`shade`/`Palettes` already
% use -- instead of requiring callers to hand-write FunctionType 2/3
% function dicts themselves.
%
%   [[r g b] ...] gradfn -> functiondict
%   x0 y0 x1 y1 [[r g b] ...] axialsh -> shadingdict
%   x0 y0 r0 x1 y1 r1 [[r g b] ...] radialsh -> shadingdict
%   shadingdict gradfill -   (gsave, clip to the current path, shfill, grestore)
%
% Build the region to paint with ordinary path construction first, same
% as any other fill -- gradfill just clips to whatever path is current:
%   0 0 moveto 400 0 lineto 400 400 lineto 0 400 lineto closepath
%   50 50 0 350 350 40 [[1 0 0] [0 0 1]] radialsh gradfill
%
% `gradfn` always builds a FunctionType 3 (stitching) function, even
% for a two-color ramp -- one code path for both the simple two-stop
% case and a multi-stop gradient, with legs evenly spaced across [0 1].

/gradfn {                                        % [[r g b]...] -> fndict
    /gdc exch def
    /gdn gdc length 1 sub def
    gdn 1 lt { /gdn 1 def } if
    /gdfuncs gdn array def
    /gdbounds gdn 1 sub array def
    /gdenc gdn 2 mul array def
    0 1 gdn 1 sub {
        /gdi exch def
        /gdlo gdi gdc length 1 sub min def
        /gdhi gdi 1 add gdc length 1 sub min def
        gdfuncs gdi
        << /FunctionType 2 /Domain [0 1]
           /C0 gdc gdlo get /C1 gdc gdhi get /N 1 >>
        put
        gdi 0 gt { gdbounds gdi 1 sub gdi gdn div put } if
        gdenc gdi 2 mul 0 put
        gdenc gdi 2 mul 1 add 1 put
    } for
    << /FunctionType 3 /Domain [0 1]
       /Functions gdfuncs /Bounds gdbounds /Encode gdenc >>
} def

/axialsh {                                % x0 y0 x1 y1 colors -> shdict
    /gdcolors exch def
    /gdy1 exch def /gdx1 exch def /gdy0 exch def /gdx0 exch def
    << /ShadingType 2 /ColorSpace /DeviceRGB
       /Coords [gdx0 gdy0 gdx1 gdy1]
       /Function gdcolors gradfn >>
} def

/radialsh {                        % x0 y0 r0 x1 y1 r1 colors -> shdict
    /gdcolors exch def
    /gdr1 exch def /gdy1 exch def /gdx1 exch def
    /gdr0 exch def /gdy0 exch def /gdx0 exch def
    << /ShadingType 3 /ColorSpace /DeviceRGB
       /Coords [gdx0 gdy0 gdr0 gdx1 gdy1 gdr1]
       /Function gdcolors gradfn >>
} def

/gradfill { gsave clip shfill grestore } def          % shadingdict gradfill -
%%EOF
